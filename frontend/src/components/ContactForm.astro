---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Réserver mon Bilan Gratuit", 
  subtitle = "Remplissez ce formulaire, nous vous confirmons votre créneau en moins de 2 heures." 
} = Astro.props;
---

<div class="form-card">
  <h3>{title}</h3>
  <p class="form-sub">{subtitle}</p>

  <form id="astroBookingForm">
    <div class="form-row">
      <div class="field">
        <label for="bf-name">Nom &amp; Prénom *</label>
        <input type="text" id="bf-name" placeholder="Votre nom complet" required />
      </div>
      <div class="field">
        <label for="bf-phone">Téléphone (WhatsApp) *</label>
        <input type="tel" id="bf-phone" placeholder="06 12 34 56 78" required />
      </div>
    </div>

    <div class="field">
      <label for="bf-service">Pôle de soin principal *</label>
      <select id="bf-service" required>
        <option value="" disabled selected>Sélectionnez un univers</option>
        <option value="Bilan InBody Global Offert">Bilan InBody Global Offert</option>
        <option value="Sport Nouvelle Génération">Sport Nouvelle Génération (InfraBike/Tapis)</option>
        <option value="Soins Amincissants">Soins Amincissants (VelaShape/Drainage)</option>
        <option value="Soins du Visage">Soins du Visage (Hydrafacial/Kobido)</option>
        <option value="Épilation Laser Diode">Épilation Laser Diode</option>
        <option value="Hammam Traditionnel">Hammam Traditionnel</option>
      </select>
    </div>

    <div class="field">
      <label for="bf-message">Vos objectifs ou disponibilités</label>
      <textarea id="bf-message" rows="3" placeholder="Ex: Disponible le matin, objectif affinement taille..."></textarea>
    </div>

    <button type="submit" class="submit-btn">Envoyer ma demande de rendez-vous</button>
    <div id="bookingFeedback" class="feedback-msg">
      Merci ! Votre demande a été enregistrée avec succès. Redirection vers WhatsApp en cours...
    </div>
  </form>
</div>

<style>
  .form-card {
    background: #FFFFFF;
    border-radius: 12px;
    border-top: 3px solid #BB2026;
    padding: 2.5rem;
    box-shadow: 0 12px 40px rgba(61, 31, 63, 0.08);
    border: 1px solid rgba(175, 132, 172, 0.2);
  }
  .form-card h3 {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: #2D2D2D;
    margin-bottom: 0.4rem;
  }
  .form-sub {
    font-size: 0.88rem;
    color: #6B636B;
    margin-bottom: 1.8rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
    margin-bottom: 1.15rem;
  }
  .field {
    margin-bottom: 1.15rem;
  }
  .field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #444444;
    margin-bottom: 0.4rem;
  }
  .field input, .field select, .field textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid #DFD5DF;
    border-radius: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    color: #2D2D2D;
    background: #FFFFFF;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: #BB2026;
    box-shadow: 0 0 0 3px rgba(187, 32, 38, 0.08);
  }
  .submit-btn {
    width: 100%;
    background: #BB2026;
    color: #FFFFFF;
    padding: 0.95rem;
    border: none;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s, transform 0.2s;
    margin-top: 0.5rem;
  }
  .submit-btn:hover {
    background: #8f1a1f;
    transform: translateY(-1px);
  }
  .feedback-msg {
    display: none;
    margin-top: 1.2rem;
    padding: 0.9rem 1.2rem;
    border-radius: 6px;
    background: #EAF8EF;
    border: 1px solid #25D366;
    color: #165B33;
    font-size: 0.88rem;
    text-align: center;
  }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .form-card { padding: 1.8rem; }
  }
</style>

<script>
  const form = document.getElementById('astroBookingForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('bf-name') as HTMLInputElement).value;
    const phone = (document.getElementById('bf-phone') as HTMLInputElement).value;
    const service = (document.getElementById('bf-service') as HTMLSelectElement).value;
    const msg = (document.getElementById('bf-message') as HTMLTextAreaElement).value;

    const fb = document.getElementById('bookingFeedback');
    if (fb) fb.style.display = 'block';

    const waText = `Bonjour INFRASLIM,%0A%0AJe souhaite réserver un rendez-vous / bilan : *${encodeURIComponent(service)}*%0A- Nom : ${encodeURIComponent(name)}%0A- Tél : ${encodeURIComponent(phone)}${msg ? `%0A- Message : ${encodeURIComponent(msg)}` : ''}`;

    setTimeout(() => {
      window.open(`https://wa.me/212615109898?text=${waText}`, '_blank');
    }, 700);
  });
</script>
