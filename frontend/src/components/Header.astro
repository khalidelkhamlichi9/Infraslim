---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
---

<header class="header" id="header">
  <nav class="nav">
    <a href="/" class="nav-logo" aria-label="INFRASLIM Accueil">
      <img src="/logo-infraslim.jpg" alt="INFRASLIM – Centre Santé & Beauté 100% Femmes" />
    </a>

    <ul class="nav-links">
      <li>
        <a href="/le-centre" class={currentPath === "/le-centre" ? "active" : ""}>Le Centre</a>
      </li>

      <!-- SERVICES + MEGA MENU -->
      <li class="nav-item-mega">
        <a href="/services" class={currentPath.startsWith("/services") ? "active" : ""}>
          Services
          <svg class="nav-chevron" viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>

        <div class="mega-menu" aria-label="Méga menu des services INFRASLIM">
          <div class="mega-menu-inner">
            <div class="mega-grid">
              <!-- 1. Sport -->
              <div class="mega-col">
                <a href="/services/sport-nouvelle-generation" class="mega-card-head">
                  <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=400&q=80" alt="Sport Infrarouge" />
                  <div>
                    <span class="mc-num">01 · Effort</span>
                    <strong>Sport Nouvelle Génération</strong>
                  </div>
                </a>
                <ul class="mega-sublist">
                  <li><a href="/services/sport-nouvelle-generation/infrabike">InfraBike</a></li>
                  <li><a href="/services/sport-nouvelle-generation/tapis-roulant-infrarouge">Tapis Roulant Infrarouge</a></li>
                  <li><a href="/services/sport-nouvelle-generation/infra-roller">Infra Roller</a></li>
                  <li><a href="/services/sport-nouvelle-generation">Renforcement Musculaire</a></li>
                </ul>
              </div>

              <!-- 2. Amincissants -->
              <div class="mega-col">
                <a href="/services/soins-amincissants" class="mega-card-head">
                  <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=400&q=80" alt="Soins Amincissants" />
                  <div>
                    <span class="mc-num">02 · Minceur</span>
                    <strong>Soins Amincissants</strong>
                  </div>
                </a>
                <ul class="mega-sublist">
                  <li><a href="/services/soins-amincissants/velashape">VelaShape</a></li>
                  <li><a href="/services/soins-amincissants/maderotherapie">Madérothérapie</a></li>
                  <li><a href="/services/soins-amincissants/drainage-lymphatique">Drainage Lymphatique</a></li>
                  <li><a href="/services/soins-amincissants/pressotherapie">Pressothérapie &amp; Sauna Dôme</a></li>
                </ul>
              </div>

              <!-- 3. Visage -->
              <div class="mega-col">
                <a href="/services/soins-visage" class="mega-card-head">
                  <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=400&q=80" alt="Soins du Visage" />
                  <div>
                    <span class="mc-num">03 · Éclat</span>
                    <strong>Soins du Visage</strong>
                  </div>
                </a>
                <ul class="mega-sublist">
                  <li><a href="/services/soins-visage/hydrafacial">Hydrafacial</a></li>
                  <li><a href="/services/soins-visage/carbon-peel">Carbon Peel</a></li>
                  <li><a href="/services/soins-visage/kobido">Massage Kobido</a></li>
                  <li><a href="/services/soins-visage/microneedling">Microneedling &amp; Ciblés</a></li>
                </ul>
              </div>

              <!-- 4. Laser -->
              <div class="mega-col">
                <a href="/services/epilation-laser" class="mega-card-head">
                  <img src="https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=400&q=80" alt="Épilation et Laser" />
                  <div>
                    <span class="mc-num">04 · Laser</span>
                    <strong>Épilation &amp; Laser</strong>
                  </div>
                </a>
                <ul class="mega-sublist">
                  <li><a href="/services/epilation-laser/epilation-laser-diode">Épilation Laser Diode</a></li>
                  <li><a href="/services/epilation-laser/detatouage-laser">Détatouage au Laser</a></li>
                  <li><a href="/services/epilation-laser">Épilation à la Cire</a></li>
                </ul>
              </div>

              <!-- 5. Hammam -->
              <div class="mega-col">
                <a href="/services/hammam" class="mega-card-head">
                  <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=400&q=80" alt="Hammam Traditionnel" />
                  <div>
                    <span class="mc-num">05 · Rituels</span>
                    <strong>Hammam Traditionnel</strong>
                  </div>
                </a>
                <ul class="mega-sublist">
                  <li><a href="/services/hammam">Hammam Infraslim (150 DH)</a></li>
                  <li><a href="/services/hammam">Hammam Royal (250 DH)</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li>
        <a href="/tarifs" class={currentPath === "/tarifs" ? "active" : ""}>Tarifs</a>
      </li>
      <li>
        <a href="/blog" class={currentPath.startsWith("/blog") ? "active" : ""}>Blog</a>
      </li>
      <li>
        <a href="/contact" class={currentPath === "/contact" ? "active" : ""}>Contact</a>
      </li>
    </ul>

    <!-- Menu Hamburger Mobile -->
    <button class="hamburger" id="hamburger" aria-label="Menu Mobile">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Menu Mobile Déroulant -->
  <div class="mobile-menu" id="mobile-menu">
    <a href="/le-centre" class="mob-link">Le Centre</a>
    <a href="/services" class="mob-link">Tous nos Services</a>
    <div class="mobile-sublinks">
      <a href="/services/sport-nouvelle-generation" class="mob-sub">· Sport Infrarouge</a>
      <a href="/services/soins-amincissants" class="mob-sub">· Soins Amincissants</a>
      <a href="/services/soins-visage" class="mob-sub">· Soins du Visage</a>
      <a href="/services/epilation-laser" class="mob-sub">· Épilation &amp; Laser</a>
      <a href="/hammam" class="mob-sub">· Hammam Traditionnel</a>
    </div>
    <a href="/tarifs" class="mob-link">Tarifs</a>
    <a href="/blog" class="mob-link">Blog</a>
    <a href="/contact" class="mob-link">Contact</a>
    <a href="https://wa.me/212615109898?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous." target="_blank" rel="noopener" class="mobile-cta mob-link">WhatsApp</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: #FFFFFF;
    box-shadow: 0 2px 18px rgba(0,0,0,0.06);
    border-bottom: 2px solid #331535;
    padding: 0 2.5rem;
    height: 78px;
    display: flex;
    align-items: center;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .header.scrolled {
    box-shadow: 0 4px 25px rgba(0,0,0,0.1);
  }
  .nav {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    height: 64px;
    width: 220px;
    text-decoration: none;
  }
  .nav-logo img {
    height: 58px;
    width: auto;
    display: block;
    transition: transform 0.25s ease;
    mix-blend-mode: multiply;
    background: transparent;
  }
  .nav-logo:hover img {
    transform: scale(1.02);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links > li > a {
    color: #2D2D2D;
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 1.5rem 0.2rem;
    transition: color 0.2s ease;
  }
  .nav-links > li > a:hover, .nav-links > li > a.active {
    color: #BB2026;
  }
  .nav-chevron {
    width: 10px;
    height: 10px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
    transition: transform 0.3s ease;
  }
  .nav-item-mega:hover .nav-chevron {
    transform: rotate(180deg);
  }

  /* =====================================================
     MEGA MENU LUXE SERVICES
  ===================================================== */
  .nav-item-mega {
    position: static;
  }
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 2px solid #331535;
    border-bottom: 3px solid #BB2026;
    box-shadow: 0 25px 60px rgba(51, 21, 53, 0.16);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.28s;
    z-index: 998;
    padding: 2rem 2.5rem;
  }
  .mega-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .nav-item-mega:hover .mega-menu,
  .nav-item-mega:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .mega-menu-inner {
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .mega-col {
    min-width: 0;
    box-sizing: border-box;
    background: #FAF7FA;
    border: 1px solid rgba(175, 132, 172, 0.18);
    border-radius: 12px;
    padding: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .mega-col:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(51, 21, 53, 0.1);
    border-color: rgba(187, 32, 38, 0.4);
    background: #FFFFFF;
  }
  .mega-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 0.9rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(175, 132, 172, 0.18);
  }
  .mega-card-head img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    transition: transform 0.35s ease;
  }
  .mega-col:hover .mega-card-head img {
    transform: scale(1.08);
  }
  .mc-num {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #BB2026;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }
  .mega-card-head strong {
    display: block;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #2D2D2D;
    line-height: 1.25;
  }
  .mega-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }
  .mega-sublist a {
    font-size: 0.8rem;
    color: #555555;
    text-decoration: none;
    display: block;
    padding: 0.2rem 0;
    transition: color 0.2s, transform 0.2s;
  }
  .mega-sublist a:hover {
    color: #BB2026;
    transform: translateX(4px);
  }

  /* mega-footer styles removed per user request */

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .hamburger span {
    width: 24px;
    height: 2px;
    background: #2D2D2D;
    transition: transform 0.3s, opacity 0.3s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 78px; left: 0; right: 0; bottom: 0;
    background: #FFFFFF;
    z-index: 999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    overflow-y: auto;
    padding: 2rem 1rem;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a.mob-link {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #2D2D2D;
    text-decoration: none;
  }
  .mobile-sublinks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    margin: 0.2rem 0 0.5rem;
  }
  .mobile-sublinks a.mob-sub {
    font-family: 'Poppins', sans-serif;
    font-size: 0.92rem;
    color: #6B636B;
    text-decoration: none;
  }
  .mobile-menu a:hover { color: #BB2026; }
  .mobile-menu .mobile-cta {
    margin-top: 0.75rem;
    background: #BB2026;
    color: white !important;
    padding: 0.8rem 2.2rem;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (max-width: 1024px) {
    .mega-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .nav-links, .mega-menu { display: none !important; }
    .hamburger { display: flex; }
    .header { padding: 0 1.5rem; height: 68px; }
    .nav-logo img { height: 48px; }
    .mobile-menu { top: 68px; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
  });
</script>
