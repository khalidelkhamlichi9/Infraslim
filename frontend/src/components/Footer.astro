---
import { FALLBACK_SETTINGS } from '../lib/strapi';

interface Props {
  settings?: typeof FALLBACK_SETTINGS;
}

const { settings = FALLBACK_SETTINGS } = Astro.props;
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo-card" aria-label="INFRASLIM Accueil">
          <img src="/logo-infraslim.jpg" alt="INFRASLIM – Centre Santé & Beauté 100% Femmes" class="footer-logo-img" />
        </a>
        <div class="ft">{settings.tagline}</div>
        <p class="fc">
          {settings.address}<br />
          {settings.hours}<br />
          Tél : {settings.phone}
        </p>
      </div>

      <div class="footer-col">
        <h4>Nos Services</h4>
        <a href="/services/sport-nouvelle-generation">Sport Infrarouge</a>
        <a href="/services/soins-amincissants">Soins Amincissants</a>
        <a href="/services/soins-visage">Soins du Visage</a>
        <a href="/services/epilation-laser">Épilation &amp; Laser</a>
        <a href="/hammam">Hammam Traditionnel</a>
      </div>

      <div class="footer-col">
        <h4>Le Centre</h4>
        <a href="/le-centre">Présentation</a>
        <a href="/tarifs">Tarifs &amp; Packs</a>
        <a href="/blog">Conseils &amp; Blog</a>
        <a href="/faq">Questions Fréquentes</a>
        <a href="/contact">Accès &amp; Contact</a>
      </div>

      <div class="footer-col">
        <h4>Contact Direct</h4>
        <a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a>
        <a href={settings.whatsapp} target="_blank" rel="noopener">WhatsApp Direct</a>
        <a href={settings.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={settings.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} INFRASLIM. Tous droits réservés.</span>
      <div class="footer-legal-links">
        <a href="/mentions-legales">Mentions Légales</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/politique-de-confidentialite">Politique de Confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #F7F3F7;
    padding: 4.5rem 2rem 2rem;
    border-top: 3px solid #BB2026;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(175, 132, 172, 0.25);
  }
  .footer-brand .fl {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    color: #BB2026;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }
  .footer-logo-card {
    background: #FFFFFF;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 68px;
    width: 220px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    border: 1px solid rgba(175, 132, 172, 0.2);
    text-decoration: none;
  }
  .footer-logo-img {
    height: 230px;
    width: 230px;
    max-width: none;
    max-height: none;
    display: block;
    object-fit: cover;
    object-position: center center;
    transform: translateY(2px);
    transition: transform 0.25s ease;
  }
  .footer-logo-card:hover .footer-logo-img {
    transform: translateY(2px) scale(1.04);
  }
  .footer-brand .ft {
    font-size: 0.85rem;
    color: #6B636B;
    margin-bottom: 1rem;
  }
  .footer-brand .fc {
    font-size: 0.82rem;
    color: #555555;
    line-height: 1.7;
  }
  .footer-col h4 {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #BB2026;
    margin-bottom: 1.25rem;
    font-weight: 600;
  }
  .footer-col a {
    display: block;
    color: #333333;
    font-size: 0.85rem;
    margin-bottom: 0.65rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: #BB2026;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: #6B636B;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .footer-legal-links a {
    color: #6B636B;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal-links a:hover {
    color: #BB2026;
  }
  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
