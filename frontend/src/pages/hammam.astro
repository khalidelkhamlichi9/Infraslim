---
import Layout from '../layouts/Layout.astro';
import { getGlobalSettings } from '../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Hammam traditionnel à Rabat, 100 % femmes | INFRASLIM" description="Savon noir, gommage au kessa et rinçage, à Agdal. Hammam Infraslim 150 DH, Hammam Royal 250 DH. Centre entièrement féminin." currentPath="/hammam">

  <!-- ============================================================
       HERO HAMMAM (PREMIUM AVEC TEXTURE & DÉGRADÉ MAUVE IMPÉRIAL)
  ============================================================ -->
  <section class="hammam-hero">
    <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=1920&q=85" alt="Hammam Traditionnel Marocain INFRASLIM" class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="hero-bg-overlay"></div>
    <div class="hammam-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; Hammam
      </div>
      <div class="hero-eyebrow">— RITUEL ANCESTRAL MAROCAIN · 100% FÉMININ</div>
      <h1 class="hero-title">Le <em>Hammam</em> Traditionnel</h1>
      <p class="hero-desc">Un voyage sensoriel au cœur de la tradition marocaine. Vapeur bienfaisante, gommage ritualisé au gant kessa, enveloppement au ghassoul du Moyen Atlas — laissez-vous purifier dans un écrin d'intimité absolue à Agdal.</p>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE STRIP
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Vapeur Traditionnelle</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Gommage Kessa</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Savon Beldi à l'Eucalyptus</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Masque Purifiant Ghassoul</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Rituel Complet Impérial</span><span class="sep"></span></div>
      <div class="marquee-item"><span>100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Vapeur Traditionnelle</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Gommage Kessa</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Savon Beldi à l'Eucalyptus</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Masque Purifiant Ghassoul</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Rituel Complet Impérial</span><span class="sep"></span></div>
      <div class="marquee-item"><span>100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       SECTION INTRO AVEC PHOTO LUXE DU HAMMAM
  ============================================================ -->
  <section class="section">
    <div class="container">
      <div class="intro-layout reveal">
        <div class="intro-text">
          <span class="section-label">— NOTRE ÉCRIN DE BIEN-ÊTRE</span>
          <h2 class="section-title">Une parenthèse hors du temps</h2>
          <p class="section-text">Notre Hammam traditionnel marocain vous invite à un moment suspendu, loin du tumulte quotidien. La chaleur douce et enveloppante de la vapeur ouvre les pores, prépare la peau et détend les muscles en profondeur. Le gommage minutieux au savon beldi, le masque purifiant au ghassoul... chaque étape du rituel a été pensée pour vous offrir une purification totale et une détente absolue de l'esprit.</p>
          <p class="section-text" style="margin-top:1.25rem;">Un espace intime, exclusivement féminin, où votre confort et votre pudeur sont strictement préservés par notre personnel bienveillant.</p>

          <div class="intro-perks">
            <div class="ip-item">
              <span class="ip-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>Espace entièrement privatisé sur réservation</span>
            </div>
            <div class="ip-item">
              <span class="ip-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>Produits naturels du terroir marocain</span>
            </div>
            <div class="ip-item">
              <span class="ip-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>Kessa douce & serviettes chaudes fournies</span>
            </div>
          </div>
        </div>

        <div class="intro-photo-card">
          <div class="ipc-frame">
            <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1200&q=85" alt="Hammam Traditionnel INFRASLIM Rabat" />
            <div class="ipc-overlay"></div>
            <div class="ipc-badge">
              <span class="ipc-badge-icon"><svg class="h-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10c0-4-3-7-8-10-5 3-8 6-8 10 0 6 8 10 8 10z"/></svg></span>
              <div>
                <strong>Atmosphère Tamisée</strong>
                <small>Vapeur & Douceur</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       LE RITUEL ÉTAPE PAR ÉTAPE (6 ÉTAPES)
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="text-center reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="section-label">— LE DÉROULEMENT DU SOIN</span>
        <h2 class="section-title">Le Rituel, étape par étape</h2>
        <p class="section-text" style="margin:0 auto;">Chaque instant du hammam est une invitation au lâcher-prise. Voici le cheminement de votre expérience.</p>
      </div>

      <div class="ritual-grid reveal">
        <div class="ritual-step">
          <div class="rs-num">01</div>
          <div class="rs-content">
            <div class="rs-title">Accueil &amp; préparation</div>
            <p class="rs-text">Vous êtes accueillie avec bienveillance par notre équipe féminine et guidée vers l'espace hammam chauffé à température douce pour commencer la détente.</p>
          </div>
        </div>
        <div class="ritual-step">
          <div class="rs-num">02</div>
          <div class="rs-content">
            <div class="rs-title">Vapeur bienfaisante</div>
            <p class="rs-text">La chaleur humide ouvre progressivement les pores, active la microcirculation cutanée, dénoue les tensions musculaires et prépare l'épiderme.</p>
          </div>
        </div>
        <div class="ritual-step">
          <div class="rs-num">03</div>
          <div class="rs-content">
            <div class="rs-title">Gommage kessa</div>
            <p class="rs-text">Le gommage traditionnel au gant kessa exfolie en douceur toutes les cellules mortes, révélant un grain de peau infiniment soyeux et lumineux.</p>
          </div>
        </div>
        <div class="ritual-step">
          <div class="rs-num">04</div>
          <div class="rs-content">
            <div class="rs-title">Savon beldi à l'eucalyptus</div>
            <p class="rs-text">Application généreuse du savon noir traditionnel enrichi à l'huile d'olive et à l'eucalyptus pour assouplir la peau et la nourrir en profondeur.</p>
          </div>
        </div>
        <div class="ritual-step">
          <div class="rs-num">05</div>
          <div class="rs-content">
            <div class="rs-title">Masque purifiant au ghassoul</div>
            <p class="rs-text">Application de l'argile volcanique marocaine du Moyen Atlas, reconnue pour ses vertus purifiantes exceptionnelles qui absorbent impuretés et toxines.</p>
          </div>
        </div>
        <div class="ritual-step">
          <div class="rs-num">06</div>
          <div class="rs-content">
            <div class="rs-title">Enveloppement &amp; éclat final</div>
            <p class="rs-text">Le rituel s'achève par un rinçage doux et un voile hydratant pour sceller la douceur et prolonger la sensation de légèreté absolue.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       GALERIE ATMOSPHÈRE HAMMAM (3 PHOTOS MOSAÏQUE)
  ============================================================ -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal" style="text-align:center;margin-bottom:2.5rem;">
        <span class="section-label">— IMMERSION SENSORIELLE</span>
        <h2 class="section-title">L'Art de Vivre Oriental</h2>
      </div>
      <div class="hammam-gallery-mosaic reveal">
        <div class="hg-card">
          <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=800&q=85" alt="Vapeur & Marbre Tiède Hammam" />
          <div class="hg-caption">Vapeur apaisante &amp; marbre tiède</div>
        </div>
        <div class="hg-card">
          <img src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=800&q=85" alt="Savon Noir Beldi & Huiles Précieuses" />
          <div class="hg-caption">Savon noir beldi &amp; huiles précieuses</div>
        </div>
        <div class="hg-card">
          <img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&w=800&q=85" alt="Relaxation & Sérénité Absolue" />
          <div class="hg-caption">Relaxation &amp; sérénité absolue</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       GRILLE DES 2 FORMULES TARIFS AVEC PHOTOS DE COUVERTURE
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="text-center reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="section-label">— TARIFS &amp; FORMULES</span>
        <h2 class="section-title">Nos deux formules Hammam</h2>
        <p class="section-text" style="margin:0 auto;">Savon noir, gommage au kessa et rinçage, dans un espace réservé aux femmes à Agdal. À s'offrir seule ou après une séance de sport.</p>
      </div>

      <div class="pricing-plans reveal" style="grid-template-columns: repeat(2, 1fr); max-width: 820px; margin: 0 auto;">
        <!-- Formule 1 -->
        <div class="plan">
          <div class="plan-img-wrap">
            <img src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=600&q=80" alt="Hammam Infraslim" />
          </div>
          <div class="plan-body">
            <div class="plan-name">Hammam Infraslim</div>
            <div class="plan-price">150</div>
            <div class="plan-unit">DH par séance</div>
            <div class="plan-features">
              <div class="plan-feature">Le rituel essentiel 100 % femmes</div>
              <div class="plan-feature">Application de savon noir traditionnel</div>
              <div class="plan-feature">Gommage complet au gant kessa</div>
              <div class="plan-feature">Rinçage &amp; détente en salle chaude</div>
            </div>
            <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20le%20Hammam%20Infraslim%20(150%20DH).`} target="_blank" rel="noopener" class="plan-btn">Réserver par WhatsApp</a>
          </div>
        </div>

        <!-- Formule 2 -->
        <div class="plan featured">
          <div class="plan-badge">Version Complète</div>
          <div class="plan-img-wrap">
            <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80" alt="Hammam Royal" />
          </div>
          <div class="plan-body">
            <div class="plan-name">Hammam Royal</div>
            <div class="plan-price">250</div>
            <div class="plan-unit">DH par séance</div>
            <div class="plan-features">
              <div class="plan-feature">La version complète &amp; enveloppante</div>
              <div class="plan-feature">Vapeur chaude, savon noir &amp; gommage kessa</div>
              <div class="plan-feature">Moment plus long &amp; soin complet</div>
              <div class="plan-feature">Tout est fourni sur place</div>
            </div>
            <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20le%20Hammam%20Royal%20(250%20DH).`} target="_blank" rel="noopener" class="plan-btn">Réserver par WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INFORMATIONS PRATIQUES (4 CARTES)
  ============================================================ -->
  <section class="section">
    <div class="container">
      <span class="section-label reveal">— INFORMATIONS PRATIQUES</span>
      <h2 class="section-title reveal">Votre visite en toute sérénité</h2>
      <div class="practical-grid reveal">
        <div class="prac-item">
          <div class="prac-title">Sur rendez-vous uniquement</div>
          <p class="prac-text">Le hammam fonctionne exclusivement sur réservation afin de vous garantir un espace préservé et intime. Contactez-nous par WhatsApp ou téléphone au 06 15 10 98 98.</p>
        </div>
        <div class="prac-item">
          <div class="prac-title">Que préparer ?</div>
          <p class="prac-text">Des mules sont conseillées pour circuler dans les espaces humides. Tous les produits de soin (savon beldi, kessa, ghassoul) sont fournis par le centre.</p>
        </div>
        <div class="prac-item">
          <div class="prac-title">Espace 100% féminin</div>
          <p class="prac-text">Notre hammam est strictement réservé aux femmes. Seule une équipe féminine professionnelle est présente pour votre sérénité et votre confort.</p>
        </div>
        <div class="prac-item">
          <div class="prac-title">Horaires &amp; Créneaux</div>
          <p class="prac-text">Du lundi au samedi, de 08h00 à 20h00. Comptez entre 45 minutes et 2 heures selon la formule choisie.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CTA CONVERSION
  ============================================================ -->
  <section class="cta-section">
    <div class="container" style="text-align:center;">
      <span class="section-label" style="color:rgba(255,255,255,0.85)">— RÉSERVATION RAPIDE</span>
      <h2 class="cta-title">Offrez-vous un moment de pure détente</h2>
      <p class="cta-text">Réservez votre rituel hammam par WhatsApp. Notre équipe vous confirme votre créneau immédiatement selon vos disponibilités.</p>
      <div class="cta-buttons">
        <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20un%20rituel%20hammam.`} target="_blank" rel="noopener" class="btn-primary">
          Réserver par WhatsApp
        </a>
        <a href="tel:+212615109898" class="btn-secondary">
          06 15 10 98 98
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --mauve-light: #c4a1c2;
    --bg: #F7F3F7;
    --cream: #FAF7FA;
    --border: rgba(175, 132, 172, 0.25);
    --muted: #6B636B;
  }

  .hammam-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5rem 2rem 6.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .hammam-hero-inner { max-width: 850px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.75);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.85); text-decoration: underline; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mauve-light);
    margin-bottom: 1rem;
    display: block;
    font-weight: 700;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.92);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
    font-weight: 300;
  }

  .section { padding: 5.5rem 2rem; background: #FFFFFF; }
  .section-cream { background: #FAF7FA; }
  .container { max-width: 1100px; margin: 0 auto; }

  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.75rem;
    display: block;
    font-weight: 700;
  }
  .section-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: #2D2D2D;
  }
  .section-text {
    font-size: 0.96rem;
    line-height: 1.85;
    color: #555555;
    max-width: 700px;
  }

  /* Intro Layout */
  .intro-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .intro-perks {
    margin-top: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ip-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: #331535;
  }
  .ip-icon {
    color: var(--red);
    font-size: 0.9rem;
  }
  .intro-photo-card {
    position: relative;
  }
  .ipc-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 420px;
    box-shadow: 0 16px 45px rgba(51,21,53,0.12);
  }
  .ipc-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .ipc-frame:hover img {
    transform: scale(1.05);
  }
  .ipc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(51,21,53,0.4) 100%);
  }
  .ipc-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    padding: 0.75rem 1.25rem;
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgba(175,132,172,0.25);
  }
  .ipc-badge-icon {
    color: var(--red);
    font-size: 1.2rem;
  }
  .ipc-badge strong {
    display: block;
    font-size: 0.85rem;
    color: #2D2D2D;
    line-height: 1.2;
  }
  .ipc-badge small {
    display: block;
    font-size: 0.72rem;
    color: #777777;
  }

  /* Ritual Steps */
  .ritual-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
    margin-top: 2rem;
  }
  .ritual-step {
    display: flex;
    gap: 1.5rem;
    padding: 2.2rem;
    background: #FFFFFF;
    border: 1px solid rgba(175,132,172,0.2);
    border-radius: 12px;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    box-shadow: 0 6px 20px rgba(0,0,0,0.03);
  }
  .ritual-step:hover {
    border-color: var(--red);
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(175, 132, 172, 0.18);
  }
  .rs-num {
    width: 48px; height: 48px;
    background: #F7F3F7;
    border: 2px solid var(--red);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.25rem;
    color: var(--red);
    font-weight: 700;
    flex-shrink: 0;
  }
  .rs-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: #2D2D2D;
  }
  .rs-text {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.75;
  }

  /* Hammam Gallery Mosaic */
  .hammam-gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .hg-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 280px;
    box-shadow: 0 10px 30px rgba(51,21,53,0.08);
  }
  .hg-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .hg-card:hover img {
    transform: scale(1.08);
  }
  .hg-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1.2rem;
    background: linear-gradient(180deg, transparent 0%, rgba(51,21,53,0.85) 100%);
    color: #FFFFFF;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Pricing Plans */
  .pricing-plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }
  .plan {
    background: #FFFFFF;
    border: 1px solid rgba(175,132,172,0.25);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s;
