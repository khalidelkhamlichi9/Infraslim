---
import Layout from '../layouts/Layout.astro';
import { getGlobalSettings } from '../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Tarifs et packs minceur à Rabat | INFRASLIM" description="Tous nos tarifs 2026 à Agdal : sport infrarouge, soins amincissants, visage, laser et hammam. Packs de dix séances valables toute l'année." currentPath="/tarifs">

  <!-- ============================================================
       HERO TARIFS (PREMIUM STYLE CLAIR / MAUVE DÉGRADÉ)
  ============================================================ -->
  <section class="tarifs-hero">
    <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=1920&q=85" alt="Tarifs INFRASLIM Agdal Rabat" class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="hero-bg-overlay"></div>
    <div class="tarifs-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; Tarifs
      </div>
      <div class="hero-eyebrow">— TARIFS 2026 · TRANSPARENCE TOTALE</div>
      <h1 class="hero-title">Tarifs et packs minceur à <em>Rabat</em></h1>
      <p class="hero-desc">Tous nos prix, sans supplément ni frais caché. Les packs de dix séances sont la formule la plus avantageuse et restent valables toute l'année.</p>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE STRIP
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Sport Infrarouge 1 500 DH les 10</span><span class="sep"></span></div>
      <div class="marquee-item"><span>VelaShape 300 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hydrafacial 400 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Laser Diode 200 DH / zone</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam dès 150 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Packs valables toute l'année</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Diagnostic InBody Offert</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Sport Infrarouge 1 500 DH les 10</span><span class="sep"></span></div>
      <div class="marquee-item"><span>VelaShape 300 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hydrafacial 400 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Laser Diode 200 DH / zone</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam dès 150 DH</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Packs valables toute l'année</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Diagnostic InBody Offert</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       CONTENU TARIFS COMPLET (5 UNIVERS + PACK CALLOUT)
  ============================================================ -->
  <section class="section tarifs-section">
    <div class="container">

      <div class="disclaimer reveal">
        <span class="disc-icon">
          <svg class="h-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <span>Tarifs officiels valables en 2026 au centre INFRASLIM Agdal. Bilan impédancemétrie InBody systématiquement offert avant tout programme.</span>
      </div>

      <!-- 01 · Sport Nouvelle Génération -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=800&q=80" alt="Sport Infrarouge INFRASLIM" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">01 — ACTIVITÉ PHYSIQUE & INFRAROUGE</div>
            <h2 class="ps-title">Sport nouvelle génération</h2>
            <p class="ps-sub">Nos équipements infrarouge et vacuum, et notre espace de renforcement musculaire avec coach.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20une%20s%C3%A9ance%20Sport.`} target="_blank" rel="noopener" class="ps-cta-btn">Réserver ce Pôle →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>La séance</th>
                <th>Pack 10 séances</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>InfraBike</strong> (30 min · Vélo allongé infrarouge &amp; vacuum)</td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Tapis roulant infrarouge</strong> (30 min · Marche sous vide)</td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Infra Roller</strong> (30 min · Rouleaux massants &amp; chaleur)</td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Renforcement musculaire</strong> (Avec machines et coach)</td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p style="padding: 0.9rem 2.2rem; margin: 0; font-size: 0.85rem; color: #555; background: #FAF7FA; border-top: 1px solid rgba(175,132,172,0.15);">Le pack de dix séances fait tomber la séance à 150 DH, soit la moitié du tarif à l'unité.</p>
      </div>

      <!-- 02 · Soins Amincissants -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=800&q=80" alt="Soins Amincissants VelaShape" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">02 — CORPS & SILHOUETTE</div>
            <h2 class="ps-title">Soins amincissants</h2>
            <p class="ps-sub">Du soin d'entrée de gamme au soin manuel réalisé par une praticienne.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20un%20soin%20Minceur.`} target="_blank" rel="noopener" class="ps-cta-btn">Réserver ce Pôle →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>La séance</th>
                <th>Pack 10 séances</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Sauna dôme</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Pressothérapie</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Couverture chauffante</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">1 500 DH <span class="col-eco">150 DH / séance</span></td>
              </tr>
              <tr class="highlight-row">
                <td><strong>VelaShape</strong> <span class="tag-star">★ Populaire</span></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">2 000 DH <span class="col-eco">200 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Massage amincissant</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">2 500 DH <span class="col-eco">250 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Massage tonifiant</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">2 500 DH <span class="col-eco">250 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Massage relaxant</strong></td>
                <td class="col-price">300 DH</td>
                <td class="col-pack">2 500 DH <span class="col-eco">250 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Madérothérapie</strong></td>
                <td class="col-price">600 DH</td>
                <td class="col-pack">5 000 DH <span class="col-eco">500 DH / séance</span></td>
              </tr>
              <tr>
                <td><strong>Drainage lymphatique</strong></td>
                <td class="col-price">600 DH</td>
                <td class="col-pack">5 000 DH <span class="col-eco">500 DH / séance</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p style="padding: 0.9rem 2.2rem; margin: 0; font-size: 0.85rem; color: #555; background: #FAF7FA; border-top: 1px solid rgba(175,132,172,0.15);">Les soins manuels, madérothérapie et drainage lymphatique, sont réalisés par une praticienne et durent plus longtemps.</p>
      </div>

      <!-- 03 · Soins du Visage -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=800&q=80" alt="Soins du Visage Hydrafacial Kobido" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">03 — VISAGE & ÉCLAT DU TEINT</div>
            <h2 class="ps-title">Soins du visage</h2>
            <p class="ps-sub">Le protocole est choisi après un échange sur votre type de peau.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20un%20soin%20du%20Visage.`} target="_blank" rel="noopener" class="ps-cta-btn">Réserver ce Pôle →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>Le soin</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>Soin visage classique</strong></td><td class="col-price">400 DH</td></tr>
              <tr><td><strong>Massage Kobido</strong></td><td class="col-price">400 DH</td></tr>
              <tr class="highlight-row"><td><strong>Hydrafacial</strong> <span class="tag-star">★ Bestseller</span></td><td class="col-price">400 DH</td></tr>
              <tr><td><strong>Carbon Peel</strong></td><td class="col-price">400 DH</td></tr>
              <tr><td><strong>Microneedling</strong></td><td class="col-price">450 DH</td></tr>
              <tr><td><strong>Soin anti-âge</strong></td><td class="col-pack">800 DH</td></tr>
              <tr><td><strong>Soin anti-taches</strong></td><td class="col-pack">800 DH</td></tr>
              <tr><td><strong>Soin anti-acné</strong></td><td class="col-pack">800 DH</td></tr>
            </tbody>
          </table>
        </div>
        <p style="padding: 0.9rem 2.2rem; margin: 0; font-size: 0.85rem; color: #555; background: #FAF7FA; border-top: 1px solid rgba(175,132,172,0.15);">Les soins à 800 DH sont des protocoles complets, plus longs, construits autour d'une problématique précise.</p>
      </div>

      <!-- 04 · Épilation définitive et laser -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=800&q=80" alt="Épilation Laser Diode" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">04 — ÉPILATION DÉFINITIVE & LASER</div>
            <h2 class="ps-title">Épilation définitive et laser</h2>
            <p class="ps-sub">Par une équipe 100 % féminine à Agdal, Rabat.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20une%20s%C3%A9ance%20Laser.`} target="_blank" rel="noopener" class="ps-cta-btn">Réserver ce Pôle →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>Le tarif</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>Laser diode, par zone</strong></td><td class="col-price">200 DH</td></tr>
              <tr><td><strong>Laser diode, corps complet</strong></td><td class="col-pack">2 000 DH</td></tr>
              <tr><td><strong>Détatouage, par zone</strong></td><td class="col-price">400 DH</td></tr>
            </tbody>
          </table>
        </div>
        <p style="padding: 0.9rem 2.2rem; margin: 0; font-size: 0.85rem; color: #555; background: #FAF7FA; border-top: 1px solid rgba(175,132,172,0.15);">Le nombre de séances dépend de la zone et de votre peau. Nous en parlons au premier rendez-vous.</p>
      </div>

      <!-- 04b · Épilation à la cire -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=800&q=80" alt="Épilation à la cire" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">04b — ÉPILATION TRADITIONNELLE</div>
            <h2 class="ps-title">Épilation à la cire</h2>
            <p class="ps-sub">Toutes zones, sans engagement, par nos praticiennes.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20une%20%C3%A9pilation%20%C3%A0%20la%20cire.`} target="_blank" rel="noopener" class="ps-cta-btn">Réserver →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Zone</th>
                <th>Le tarif</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>Jambes entières</strong></td><td class="col-price">100 DH</td></tr>
              <tr><td><strong>Demi-jambes</strong></td><td class="col-price">60 DH</td></tr>
              <tr><td><strong>Bras entiers</strong></td><td class="col-price">70 DH</td></tr>
              <tr><td><strong>Aisselles</strong></td><td class="col-price">50 DH</td></tr>
              <tr><td><strong>Maillot intégral</strong></td><td class="col-price">100 DH</td></tr>
              <tr><td><strong>Visage</strong></td><td class="col-price">100 DH</td></tr>
              <tr><td><strong>Duvet ou menton</strong></td><td class="col-price">50 DH</td></tr>
              <tr><td><strong>Sourcils</strong></td><td class="col-price">50 DH</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 05 · Hammam & Rituels -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual-photo">
            <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=800&q=80" alt="Hammam Traditionnel Marocain" />
            <div class="psv-overlay"></div>
          </div>
          <div class="ps-title-info">
            <div class="ps-label">05 — RITUELS TRADITIONNELS & BIEN-ÊTRE</div>
            <h2 class="ps-title">Hammam</h2>
            <p class="ps-sub">Savon noir, gommage au kessa et rinçage dans un espace 100 % femmes.</p>
          </div>
          <a href="/services/hammam" class="ps-cta-btn">Découvrir le Hammam →</a>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>Le tarif</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Hammam Infraslim</strong> (savon noir, gommage au kessa, rinçage)</td>
                <td class="col-price">150 DH</td>
              </tr>
              <tr class="highlight-row">
                <td><strong>Hammam Royal</strong> (version complète &amp; enveloppante) <span class="tag-star">★ Populaire</span></td>
                <td class="col-pack">250 DH</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pack Callout VIP : Avant de choisir & Paiement -->
      <div class="pack-callout reveal">
        <div class="pack-callout-inner">
          <div class="icon">
            <svg class="h-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
          </div>
          <div class="pack-callout-text">
            <strong>Avant de choisir, faites le diagnostic · Modes de paiement et validité</strong>
            <p>Masse grasse, masse musculaire, rétention d'eau : le diagnostic InBody est offert et nous sert à vous orienter vers les séances qui vous conviennent vraiment. Les packs de dix séances sont <strong>valables toute l'année</strong>. Nous acceptons les <strong>espèces</strong> et le <strong>virement bancaire</strong>, et un <strong>règlement en plusieurs fois</strong> est possible.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20des%20renseignements%20sur%20les%20packs%2010%20s%C3%A9ances.`} target="_blank" rel="noopener" class="btn-pack-wa">
            Renseignements Packs →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       CTA CONVERSION
  ============================================================ -->
  <section class="cta-section">
    <div class="container" style="text-align: center;">
      <h2 class="cta-title">Prête à commencer votre programme ?</h2>
      <p class="cta-text">Contactez-nous par WhatsApp pour réserver votre première séance ou bénéficier de votre bilan InBody offert.</p>
      <div class="cta-buttons">
        <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20une%20s%C3%A9ance.`} target="_blank" rel="noopener" class="btn-primary">
          Réserver par WhatsApp
        </a>
        <a href="/contact" class="btn-secondary">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --mauve-light: #c4a1c2;
    --bg: #F7F3F7;
    --border: rgba(175, 132, 172, 0.25);
    --muted: #6B636B;
  }

  .tarifs-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5rem 2rem 6.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .tarifs-hero-inner { max-width: 850px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.75);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.85); text-decoration: underline; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mauve-light);
    margin-bottom: 1rem;
    display: block;
    font-weight: 700;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.92);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
    font-weight: 300;
  }

  .tarifs-section { padding: 4.5rem 2rem 6rem; background: #FAF7FA; }
  .container { max-width: 1120px; margin: 0 auto; }

  .disclaimer {
    background: #FFFFFF;
    border: 1px solid rgba(175,132,172,0.3);
    border-radius: 12px;
    padding: 1.2rem 1.8rem;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #4A284B;
    font-size: 0.92rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .disc-icon { color: var(--red); font-size: 1.1rem; }

  /* PRICING SECTION BLOCK AVEC PHOTO HERO */
  .pricing-section-block {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(175,132,172,0.22);
    overflow: hidden;
    margin-bottom: 3rem;
    box-shadow: 0 12px 35px rgba(51,21,53,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pricing-section-block:hover {
    box-shadow: 0 16px 45px rgba(51,21,53,0.1);
  }
  .ps-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.8rem 2.2rem;
    background: #FDFBFC;
    border-bottom: 1px solid rgba(175,132,172,0.15);
  }
  .ps-visual-photo {
    width: 90px;
    height: 90px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(0,0,0,0.12);
  }
  .ps-visual-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
