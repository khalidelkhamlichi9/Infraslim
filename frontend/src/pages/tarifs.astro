---
import Layout from '../layouts/Layout.astro';
import { getGlobalSettings } from '../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Tarifs 2026 | INFRASLIM Agdal Rabat" currentPath="/tarifs">

  <!-- ============================================================
       HERO TARIFS (PREMIUM STYLE CLAIR / MAUVE DÉGRADÉ)
  ============================================================ -->
  <section class="tarifs-hero">
    <div class="tarifs-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; Tarifs
      </div>
      <div class="hero-eyebrow">— TARIFS 2026 · TRANSPARENCE TOTALE</div>
      <h1 class="hero-title">Nos <em>Tarifs</em></h1>
      <p class="hero-desc">Des soins d'exception à des tarifs clairs et transparents. Packs 10 séances disponibles pour tous nos services avec 20% d'économie immédiate.</p>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE STRIP
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Sport à partir de 100 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>VelaShape 350 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hydrafacial 500 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Laser à partir de 150 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam dès 80 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Pack 10 séances = -20%</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Tarifs 2026</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Sport à partir de 100 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>VelaShape 350 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hydrafacial 500 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Laser à partir de 150 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam dès 80 MAD</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Pack 10 séances = -20%</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Tarifs 2026</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       CONTENU TARIFS COMPLET (5 UNIVERS + PACK CALLOUT)
  ============================================================ -->
  <section class="section tarifs-section">
    <div class="container">

      <div class="disclaimer reveal">
        📅 Tarifs officiels valables en 2026 au centre INFRASLIM Agdal. Bilan InBody systématiquement offert.
      </div>

      <!-- 01 · Sport Nouvelle Génération -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual" style="background: linear-gradient(135deg, #1a237e, #283593);"></div>
          <div>
            <div class="ps-label">01 — Activité Physique</div>
            <h2 class="ps-title">Sport Nouvelle Génération</h2>
          </div>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>1 séance</th>
                <th>Pack 10 séances</th>
                <th>Économie</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>InfraBike Allongé (30 min)</td>
                <td class="col-price">100 MAD</td>
                <td class="col-pack">800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Tapis roulant infrarouge (30 min)</td>
                <td class="col-price">100 MAD</td>
                <td class="col-pack">800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Infra Roller Massage (30 min)</td>
                <td class="col-price">150 MAD</td>
                <td class="col-pack">1 200 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Renforcement musculaire ciblé</td>
                <td class="col-price">100 MAD</td>
                <td class="col-pack">800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 02 · Soins Amincissants -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual" style="background: linear-gradient(135deg, #4a148c, #6a1b9a);"></div>
          <div>
            <div class="ps-label">02 — Corps & Silhouette</div>
            <h2 class="ps-title">Soins Amincissants</h2>
          </div>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>1 séance</th>
                <th>Pack 10 séances</th>
                <th>Économie</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>VelaShape Anti-Cellulite</td>
                <td class="col-price">350 MAD</td>
                <td class="col-pack">2 800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Madérothérapie Sculptante</td>
                <td class="col-price">200 MAD</td>
                <td class="col-pack">1 600 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Drainage Lymphatique Renata</td>
                <td class="col-price">200 MAD</td>
                <td class="col-pack">1 600 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Pressothérapie Médicale</td>
                <td class="col-price">150 MAD</td>
                <td class="col-pack">1 200 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Sauna Dôme Détox</td>
                <td class="col-price">100 MAD</td>
                <td class="col-pack">800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Couverture chauffante amincissante</td>
                <td class="col-price">100 MAD</td>
                <td class="col-pack">800 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Massages amincissants & relaxants</td>
                <td class="col-price">200 MAD</td>
                <td class="col-pack">1 600 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 03 · Soins du Visage -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual" style="background: linear-gradient(135deg, #7f1d1d, #991b1b);"></div>
          <div>
            <div class="ps-label">03 — Visage & Éclat</div>
            <h2 class="ps-title">Soins du Visage</h2>
          </div>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>1 séance</th>
                <th>Pack 10 séances</th>
                <th>Économie</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Soin visage classique nettoyant</td>
                <td class="col-price">200 MAD</td>
                <td class="col-pack">1 600 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Hydrafacial Deluxe complet</td>
                <td class="col-price">500 MAD</td>
                <td class="col-pack">4 000 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Carbon Peel Laser Hollywood</td>
                <td class="col-price">400 MAD</td>
                <td class="col-pack">3 200 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Massage Kobido Liftant Japonais</td>
                <td class="col-price">300 MAD</td>
                <td class="col-pack">2 400 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Microneedling & Sérums traitants</td>
                <td class="col-price">400 MAD</td>
                <td class="col-pack">3 200 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Soin anti-âge régénérant</td>
                <td class="col-price">300 MAD</td>
                <td class="col-pack">2 400 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Soin anti-taches & unifiant</td>
                <td class="col-price">300 MAD</td>
                <td class="col-pack">2 400 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
              <tr>
                <td>Soin anti-acné purifiant</td>
                <td class="col-price">250 MAD</td>
                <td class="col-pack">2 000 MAD</td>
                <td class="col-eco">-20%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 04 · Épilation & Laser -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual" style="background: linear-gradient(135deg, #0d1b2a, #1b2a3b);"></div>
          <div>
            <div class="ps-label">04 — Épilation & Laser</div>
            <h2 class="ps-title">Épilation & Laser</h2>
          </div>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Prestation</th>
                <th>Prix</th>
                <th>Remarque</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Épilation laser diode</td>
                <td class="col-price">À partir de 150 MAD</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Selon la zone sélectionnée</td>
              </tr>
              <tr>
                <td>Détatouage laser</td>
                <td class="col-price">Sur devis</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Selon la dimension et les pigments</td>
              </tr>
              <tr>
                <td>Épilation traditionnelle à la cire</td>
                <td class="col-price">À partir de 50 MAD</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Selon la zone</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 05 · Hammam & Rituels -->
      <div class="pricing-section-block reveal">
        <div class="ps-header">
          <div class="ps-visual" style="background: linear-gradient(135deg, #78350f, #92400e);"></div>
          <div>
            <div class="ps-label">05 — Rituels & Bien-être</div>
            <h2 class="ps-title">Hammam Traditionnel Marocain</h2>
          </div>
        </div>
        <div class="pricing-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Formule</th>
                <th>Prix</th>
                <th>Détails</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Accès hammam seul (45 min)</td>
                <td class="col-price">80 MAD</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Vapeur bienfaisante & détente</td>
              </tr>
              <tr>
                <td>Hammam + Gommage Kessa (1h)</td>
                <td class="col-price">150 MAD</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Vapeur, savon noir beldi & gommage complet</td>
              </tr>
              <tr>
                <td>Rituel complet impérial (1h30 – 2h)</td>
                <td class="col-price">250 MAD</td>
                <td style="color: var(--muted); font-size: 0.85rem;">Hammam, kessa, savon beldi, ghassoul & enveloppement</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pack Callout -->
      <div class="pack-callout reveal">
        <div class="icon">💡</div>
        <div>
          <strong>Les packs 10 séances représentent une économie de 20%</strong> par rapport aux séances à l'unité. C'est la formule idéale pour engager un protocole complet et consolider vos résultats durablement.
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       CTA CONVERSION
  ============================================================ -->
  <section class="cta-section">
    <div class="container" style="text-align: center;">
      <h2 class="cta-title">Prête à commencer votre programme ?</h2>
      <p class="cta-text">Contactez-nous par WhatsApp pour réserver votre séance ou bénéficier de votre bilan InBody gratuit.</p>
      <div class="cta-buttons">
        <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20r%C3%A9server%20une%20s%C3%A9ance.`} target="_blank" rel="noopener" class="btn-primary">
          Réserver par WhatsApp
        </a>
        <a href="/contact" class="btn-secondary">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --mauve-light: #c4a1c2;
    --bg: #F7F3F7;
    --border: rgba(175, 132, 172, 0.25);
    --muted: #6B636B;
  }

  .tarifs-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #91648e 100%);
    color: #FFFFFF;
    padding: 4.5rem 2rem 5.5rem;
    text-align: center;
  }
  .tarifs-hero-inner { max-width: 820px; margin: 0 auto; }
  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #DEC9DD;
    margin-bottom: 1rem;
    display: block;
    font-weight: 600;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.02rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.75;
    max-width: 650px;
    margin: 0 auto;
  }

  .tarifs-section {
    padding: 5rem 2rem;
    background: #FAF7FA;
  }
  .container { max-width: 1100px; margin: 0 auto; }

  .disclaimer {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-left: 4px solid var(--red);
    padding: 1.1rem 1.5rem;
    font-size: 0.88rem;
    color: #444;
    border-radius: 6px;
    margin-bottom: 3rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }

  .pricing-section-block {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.5rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }
  .ps-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .ps-visual {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ps-label {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .ps-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.7rem;
    font-weight: 400;
    color: #2D2D2D;
  }

  .pricing-wrapper { overflow-x: auto; }
  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 500px;
  }
  .pricing-table thead th {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid #F0E8F0;
  }
  .pricing-table tbody td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid #F7F3F7;
    font-size: 0.92rem;
    color: #333;
  }
  .pricing-table tbody tr:hover td {
    background: #FAF7FA;
  }
  .col-price { font-weight: 600; color: #2D2D2D; }
  .col-pack { font-weight: 700; color: var(--red); }
  .col-eco { font-size: 0.8rem; color: #16a34a; font-weight: 600; }

  .pack-callout {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-left: 4px solid var(--red);
    border-radius: 8px;
    padding: 2rem 2.5rem;
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }
  .pack-callout .icon { font-size: 2rem; flex-shrink: 0; }
  .pack-callout strong { color: var(--red); }

  .cta-section {
    background: linear-gradient(135deg, #AF84AC 0%, #91648e 100%);
    color: #FFFFFF;
    padding: 5rem 2rem;
  }
  .cta-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin-bottom: 1rem;
    color: #FFFFFF;
  }
  .cta-text {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.9);
    margin: 0 auto 2.5rem;
    max-width: 600px;
    line-height: 1.8;
  }
  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--red);
    color: #FFFFFF;
    padding: 0.9rem 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.3s;
  }
  .btn-primary:hover { background: var(--red-dark); }
  .btn-secondary {
    border: 2px solid rgba(255,255,255,0.7);
    color: #FFFFFF;
    padding: 0.9rem 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .btn-secondary:hover {
    background: #FFFFFF;
    color: #AF84AC;
  }

  @media (max-width: 768px) {
    .pricing-section-block { padding: 1.5rem; }
    .ps-header { flex-direction: column; align-items: flex-start; }
    .cta-buttons { flex-direction: column; }
    .btn-primary, .btn-secondary { width: 100%; text-align: center; }
  }
</style>
