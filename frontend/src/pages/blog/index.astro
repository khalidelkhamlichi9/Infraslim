---
import Layout from '../../layouts/Layout.astro';
import { getGlobalSettings } from '../../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Blog & Conseils Beauté | INFRASLIM — Agdal, Rabat" currentPath="/blog">

  <!-- ============================================================
       HERO BLOG
  ============================================================ -->
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; <span>Blog</span>
      </div>
      <div class="hero-eyebrow">— MAGAZINE · CONSEILS · BIEN-ÊTRE</div>
      <h1 class="hero-title">Le Journal <em>INFRASLIM</em></h1>
      <p class="hero-desc">Astuces minceur, secrets de soins visage, technologies infrarouges et rituels beauté pensés pour les femmes à Rabat.</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION ARTICLES AVEC FILTRES CATÉGORIES
  ============================================================ -->
  <section class="blog-section">
    <div class="blog-container">
      
      <!-- Boutons de filtre -->
      <div class="blog-filters">
        <button class="filter-btn active" data-cat="all">Tous les articles</button>
        <button class="filter-btn" data-cat="sport">Sport Infrarouge</button>
        <button class="filter-btn" data-cat="minceur">Amincissement</button>
        <button class="filter-btn" data-cat="visage">Soins Visage</button>
        <button class="filter-btn" data-cat="hammam">Hammam &amp; Laser</button>
      </div>

      <!-- Grille des 6 articles officiels -->
      <div class="blog-grid" id="blogGrid">

        <!-- Article 1 -->
        <article class="blog-card" data-cat="sport">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Sport Infrarouge</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">4 min de lecture · Sport Nouvelle Génération</div>
            <h2 class="blog-card-title">Comment brûler jusqu'à 1300 calories en 30 minutes avec l'InfraBike ?</h2>
            <p class="blog-card-excerpt">Découvrez pourquoi le vélo infrarouge sous vide révolutionne la remise en forme féminine à Agdal, Rabat.</p>
            <button class="blog-read-btn" data-id="0">Lire l'article →</button>
          </div>
        </article>

        <!-- Article 2 -->
        <article class="blog-card" data-cat="minceur">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Amincissement</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">5 min de lecture · Remodelage</div>
            <h2 class="blog-card-title">VelaShape vs Madérothérapie : quel soin choisir pour sculpter sa silhouette ?</h2>
            <p class="blog-card-excerpt">Radiofréquence ou massage aux rouleaux de bois ? Nos expertes vous aident à combiner les deux protocoles.</p>
            <button class="blog-read-btn" data-id="1">Lire l'article →</button>
          </div>
        </article>

        <!-- Article 3 -->
        <article class="blog-card" data-cat="visage">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Soins Visage</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">4 min de lecture · Éclat &amp; Peau</div>
            <h2 class="blog-card-title">Hydrafacial ou Carbon Peel : retrouver une peau lumineuse dès la première séance</h2>
            <p class="blog-card-excerpt">Un teint frais, des pores resserrés et une hydratation en profondeur sans éviction sociale.</p>
            <button class="blog-read-btn" data-id="2">Lire l'article →</button>
          </div>
        </article>

        <!-- Article 4 -->
        <article class="blog-card" data-cat="hammam">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Hammam</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">3 min de lecture · Bien-être</div>
            <h2 class="blog-card-title">Les bienfaits du Hammam traditionnel marocain 100% féminin</h2>
            <p class="blog-card-excerpt">Savon beldi, gant kessa et ghassoul : pourquoi intégrer ce rituel ancestral dans votre routine mensuelle.</p>
            <button class="blog-read-btn" data-id="3">Lire l'article →</button>
          </div>
        </article>

        <!-- Article 5 -->
        <article class="blog-card" data-cat="hammam">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Laser Diode</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">5 min de lecture · Épilation</div>
            <h2 class="blog-card-title">Épilation laser diode : tout savoir avant votre première séance</h2>
            <p class="blog-card-excerpt">Nombre de séances, préparation de la peau et résultats durables pour tous les phototypes.</p>
            <button class="blog-read-btn" data-id="4">Lire l'article →</button>
          </div>
        </article>

        <!-- Article 6 -->
        <article class="blog-card" data-cat="minceur">
          <div class="blog-card-img" style="background-image:url('https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=800&q=80')">
            <span class="blog-card-cat">Drainage</span>
          </div>
          <div class="blog-card-body">
            <div class="blog-meta">4 min de lecture · Circulation</div>
            <h2 class="blog-card-title">Drainage lymphatique &amp; Pressothérapie : dites adieu aux jambes lourdes</h2>
            <p class="blog-card-excerpt">Comment relancer la circulation lymphatique et éliminer la rétention d'eau naturellement.</p>
            <button class="blog-read-btn" data-id="5">Lire l'article →</button>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ============================================================
       MODAL ARTICLE POP-IN DYNAMIQUE
  ============================================================ -->
  <div class="blog-modal" id="blogModal">
    <div class="blog-modal-box">
      <button class="blog-modal-close" id="modalClose" aria-label="Fermer">&times;</button>
      <span class="blog-modal-tag" id="modalTag"></span>
      <h2 class="blog-modal-title" id="modalTitle"></h2>
      <div class="blog-modal-content" id="modalContent"></div>
      <div class="blog-modal-cta">
        <span style="font-size:0.88rem;color:#6B636B;">Envie d'essayer ce soin à Agdal, Rabat ?</span>
        <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous.`} target="_blank" rel="noopener" class="btn-wa-modal">Prendre RDV sur WhatsApp</a>
      </div>
    </div>
  </div>

</Layout>

<script>
  const articlesData = [
    {
      tag: "Sport Infrarouge",
      title: "Comment brûler jusqu'à 1300 calories en 30 minutes avec l'InfraBike ?",
      paragraphs: [
        "L'InfraBike associe le pédalage couché à la chaleur douce des lampes infrarouges et à l'effet sous vide. Pendant 30 minutes, votre corps travaille en profondeur tout en préservant vos articulations.",
        "La chaleur infrarouge pénètre les tissus adipeux, stimule la microcirculation et accélère la sudation, ce qui permet d'optimiser la dépense énergétique et de lisser l'aspect peau d'orange.",
        "Chez INFRASLIM Agdal, nos coachs adaptent l'intensité à votre niveau dès la première séance. Disponible à l'unité (100 MAD) ou en pack 10 séances (800 MAD)."
      ]
    },
    {
      tag: "Amincissement",
      title: "VelaShape vs Madérothérapie : quel soin choisir pour sculpter sa silhouette ?",
      paragraphs: [
        "Le VelaShape combine radiofréquence bipolaire, lumière infrarouge et palpé-roulé mécanique pour raffermir la peau et réduire les amas graisseux localisés.",
        "La Madérothérapie utilise des instruments en bois anatomiques pour stimuler le drainage, casser les amas cellulitiques et tonifier les courbes de façon 100% naturelle.",
        "L'idéal ? Alterner les deux soins dans un programme personnalisé établi par nos esthéticiennes lors de votre bilan InBody offert."
      ]
    },
    {
      tag: "Soins Visage",
      title: "Hydrafacial ou Carbon Peel : retrouver une peau lumineuse dès la première séance",
      paragraphs: [
        "L'Hydrafacial nettoie, exfolie et hydrate votre peau en profondeur grâce à des sérums riches en antioxydants et acide hyaluronique. Résultat : un teint frais et repulpé immédiatement.",
        "Le Carbon Peel, quant à lui, utilise une lotion au carbone activée par laser pour désobstruer les pores, unifier le teint et réguler l'excès de sébum."
      ]
    },
    {
      tag: "Hammam",
      title: "Les bienfaits du Hammam traditionnel marocain 100% féminin",
      paragraphs: [
        "Dans notre espace 100% féminin à Agdal, le hammam est un véritable moment de déconnexion. La vapeur ouvre les pores et prépare la peau au gommage au gant kessa et au savon beldi.",
        "L'enveloppement au ghassoul minéralise et purifie l'épiderme, laissant votre peau incroyablement douce et apaisée."
      ]
    },
    {
      tag: "Laser Diode",
      title: "Épilation laser diode : tout savoir avant votre première séance",
      paragraphs: [
        "Notre laser diode de dernière génération cible le follicule pileux avec précision tout en protégeant la peau grâce à un système de refroidissement intégré.",
        "En moyenne, 6 à 8 séances espacées de quelques semaines permettent une réduction durable de la pilosité, sur tous les types de peau."
      ]
    },
    {
      tag: "Drainage",
      title: "Drainage lymphatique & Pressothérapie : dites adieu aux jambes lourdes",
      paragraphs: [
        "Le drainage lymphatique manuel et les bottes de pressothérapie relancent la circulation veino-lymphatique, réduisent la rétention d'eau et procurent une sensation immédiate de légèreté.",
        "C'est le complément parfait après vos séances de sport infrarouge ou de remodelage corporel."
      ]
    }
  ];

  // Filtres catégories
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-cat');
      document.querySelectorAll('.blog-card').forEach(card => {
        const c = card as HTMLElement;
        c.style.display = (cat === 'all' || card.getAttribute('data-cat') === cat) ? 'flex' : 'none';
      });
    });
  });

  // Modal lecture article
  const modal = document.getElementById('blogModal');
  const modalTag = document.getElementById('modalTag');
  const modalTitle = document.getElementById('modalTitle');
  const modalContent = document.getElementById('modalContent');
  
  document.querySelectorAll('.blog-read-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const art = articlesData[parseInt(btn.getAttribute('data-id') || '0', 10)];
      if (!art || !modal || !modalTag || !modalTitle || !modalContent) return;
      modalTag.textContent = art.tag;
      modalTitle.textContent = art.title;
      modalContent.innerHTML = art.paragraphs.map(p => `<p>${p}</p>`).join('');
      modal.classList.add('open');
    });
  });

  document.getElementById('modalClose')?.addEventListener('click', () => modal?.classList.remove('open'));
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });
</script>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --bg: #F7F3F7;
    --muted: #6B636B;
    --border: rgba(175, 132, 172, 0.25);
  }

  .blog-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #91648e 100%);
    color: #FFFFFF;
    padding: 4.5rem 2rem 5.5rem;
    text-align: center;
  }
  .blog-hero-inner { max-width: 820px; margin: 0 auto; }
  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #DEC9DD;
    margin-bottom: 1rem;
    display: block;
    font-weight: 600;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.02rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.75;
    max-width: 680px;
    margin: 0 auto;
  }

  .blog-section { padding: 5rem 2rem; background: #FFFFFF; }
  .blog-container { max-width: 1200px; margin: 0 auto; }

  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }
  .filter-btn {
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    border: 1.5px solid rgba(175, 132, 172, 0.35);
    background: #FFFFFF;
    color: #6B636B;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--red);
    border-color: var(--red);
    color: #FFFFFF;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 960px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .blog-grid { grid-template-columns: 1fr; } }

  .blog-card {
    background: #FFFFFF;
    border: 1px solid rgba(175, 132, 172, 0.25);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .blog-card:hover {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 18px 40px rgba(175, 132, 172, 0.2);
  }
  .blog-card-img {
    height: 220px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .blog-card-cat {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--red);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 50px;
  }
  .blog-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-meta {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .blog-card-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #2D2D2D;
    line-height: 1.3;
    margin-bottom: 0.8rem;
  }
  .blog-card-excerpt {
    font-size: 0.88rem;
    color: #6B636B;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    flex: 1;
  }
  .blog-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--red);
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: 'Poppins', sans-serif;
    transition: gap 0.2s;
  }
  .blog-read-btn:hover { gap: 0.75rem; }

  /* Modal article */
  .blog-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(45, 45, 45, 0.55);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .blog-modal.open { display: flex; }
  .blog-modal-box {
    background: #FFFFFF;
    border-radius: 16px;
    max-width: 720px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 2.5rem;
    position: relative;
    box-shadow: 0 25px 60px rgba(0,0,0,0.2);
  }
  .blog-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #F7F3F7;
    color: #2D2D2D;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-modal-close:hover { background: var(--red); color: #FFFFFF; }
  .blog-modal-tag {
    display: inline-block;
    background: rgba(187,32,38,0.1);
    color: var(--red);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.8rem;
    border-radius: 50px;
    margin-bottom: 1rem;
  }
  .blog-modal-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 2rem;
    color: #2D2D2D;
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }
  .blog-modal-content p {
    font-size: 0.95rem;
    color: #4A4A4A;
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .blog-modal-cta {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(175, 132, 172, 0.25);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-wa-modal {
    background: #25D366;
    color: #FFFFFF;
    padding: 0.75rem 1.6rem;
    border-radius: 4px;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s;
  }
  .btn-wa-modal:hover { background: #1eb954; }
</style>
