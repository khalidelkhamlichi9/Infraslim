---
import Layout from '../../layouts/Layout.astro';
import { getGlobalSettings, getArticles } from '../../lib/strapi';

const settings = await getGlobalSettings();
const articles = await getArticles();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;

// Map categories to filter data attributes
const catMap = {
  'Sport Infrarouge': 'sport',
  'Amincissement': 'minceur',
  'Soins Visage': 'visage',
  'Bien-être': 'hammam',
  'Laser Diode': 'hammam',
  'Drainage': 'minceur',
};

const articlesWithCat = articles.map(article => ({
  ...article,
  dataCat: catMap[article.category] || 'minceur',
}));
---

<Layout title="Blog minceur et beauté à Rabat | INFRASLIM" description="Conseils minceur, sport, soins du visage et bien-être, par le centre INFRASLIM à Agdal, Rabat. Articles écrits par notre équipe." currentPath="/blog">

  <!-- ============================================================
       HERO BLOG
  ============================================================ -->
  <section class="blog-hero">
    <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1920&q=85" alt="Le Journal INFRASLIM Beauté et Bien-Être" class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="blog-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; <span>Blog</span>
      </div>
      <div class="hero-eyebrow">— CONSEILS · MINCEUR · BEAUTÉ · BIEN-ÊTRE</div>
      <h1 class="hero-title">Conseils minceur, beauté et bien-être à <em>Rabat</em></h1>
      <p class="hero-desc">Nos conseils pour comprendre les soins, choisir ce qui vous convient et prendre soin de vous entre deux séances.</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION ARTICLES
  ============================================================ -->
  <section class="blog-section">
    <div class="blog-container">
      
      <!-- Boutons de filtre -->
      <div class="blog-filters">
        <button class="filter-btn active" data-cat="all">Tous</button>
        <button class="filter-btn" data-cat="sport">Sport</button>
        <button class="filter-btn" data-cat="minceur">Amincissement</button>
        <button class="filter-btn" data-cat="visage">Visage</button>
        <button class="filter-btn" data-cat="hammam">Bien-être</button>
      </div>

      <!-- Grille des articles avec liens -->
      <div class="blog-grid" id="blogGrid">
        {articlesWithCat.map((article) => (
          <article class="blog-card" data-cat={article.dataCat}>
            <a href={`/blog/${article.slug}`} class="blog-card-link">
              <div class="blog-card-img" style={`background-image:url('${article.image}')`}>
                <span class="blog-card-cat">{article.category}</span>
              </div>
              <div class="blog-card-body">
                <div class="blog-meta">{article.readTime} de lecture · {article.date}</div>
                <h2 class="blog-card-title">{article.title}</h2>
                <p class="blog-card-excerpt">{article.excerpt}</p>
                <span class="blog-read-btn">Lire l'article →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  // Filtres catégories
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-cat');
      document.querySelectorAll('.blog-card').forEach(card => {
        const c = card as HTMLElement;
        c.style.display = (cat === 'all' || card.getAttribute('data-cat') === cat) ? 'flex' : 'none';
      });
    });
  });
</script>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --bg: #F7F3F7;
    --muted: #6B636B;
    --border: rgba(175, 132, 172, 0.25);
  }

  .blog-hero {
    background: linear-gradient(135deg, #2D142C 0%, #1A0B19 100%);
    color: #FFFFFF;
    padding: 6rem 2rem 7rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.28;
    filter: saturate(1.1);
  }
  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(30,10,25,0.7) 0%, rgba(30,10,25,0.92) 100%);
  }
  .blog-hero-inner { max-width: 820px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #DEC9DD;
    margin-bottom: 1rem;
    display: block;
    font-weight: 600;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.02rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.75;
    max-width: 680px;
    margin: 0 auto;
  }

  .blog-section { padding: 5rem 2rem; background: #FFFFFF; }
  .blog-container { max-width: 1200px; margin: 0 auto; }

  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }
  .filter-btn {
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    border: 1.5px solid rgba(175, 132, 172, 0.35);
    background: #FFFFFF;
    color: #6B636B;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--red);
    border-color: var(--red);
    color: #FFFFFF;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 960px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .blog-grid { grid-template-columns: 1fr; } }

  .blog-card {
    background: #FFFFFF;
    border: 1px solid rgba(175, 132, 172, 0.25);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .blog-card:hover {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 18px 40px rgba(175, 132, 172, 0.2);
  }
  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-card-img {
    height: 220px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .blog-card-cat {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--red);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 50px;
  }
  .blog-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-meta {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .blog-card-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #2D2D2D;
    line-height: 1.3;
    margin-bottom: 0.8rem;
  }
  .blog-card-excerpt {
    font-size: 0.88rem;
    color: #6B636B;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    flex: 1;
  }
  .blog-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--red);
    font-weight: 600;
    font-size: 0.86rem;
    font-family: 'Poppins', sans-serif;
    transition: gap 0.2s;
  }
  .blog-card:hover .blog-read-btn { gap: 0.75rem; }
</style>
