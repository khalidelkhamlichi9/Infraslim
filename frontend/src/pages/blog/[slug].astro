---
import Layout from '../../layouts/Layout.astro';
import { getArticles, getGlobalSettings } from '../../lib/strapi';
import type { Article } from '../../lib/strapi';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const settings = await getGlobalSettings();
const articles = await getArticles();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;

// Related articles (excluding current)
const related = articles.filter(a => a.slug !== article.slug).slice(0, 3);

// Split content by \n\n for paragraph rendering
const paragraphs = article.content.split('\n\n').filter(p => p.trim());
---

<Layout title={`${article.title} | Blog INFRASLIM`} description={article.excerpt} currentPath={`/blog/${article.slug}`}>
  
  <!-- ============================================================
       HERO ARTICLE
  ============================================================ -->
  <section class="article-hero">
    <img src={article.image} alt={article.title} class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="article-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; <a href="/blog">Blog</a> &nbsp;/&nbsp; <span>{article.category}</span>
      </div>
      <span class="cat-badge">{article.category}</span>
      <h1 class="hero-title">{article.title}</h1>
      <div class="hero-meta">{article.date} · {article.readTime} de lecture</div>
    </div>
  </section>

  <!-- ============================================================
       ARTICLE CONTENT
  ============================================================ -->
  <section class="article-body">
    <div class="article-container">
      
      <div class="article-lead">
        <p>{article.excerpt}</p>
      </div>

      <div class="article-content">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <!-- CTA WhatsApp -->
      <div class="article-cta">
        <div class="cta-inner">
          <div class="cta-icon">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </div>
          <div class="cta-text">
            <h3>Envie d'essayer ce soin à Agdal ?</h3>
            <p>Nos expertes vous conseillent gratuitement lors d'un bilan InBody offert.</p>
          </div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20en%20savoir%20plus%20sur%20${encodeURIComponent(article.title)}.`} target="_blank" rel="noopener" class="btn-cta">
            Prendre RDV sur WhatsApp →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       ARTICLES SIMILAIRES
  ============================================================ -->
  {related.length > 0 && (
    <section class="related-section">
      <div class="related-container">
        <span class="related-eyebrow">— À LIRE AUSSI</span>
        <h2 class="related-title">Articles similaires</h2>
        <div class="related-grid">
          {related.map((rel) => (
            <a href={`/blog/${rel.slug}`} class="related-card">
              <div class="related-card-img" style={`background-image:url('${rel.image}')`}>
                <span class="related-card-cat">{rel.category}</span>
              </div>
              <div class="related-card-body">
                <div class="related-meta">{rel.readTime} de lecture</div>
                <h3 class="related-card-title">{rel.title}</h3>
                <span class="related-link">Lire l'article →</span>
              </div>
            </a>
          ))}
        </div>
        <div style="text-align:center; margin-top:3rem;">
          <a href="/blog" class="btn-back">← Retour au Journal</a>
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --muted: #6B636B;
    --border: rgba(175, 132, 172, 0.25);
  }

  /* HERO */
  .article-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5rem 2rem 6rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .article-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .cat-badge {
    display: inline-block;
    background: var(--red);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #FFFFFF;
  }
  .hero-meta {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.75);
  }

  /* ARTICLE BODY */
  .article-body {
    padding: 4.5rem 2rem 5rem;
    background: #FFFFFF;
  }
  .article-container {
    max-width: 780px;
    margin: 0 auto;
  }
  .article-lead {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .article-lead p {
    font-size: 1.15rem;
    font-weight: 500;
    color: #2D2D2D;
    line-height: 1.8;
  }
  .article-content p {
    font-size: 1.02rem;
    color: #444444;
    line-height: 1.9;
    margin-bottom: 1.5rem;
  }

  /* CTA */
  .article-cta {
    margin-top: 3.5rem;
    background: #FAF7FA;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  .cta-inner {
    padding: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .cta-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(187, 32, 38, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cta-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--red);
    fill: none;
    stroke-width: 2;
  }
  .cta-text {
    flex: 1;
    min-width: 200px;
  }
  .cta-text h3 {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #2D2D2D;
    margin-bottom: 0.3rem;
  }
  .cta-text p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .btn-cta {
    display: inline-block;
    background: var(--red);
    color: #FFFFFF !important;
    padding: 0.95rem 2.2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.3s;
    box-shadow: 0 8px 20px rgba(187,32,38,0.25);
  }
  .btn-cta:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(187,32,38,0.35);
  }

  /* RELATED */
  .related-section {
    padding: 5rem 2rem;
    background: #FAF7FA;
  }
  .related-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .related-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 700;
    display: block;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .related-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #2D2D2D;
    text-align: center;
    margin-bottom: 3rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .related-card {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .related-card:hover {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 18px 40px rgba(175, 132, 172, 0.2);
  }
  .related-card-img {
    height: 180px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .related-card-cat {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--red);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 50px;
  }
  .related-card-body {
    padding: 1.5rem;
  }
  .related-meta {
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .related-card-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #2D2D2D;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .related-link {
    color: var(--red);
    font-weight: 600;
    font-size: 0.82rem;
  }
  .btn-back {
    display: inline-block;
    padding: 0.85rem 2rem;
    border: 2px solid var(--red);
    color: var(--red);
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: all 0.3s;
  }
  .btn-back:hover {
    background: var(--red);
    color: #FFFFFF !important;
  }

  @media (max-width: 960px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; text-align: center; }
    .btn-cta { width: 100%; text-align: center; }
  }
</style>
