---
import Layout from '../../layouts/Layout.astro';
import { getArticles } from '../../lib/strapi';
import type { Article } from '../../lib/strapi';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<Layout title={`${article.title} | Blog INFRASLIM`} description={article.excerpt} currentPath={`/blog/${article.slug}`}>
  <article class="article-page">
    <header class="article-header">
      <div class="container-sm">
        <div class="breadcrumb"><a href="/blog">&larr; Retour au Journal</a></div>
        <span class="cat-badge">{article.category}</span>
        <h1>{article.title}</h1>
        <div class="meta">{article.date} · {article.readTime} de lecture</div>
      </div>
    </header>

    <div class="container-sm">
      <img src={article.image} alt={article.title} class="featured-img" />
      <div class="article-content">
        <p class="lead">{article.excerpt}</p>
        <p>{article.content}</p>
      </div>

      <div class="article-cta">
        <h3>Envie d'essayer ce soin à Agdal ?</h3>
        <p>Nos expertes vous conseillent gratuitement lors d'un bilan InBody offert.</p>
        <a href="https://wa.me/212615109898?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous." target="_blank" rel="noopener" class="btn-cta">Prendre Rendez-vous sur WhatsApp</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-page { padding-bottom: 5rem; background: #FFFFFF; }
  .article-header {
    background: #F7F3F7; padding: 4.5rem 2rem 3rem; text-align: center;
    border-bottom: 1px solid rgba(175, 132, 172, 0.25); margin-bottom: 3rem;
  }
  .container-sm { max-width: 820px; margin: 0 auto; padding: 0 1.5rem; }
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb a { color: #BB2026; font-weight: 600; text-decoration: none; font-size: 0.9rem; }
  .cat-badge {
    display: inline-block; background: #BB2026; color: #FFFFFF; font-size: 0.72rem;
    font-weight: 600; padding: 0.3rem 0.9rem; border-radius: 50px; text-transform: uppercase; margin-bottom: 1rem;
  }
  .article-header h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.25; margin-bottom: 0.8rem; }
  .meta { font-size: 0.85rem; color: #6B636B; }

  .featured-img { width: 100%; height: 420px; object-fit: cover; border-radius: 8px; margin-bottom: 2.5rem; }
  .article-content { font-size: 1.02rem; line-height: 1.85; color: #333; }
  .article-content .lead { font-weight: 500; font-size: 1.12rem; color: #2D2D2D; margin-bottom: 1.5rem; }

  .article-cta {
    margin-top: 4rem; background: #F7F3F7; padding: 2.5rem; border-radius: 8px;
    border-left: 4px solid #BB2026; text-align: center;
  }
  .article-cta h3 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .article-cta p { font-size: 0.92rem; color: #6B636B; margin-bottom: 1.5rem; }
  .btn-cta {
    display: inline-block; background: #BB2026; color: #FFFFFF; padding: 0.85rem 2rem;
    border-radius: 50px; font-weight: 600; text-decoration: none; font-size: 0.88rem; text-transform: uppercase;
  }
</style>
