---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, type CategoryData } from '../../data/categories';
import { getGlobalSettings } from '../../lib/strapi';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { data: c },
  }));
}

interface Props {
  data: CategoryData;
}

const { data } = Astro.props;
const settings = await getGlobalSettings();
const waNumber = (settings.whatsapp || '212615109898').replace(/\D/g, '');
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(`Bonjour INFRASLIM, je souhaite réserver ou avoir des informations sur : ${data.name}`)}`;

const sectionPhotos: Record<string, string[]> = {
  'sport-nouvelle-generation': [
    'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg',
    'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-11.52.14-1.jpeg',
    'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.06.54.jpeg',
  ],
  'soins-amincissants': [
    'https://infraslim.ma/wp-content/uploads/2024/10/879A0428.jpg',
    'https://infraslim.ma/wp-content/uploads/2024/10/Sequence-04.00_00_33_01.Still001.jpg',
    'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-10-11-at-13.55.13.jpeg',
  ],
  'soins-visage': [
    'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-26-at-14.13.21-2-1.jpeg',
    'https://infraslim.ma/wp-content/uploads/2024/10/879A0532.jpg',
    'https://infraslim.ma/wp-content/uploads/2024/10/Sequence-04.00_00_25_19.Still003.jpg',
  ],
  'epilation-laser': [
    'https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=1000&q=85',
    'https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=1000&q=85',
  ],
  'hammam': [
    'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=1000&q=85',
    'https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=1000&q=85',
  ],
};

const photos = sectionPhotos[data.slug] || [data.heroImage];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout title={data.metaTitle} description={data.metaDescription} currentPath={`/services/${data.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============================================================
       1. HERO LUXE FULL-BLEED + PARALLAX + CTA
  ============================================================ -->
  <section class="srv-hero">
    <img src={data.heroImage} alt={data.h1} class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="srv-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; <a href="/services">Services</a> &nbsp;/&nbsp; <span>{data.name}</span>
      </div>
      <span class="hero-eyebrow">— {data.eyebrow}</span>
      <h1 class="hero-title">{data.h1}</h1>
      <p class="hero-desc">{data.leadIntro}</p>
      <div class="hero-actions">
        <a href="#reserver-pole" class="ht-btn-red">Prendre Rendez-vous →</a>
        <a href="#tarifs-pole" class="ht-btn-white">Voir les tarifs</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. BARRE FLOTTANTE DE RÉASSURANCE (CHEVAUCHANT LE HERO)
  ============================================================ -->
  <div class="floating-stats-bar">
    <div class="stats-card-white">
      <div class="sc-item">
        <div class="sc-num">100 %</div>
        <div class="sc-label">Espace Féminin</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">InBody</div>
        <div class="sc-label">Diagnostic Offert</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">Agdal</div>
        <div class="sc-label">Rabat · Parking 3 min</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">Lun–Sam</div>
        <div class="sc-label">08h00 – 20h00</div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       3. MARQUEE STRIP ANIMÉ
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>{data.name}</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100 % Femmes</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Diagnostic InBody Offert</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Packs Valables Toute l'Année</span><span class="sep"></span></div>
      <div class="marquee-item"><span>{data.name}</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100 % Femmes</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Diagnostic InBody Offert</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Packs Valables Toute l'Année</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       4. SECTIONS ALTERNÉES SECTION PAR SECTION (PRO & ANIMÉ)
  ============================================================ -->
  {data.sections.map((sec, idx) => {
    const isCream = idx % 2 === 1;
    const hasCards = Boolean(sec.bullets && sec.bullets.length > 0);
    const hasTable = Boolean(sec.table);
    const photoUrl = photos[idx % photos.length];
    const isReversed = idx % 2 === 1;

    return (
      <section class={`srv-sec ${isCream ? 'srv-sec-cream' : 'srv-sec-white'}`}>
        <div class="srv-container">
          {hasCards ? (
            <div class="reveal">
              <div class="sec-head-center">
                <span class="section-eyebrow">— 0{idx + 1} · {data.name.toUpperCase()}</span>
                <h2 class="section-title">{sec.h2}</h2>
                {sec.paragraphs.map((p) => <p class="sec-intro-p">{p}</p>)}
              </div>
              <div class={`pro-cards-grid stagger-cards ${sec.bullets!.length === 5 || sec.bullets!.length === 7 ? 'grid-balanced' : ''}`}>
                {sec.bullets!.map((b, bIdx) => (
                  <div class="pro-card">
                    <div class="pro-card-top">
                      <span class="pc-num">0{bIdx + 1}</span>
                      <a href={b.href || '#reserver-pole'} class="pc-arrow-btn">{b.href ? 'Découvrir →' : 'Réserver →'}</a>
                    </div>
                    <h3>{b.title}</h3>
                    <p>{b.desc}</p>
                    <a href={b.href || '#reserver-pole'} class="pc-footer-link">
                      {b.href ? 'Voir la fiche complète →' : 'Prendre rendez-vous →'}
                    </a>
                  </div>
                ))}
              </div>
            </div>
          ) : hasTable ? (
            <div class="reveal">
              <div class="sec-head-center">
                <span class="section-eyebrow">— 0{idx + 1} · GRILLE &amp; PROTOCOLES</span>
                <h2 class="section-title">{sec.h2}</h2>
              </div>
              <div class="pro-table-card">
                <table class="pro-table">
                  <thead>
                    <tr>
                      {sec.table!.headers.map((h) => <th>{h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {sec.table!.rows.map((row) => (
                      <tr>
                        {row.map((cell, cIdx) => (
                          <td class={cIdx === row.length - 1 ? 'price-cell' : ''}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <div class={`split-layout reveal ${isReversed ? 'reversed' : ''}`}>
              <div class="split-text">
                <span class="section-eyebrow">— 0{idx + 1} · APPROCHE INFRASLIM</span>
                <h2 class="section-title">{sec.h2}</h2>
                <div class="divider"></div>
                {sec.paragraphs.map((p) => <p class="split-p">{p}</p>)}
              </div>
              <div class="split-visual parallax-img">
                <div class="sv-frame img-wrap-zoom">
                  <img src={photoUrl} alt={sec.h2} />
                  <div class="sv-overlay"></div>
                </div>
                <div class="floating-chip luxury-float" style="bottom: 18px; left: 18px;">
                  Centre 100 % Femmes · Agdal
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <!-- ============================================================
       5. TARIFS DU PÔLE + DIAGNOSTIC INBODY CALLOUT
  ============================================================ -->
  <section id="tarifs-pole" class="srv-sec srv-sec-cream">
    <div class="srv-container">
      <div class="sec-head-center reveal">
        <span class="section-eyebrow">— TRANSPARENCE 2026</span>
        <h2 class="section-title">Prestations &amp; Tarifs · {data.name}</h2>
      </div>

      <div class="pro-pricing-grid stagger-cards">
        {data.prestationsList.map((p) => (
          <div class="pp-card">
            <div class="pp-top">
              {p.href ? (
                <a href={p.href} class="pp-title-link">{p.name}</a>
              ) : (
                <span class="pp-title">{p.name}</span>
              )}
              {p.price && <span class="pp-price">{p.price}</span>}
            </div>
            <div class="pp-footer">
              <a href={p.href || '#reserver-pole'} class="pp-btn">
                {p.href ? 'Voir les détails →' : 'Réserver cette séance →'}
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- InBody Banner -->
      <div class="inbody-callout-card reveal">
        <div class="inbody-card-photo img-wrap-zoom">
          <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=800&q=85" alt="Diagnostic InBody INFRASLIM" />
          <div class="icp-badge">Offert &amp; Sans Engagement</div>
        </div>
        <div class="inbody-card-content">
          <span class="inbody-badge">DIAGNOSTIC CORPOREL</span>
          <h3 class="inbody-title">Votre diagnostic InBody est offert avant tout programme</h3>
          <p class="inbody-desc">{data.ctaText} Réalisé par Ghizlane au centre d'Agdal : masse grasse, masse musculaire et rétention d'eau mesurées en moins d'une minute.</p>
          <a href={waLink} target="_blank" rel="noopener" class="btn-inbody-rdv">Réserver mon diagnostic →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. FAQ ACCORDÉON SECTION
  ============================================================ -->
  <section class="srv-sec srv-sec-white">
    <div class="srv-container" style="max-width: 920px;">
      <div class="sec-head-center reveal">
        <span class="section-eyebrow">— QUESTIONS FRÉQUENTES</span>
        <h2 class="section-title">Tout savoir sur : {data.name}</h2>
      </div>

      <div class="faq-list reveal">
        {data.faq.map((item, idx) => (
          <div class={`faq-item ${idx === 0 ? 'open' : ''}`}>
            <button type="button" class="faq-question">
              <span class="faq-q-text">{item.q}</span>
              <span class="faq-icon">
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </button>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="related-links reveal">
        <h4>Explorer les autres univers</h4>
        <div class="related-pills">
          {data.related.map((r) => (
            <a href={r.href} class="related-pill">{r.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       7. SECTION RÉSERVATION & CONVERSION MAUVE LUXE
  ============================================================ -->
  <section id="reserver-pole" class="srv-cta-band">
    <div class="srv-container">
      <div class="cta-split reveal">
        <div class="cta-split-text">
          <span class="section-eyebrow" style="color: rgba(255,255,255,0.85);">— PRENDRE RENDEZ-VOUS</span>
          <h2 class="cta-title">Réservez votre séance : {data.name}</h2>
          <p class="cta-desc">{data.ctaText} Du lundi au samedi, de 08h00 à 20h00 au 43 Rue Oum Rabiâ, Agdal, Rabat.</p>
          <div class="cta-perks">
            <span>✓ Réponse rapide sur WhatsApp</span>
            <span>✓ Centre 100 % femmes</span>
            <span>✓ Parking Kaïs à 3 min</span>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="btn-wa-direct-lg">
            Écrire sur WhatsApp (06 15 10 98 98) →
          </a>
        </div>

        <div class="cta-form-glass">
          <h3>Demande de créneau</h3>
          <form id="serviceRdvForm" class="sticky-rdv-form">
            <input type="hidden" id="srv-name" value={data.name} />
            <div class="s-field">
              <label for="srv-nom">Nom &amp; Prénom</label>
              <input type="text" id="srv-nom" placeholder="Votre nom complet" required />
            </div>
            <div class="s-field">
              <label for="srv-tel">Téléphone (WhatsApp)</label>
              <input type="tel" id="srv-tel" placeholder="06 00 00 00 00" required />
            </div>
            <div class="s-field">
              <label for="srv-slot">Moment préféré</label>
              <select id="srv-slot">
                <option value="Peu importe">Peu importe</option>
                <option value="Matin (08h-12h)">Matin (08h-12h)</option>
                <option value="Après-midi (12h-17h)">Après-midi (12h-17h)</option>
                <option value="Fin de journée (17h-20h)">Fin de journée (17h-20h)</option>
              </select>
            </div>
            <button type="submit" class="btn-rdv-submit">Confirmer sur WhatsApp →</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('serviceRdvForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const srv = (document.getElementById('srv-name') as HTMLInputElement)?.value || '';
    const nom = (document.getElementById('srv-nom') as HTMLInputElement)?.value || '';
    const tel = (document.getElementById('srv-tel') as HTMLInputElement)?.value || '';
    const slot = (document.getElementById('srv-slot') as HTMLSelectElement)?.value || '';
    const msg = `Bonjour INFRASLIM,\nJe souhaite réserver : ${srv}\nNom : ${nom}\nTéléphone : ${tel}\nCréneau : ${slot}`;
    window.open(`https://wa.me/212615109898?text=${encodeURIComponent(msg)}`, '_blank');
  });

  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      item?.classList.toggle('open');
    });
  });
</script>

<style>
  .srv-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5.5rem 2rem 7.5rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .srv-hero-inner { max-width: 920px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb { font-size: 0.78rem; color: rgba(255,255,255,0.75); margin-bottom: 1.25rem; }
  .breadcrumb a { color: rgba(255,255,255,0.88); text-decoration: none; }
  .breadcrumb a:hover { color: #FFFFFF; text-decoration: underline; }
  .hero-eyebrow { display: block; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: #DEC9DD; margin-bottom: 1rem; font-weight: 600; }
  .hero-title { font-family: 'Josefin Sans', sans-serif; font-size: clamp(2.2rem, 4.8vw, 3.8rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem; color: #FFFFFF; }
  .hero-desc { font-size: 1.02rem; color: rgba(255,255,255,0.92); max-width: 760px; margin: 0 auto 2.2rem; line-height: 1.75; font-weight: 300; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .ht-btn-red { background: #BB2026; color: #FFFFFF !important; padding: 0.9rem 2rem; border-radius: 30px; font-size: 0.84rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: all 0.25s; box-shadow: 0 8px 22px rgba(187,32,38,0.35); }
  .ht-btn-red:hover { background: #8f1a1f; transform: translateY(-2px); }
  .ht-btn-white { background: rgba(255,255,255,0.16); color: #FFFFFF !important; border: 1.5px solid rgba(255,255,255,0.5); padding: 0.9rem 2rem; border-radius: 30px; font-size: 0.84rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; backdrop-filter: blur(6px); transition: all 0.25s; }
  .ht-btn-white:hover { background: #FFFFFF; color: #4A284B !important; }

  /* Floating stats bar */
  .floating-stats-bar { max-width: 1120px; margin: -3.2rem auto 0; padding: 0 1.5rem; position: relative; z-index: 10; }
  .stats-card-white { background: #FFFFFF; border-radius: 14px; padding: 1.8rem 2rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; box-shadow: 0 18px 45px rgba(51,21,53,0.12); border: 1px solid rgba(175,132,172,0.22); text-align: center; }
  .sc-item { border-right: 1px solid rgba(175,132,172,0.2); }
  .sc-item:last-child { border-right: none; }
  .sc-num { font-family: 'Josefin Sans', sans-serif; font-size: 1.75rem; font-weight: 700; color: #BB2026; line-height: 1.1; margin-bottom: 0.3rem; }
  .sc-label { font-size: 0.78rem; color: #6B636B; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

  /* Alternating sections */
  .srv-sec { padding: 5rem 2rem; }
  .srv-sec-white { background: #FFFFFF; }
  .srv-sec-cream { background: #F7F3F7; }
  .srv-container { max-width: 1200px; margin: 0 auto; }

  .sec-head-center { text-align: center; max-width: 780px; margin: 0 auto 3rem; }
  .section-eyebrow { display: inline-block; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #BB2026; font-weight: 700; margin-bottom: 0.65rem; }
  .section-title { font-family: 'Josefin Sans', sans-serif; font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 700; color: #2D2D2D; line-height: 1.2; margin-bottom: 0.9rem; }
  .sec-intro-p { font-size: 0.98rem; color: #555; line-height: 1.75; }

  /* Split Layout */
  .split-layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
  .split-layout.reversed .split-text { order: 2; }
  .split-layout.reversed .split-visual { order: 1; }
  .divider { width: 56px; height: 3px; background: #BB2026; margin: 1.1rem 0 1.5rem; }
  .split-p { font-size: 0.98rem; color: #4A4A4A; line-height: 1.85; margin-bottom: 1.1rem; }

  .split-visual { position: relative; height: 420px; }
  .sv-frame { width: 100%; height: 100%; border-radius: 16px; overflow: hidden; box-shadow: 0 22px 50px rgba(51,21,53,0.16); position: relative; }
  .sv-frame img { width: 100%; height: 100%; object-fit: cover; }
  .sv-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(51,21,53,0.45) 100%); pointer-events: none; }

  /* Pro Cards Grid */
  .pro-cards-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; }
  .pro-card { flex: 0 1 320px; width: 320px; max-width: 360px; box-sizing: border-box; background: #FFFFFF; border: 1px solid rgba(175,132,172,0.25); border-top: 4px solid #BB2026; border-radius: 14px; padding: 2rem; box-shadow: 0 10px 28px rgba(51,21,53,0.05); display: flex; flex-direction: column; transition: transform 0.35s ease, box-shadow 0.35s ease; }
  .pro-card:hover { transform: translateY(-6px); box-shadow: 0 20px 42px rgba(51,21,53,0.12); }
  .pro-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .pc-num { font-family: 'Josefin Sans', sans-serif; font-size: 1.35rem; font-weight: 700; color: #BB2026; background: #FAF7FA; width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(187,32,38,0.2); }
  .pc-arrow-btn { font-size: 0.78rem; font-weight: 700; color: #BB2026; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; }
  .pro-card h3 { font-family: 'Josefin Sans', sans-serif; font-size: 1.35rem; font-weight: 700; color: #2D2D2D; margin-bottom: 0.65rem; min-height: 2.55em; line-height: 1.28; }
  .pro-card p { font-size: 0.92rem; color: #555; line-height: 1.7; flex: 1; margin: 0; }
  .pc-footer-link { margin-top: 1.25rem; display: inline-block; font-size: 0.84rem; font-weight: 700; color: #BB2026; text-decoration: none; }
  .pc-footer-link:hover { text-decoration: underline; }

  /* Pro Table */
  .pro-table-card { background: #FFFFFF; border-radius: 16px; border: 1px solid rgba(175,132,172,0.25); overflow-x: auto; box-shadow: 0 12px 35px rgba(51,21,53,0.06); }
  .pro-table { width: 100%; border-collapse: collapse; text-align: left; }
  .pro-table th { background: #FAF7FA; padding: 1.15rem 1.8rem; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.12em; color: #6B636B; border-bottom: 1px solid rgba(175,132,172,0.2); }
  .pro-table td { padding: 1.15rem 1.8rem; border-bottom: 1px solid rgba(175,132,172,0.12); font-size: 0.94rem; color: #2D2D2D; }
  .pro-table tr:last-child td { border-bottom: none; }
  .pro-table .price-cell { font-weight: 700; color: #BB2026; white-space: nowrap; }

  /* Pricing Showcase Cards */
  .pro-pricing-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.4rem; margin-bottom: 3rem; }
