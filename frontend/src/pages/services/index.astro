---
import Layout from '../../layouts/Layout.astro';
import { getGlobalSettings } from '../../lib/strapi';

const settings = await getGlobalSettings();
const waNumber = (settings.whatsapp || '212615109898').replace(/\D/g, '');
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent('Bonjour INFRASLIM, je souhaite réserver un bilan InBody offert.')}`;

const universes = [
  {
    num: '01 · Effort & Infrarouge',
    badge: 'Pôle Sportif',
    title: 'Sport Nouvelle Génération',
    desc: "Brûlez jusqu'à 1300 calories en seulement 30 minutes. L'alliance unique du cardio training et de la chaleur infrarouge pénètre en profondeur pour activer le déstockage des graisses, drainer et booster l'énergie sans agresser les articulations.",
    img: 'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg',
    alt: 'Sport Infrarouge INFRASLIM Rabat',
    chip: 'Jusqu\'à 1300 kcal · 30 min',
    pills: [
      { label: 'InfraBike Allongé', href: '/services/sport-nouvelle-generation/infrabike' },
      { label: 'Tapis Roulant Infrarouge', href: '/services/sport-nouvelle-generation/tapis-roulant-infrarouge' },
      { label: 'Infra Roller Massage', href: '/services/sport-nouvelle-generation/infra-roller' },
      { label: 'Renforcement Musculaire', href: '/services/sport-nouvelle-generation' }
    ],
    href: '/services/sport-nouvelle-generation',
    cta: 'Découvrir le Pôle Sport →'
  },
  {
    num: '02 · Remodelage & Drainage',
    badge: 'Pôle Minceur',
    title: 'Soins Amincissants',
    desc: 'Dites adieu aux capitons et à la rétention d\'eau. Nos praticiennes certifiées combinent des technologies de remodelage de référence (VelaShape, radiofréquence, ultrasons) à des soins manuels experts pour cibler chaque zone rebelle.',
    img: 'https://infraslim.ma/wp-content/uploads/2024/10/879A0428.jpg',
    alt: 'Soins Amincissants INFRASLIM Rabat',
    chip: 'Remodelage & Anti-Cellulite',
    pills: [
      { label: 'VelaShape Anti-Cellulite', href: '/services/soins-amincissants/velashape' },
      { label: 'Madérothérapie Sculptante', href: '/services/soins-amincissants/maderotherapie' },
      { label: 'Drainage Lymphatique Renata', href: '/services/soins-amincissants/drainage-lymphatique' },
      { label: 'Pressothérapie & Sauna Dôme', href: '/services/soins-amincissants/pressotherapie' }
    ],
    href: '/services/soins-amincissants',
    cta: 'Découvrir les Soins Minceur →'
  },
  {
    num: '03 · Pureté & Anti-Âge',
    badge: 'Pôle Esthétique Visage',
    title: 'Soins du Visage',
    desc: 'Une peau éclatante, purifiée en profondeur et visiblement repulpée dès la première séance. Protocoles médico-esthétiques rigoureux et massages ancestraux liftants pour réveiller le glow naturel de votre teint.',
    img: 'https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-26-at-14.13.21-2-1.jpeg',
    alt: 'Soins du Visage INFRASLIM Rabat',
    chip: 'Éclat & Lifting Naturel',
    pills: [
      { label: 'Hydrafacial Deluxe', href: '/services/soins-visage/hydrafacial' },
      { label: 'Carbon Peel Laser Hollywood', href: '/services/soins-visage/carbon-peel' },
      { label: 'Massage Kobido Liftant', href: '/services/soins-visage/kobido' },
      { label: 'Microneedling', href: '/services/soins-visage/microneedling' },
      { label: 'Soin Anti-Âge', href: '/services/soins-visage/soin-anti-age' },
      { label: 'Soin Anti-Acné', href: '/services/soins-visage/soin-anti-acne' }
    ],
    href: '/services/soins-visage',
    cta: 'Découvrir les Soins Visage →'
  },
  {
    num: '04 · Netteté & Confort Durable',
    badge: 'Pôle Laser',
    title: 'Épilation & Laser',
    desc: "Débarrassez-vous définitivement de la corvée de l'épilation. Notre laser diode de dernière génération avec système de refroidissement intégré garantit des séances rapides, confortables et sécurisées sur tous les phototypes de peau.",
    img: 'https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=1200&q=80',
    alt: 'Épilation Laser Diode Rabat INFRASLIM',
    chip: 'Tous Phototypes · Confort Optimal',
    pills: [
      { label: 'Épilation Laser Diode', href: '/services/epilation-laser/epilation-laser-diode' },
      { label: 'Détatouage Laser', href: '/services/epilation-laser/detatouage-laser' },
      { label: 'Épilation à la Cire Douce', href: '/services/epilation-laser' }
    ],
    href: '/services/epilation-laser',
    cta: "Découvrir l'Épilation Laser →"
  },
  {
    num: '05 · Rituels Ancestraux',
    badge: 'Pôle Bien-Être Beldi',
    title: 'Hammam Traditionnel',
    desc: "Un havre de paix 100 % féminin inspiré des plus grands rituels du hammam marocain. Vapeur bienfaisante, savon noir beldi aux huiles essentielles, gommage méticuleux au gant Kessa et enveloppement purifiant au ghassoul de l'Atlas.",
    img: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=1200&q=80',
    alt: 'Hammam Traditionnel INFRASLIM Rabat',
    chip: 'Hammam Infraslim 150 DH · Royal 250 DH',
    pills: [
      { label: 'Savon Noir & Eucalyptus', href: '/services/hammam' },
      { label: 'Gommage Kessa Traditionnel', href: '/services/hammam' },
      { label: 'Enveloppement Ghassoul Royal', href: '/services/hammam' },
      { label: 'Formules & Tarifs Hammam', href: '/hammam' }
    ],
    href: '/services/hammam',
    cta: 'Découvrir le Hammam →'
  }
];
---

<Layout title="Nos services à Rabat : minceur, visage, épilation | INFRASLIM" description="Sport infrarouge, soins amincissants, soins du visage, épilation laser et hammam à Agdal, Rabat. Centre 100 % femmes, diagnostic offert." currentPath="/services">

  <!-- ============================================================
       1. HERO SERVICES FULL-BLEED + PARALLAX
  ============================================================ -->
  <section class="srv-hero">
    <img src="https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg" alt="Nos Pôles de Soins INFRASLIM Agdal" class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="srv-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; <span>Nos Services</span>
      </div>
      <span class="hero-eyebrow">— CINQ UNIVERS · UN SEUL LIEU · ON MESURE AVANT DE PROPOSER</span>
      <h1 class="hero-title">Nos services d'amincissement et de beauté à Rabat</h1>
      <p class="hero-desc">
        INFRASLIM réunit à Agdal le sport nouvelle génération, les soins amincissants, les soins du visage, l'épilation au laser et le hammam. Chaque prestation peut se prendre seule, mais c'est leur combinaison qui donne les meilleurs résultats sur un parcours minceur.
      </p>
      <div class="hero-actions">
        <a href="#reserver-bilan" class="ht-btn-red">Réserver mon bilan offert →</a>
        <a href="/tarifs" class="ht-btn-white">Consulter les tarifs</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. BARRE FLOTTANTE D'ENGAGEMENTS (CHEVAUCHANT LE HERO)
  ============================================================ -->
  <div class="floating-stats-bar">
    <div class="stats-card-white">
      <div class="sc-item">
        <div class="sc-num">100 %</div>
        <div class="sc-label">Espace Femmes</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">InBody</div>
        <div class="sc-label">Diagnostic Offert</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">5 Pôles</div>
        <div class="sc-label">Beauté &amp; Minceur</div>
      </div>
      <div class="sc-item">
        <div class="sc-num">Agdal</div>
        <div class="sc-label">Rabat · Lun–Sam</div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       3. MARQUEE STRIP ANIMÉ
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Sport Infrarouge</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Soins Amincissants</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Soins du Visage</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Épilation Laser Diode</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam Traditionnel</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Sport Infrarouge</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Soins Amincissants</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Soins du Visage</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Épilation Laser Diode</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Hammam Traditionnel</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       4. INTRO DIAGNOSTIC INBODY (SECTION BLANCHE)
  ============================================================ -->
  <section class="srv-sec srv-sec-white" style="padding-bottom: 3.5rem;">
    <div class="srv-container">
      <div class="sec-head-center reveal" style="margin-bottom: 0;">
        <span class="section-eyebrow">— PAR OÙ COMMENCER ?</span>
        <h2 class="section-title">Par le diagnostic InBody, qui est offert</h2>
        <p class="sec-intro-p">
          Il mesure votre masse grasse, votre masse musculaire et votre eau corporelle, zone par zone. Un ventre qui gonfle en fin de journée relève de la rétention d'eau, pas de la graisse : sans mesure, on se trompe une fois sur deux.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. LES 5 UNIVERS EN SECTIONS ALTERNÉES (PRO & ANIMÉ)
  ============================================================ -->
  {universes.map((u, idx) => {
    const isCream = idx % 2 === 0;
    const isReversed = idx % 2 === 1;
    return (
      <section class={`srv-sec ${isCream ? 'srv-sec-cream' : 'srv-sec-white'}`}>
        <div class="srv-container">
          <div class={`split-layout reveal ${isReversed ? 'reversed' : ''}`}>
            <div class="split-text">
              <span class="section-eyebrow">— {u.num.toUpperCase()}</span>
              <h2 class="section-title">{u.title}</h2>
              <div class="divider"></div>
              <p class="split-p">{u.desc}</p>

              <div class="hub-pills-wrap">
                {u.pills.map((pill) => (
                  <a href={pill.href} class="hub-pill">{pill.label}</a>
                ))}
              </div>

              <div class="hub-actions">
                <a href={u.href} class="btn-hub-primary">{u.cta}</a>
                <a href="/tarifs" class="btn-hub-link">Consulter les tarifs</a>
              </div>
            </div>

            <div class="split-visual parallax-img">
              <div class="sv-frame img-wrap-zoom">
                <img src={u.img} alt={u.alt} />
                <div class="sv-overlay"></div>
                <span class="hub-badge-top">{u.badge}</span>
              </div>
              <div class="floating-chip luxury-float" style="bottom: 18px; left: 18px;">
                {u.chip}
              </div>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- ============================================================
       6. SECTION RÉSERVATION & CONVERSION MAUVE LUXE
  ============================================================ -->
  <section id="reserver-bilan" class="srv-cta-band">
    <div class="srv-container">
      <div class="cta-split reveal">
        <div class="cta-split-text">
          <span class="section-eyebrow" style="color: rgba(255,255,255,0.85);">— DIAGNOSTIC PERSONNALISÉ</span>
          <h2 class="cta-title">Vous hésitez entre plusieurs soins ?</h2>
          <p class="cta-desc">
            Nos expertes vous reçoivent dans notre centre d'Agdal pour un diagnostic corporel complet offert (bilan InBody + étude de vos besoins). Nous construirons ensemble la cure adaptée à votre métabolisme et vos disponibilités.
          </p>
          <div class="cta-perks">
            <span>✓ Mesure masse grasse &amp; rétention d'eau</span>
            <span>✓ Recommandation transparente</span>
            <span>✓ Sans engagement obligatoire</span>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="btn-wa-direct-lg">
            Écrire sur WhatsApp (06 15 10 98 98) →
          </a>
        </div>

        <div class="cta-form-glass">
          <h3>Réserver mon Bilan Gratuit</h3>
          <form id="servicesConsultationForm" class="sticky-rdv-form">
            <div class="s-field">
              <label for="sf-nom">Nom &amp; Prénom *</label>
              <input type="text" id="sf-nom" placeholder="Votre nom complet" required />
            </div>
            <div class="s-field">
              <label for="sf-tel">Téléphone (WhatsApp) *</label>
              <input type="tel" id="sf-tel" placeholder="06 12 34 56 78" required />
            </div>
            <div class="s-field">
              <label for="sf-service">Pôle de soin principal *</label>
              <select id="sf-service" required>
                <option value="" disabled selected>Sélectionnez un univers</option>
                <option value="Bilan Global Offert (InBody)">Bilan InBody Global Offert (Gratuit)</option>
                <option value="Sport Infrarouge (InfraBike/Tapis)">Sport Nouvelle Génération</option>
                <option value="Soins Amincissants (VelaShape/Drainage)">Soins Amincissants</option>
                <option value="Soins du Visage (Hydrafacial/Kobido)">Soins du Visage</option>
                <option value="Épilation Laser Diode">Épilation Laser Diode</option>
                <option value="Hammam Traditionnel">Hammam Traditionnel</option>
              </select>
            </div>
            <div class="s-field">
              <label for="sf-message">Vos objectifs ou disponibilités</label>
              <textarea id="sf-message" rows="2" placeholder="Ex: Perte de centimètres au niveau de la taille, disponible le matin..."></textarea>
            </div>
            <button type="submit" class="btn-rdv-submit">Valider ma demande de rendez-vous →</button>
            <div id="servicesFormSuccessMsg" class="form-success-msg">
              Merci ! Votre demande a été préparée sur WhatsApp.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('servicesConsultationForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const nom = (document.getElementById('sf-nom') as HTMLInputElement)?.value.trim() || '';
      const tel = (document.getElementById('sf-tel') as HTMLInputElement)?.value.trim() || '';
      const service = (document.getElementById('sf-service') as HTMLSelectElement)?.value || '';
      const msg = (document.getElementById('sf-message') as HTMLTextAreaElement)?.value.trim() || '';

      const successMsg = document.getElementById('servicesFormSuccessMsg');
      if (successMsg) successMsg.style.display = 'block';

      const waText = encodeURIComponent('Bonjour INFRASLIM, je souhaite réserver un bilan pour le pôle : ' + service + ' | Nom : ' + nom + ' | Téléphone : ' + tel + (msg ? ' | Note : ' + msg : ''));
      window.open('https://wa.me/212615109898?text=' + waText, '_blank');
      (form as HTMLFormElement).reset();
    });
  }
</script>

<style>
  .srv-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5.5rem 2rem 7.5rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .srv-hero-inner { max-width: 920px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb { font-size: 0.78rem; color: rgba(255,255,255,0.75); margin-bottom: 1.25rem; }
  .breadcrumb a { color: rgba(255,255,255,0.88); text-decoration: none; }
  .breadcrumb a:hover { color: #FFFFFF; text-decoration: underline; }
  .hero-eyebrow { display: block; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: #DEC9DD; margin-bottom: 1rem; font-weight: 600; }
  .hero-title { font-family: 'Josefin Sans', sans-serif; font-size: clamp(2.2rem, 4.8vw, 3.8rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem; color: #FFFFFF; }
  .hero-desc { font-size: 1.02rem; color: rgba(255,255,255,0.92); max-width: 760px; margin: 0 auto 2.2rem; line-height: 1.75; font-weight: 300; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .ht-btn-red { background: #BB2026; color: #FFFFFF !important; padding: 0.9rem 2rem; border-radius: 30px; font-size: 0.84rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: all 0.25s; box-shadow: 0 8px 22px rgba(187,32,38,0.35); }
  .ht-btn-red:hover { background: #8f1a1f; transform: translateY(-2px); }
  .ht-btn-white { background: rgba(255,255,255,0.16); color: #FFFFFF !important; border: 1.5px solid rgba(255,255,255,0.5); padding: 0.9rem 2rem; border-radius: 30px; font-size: 0.84rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; backdrop-filter: blur(6px); transition: all 0.25s; }
  .ht-btn-white:hover { background: #FFFFFF; color: #4A284B !important; }

  .floating-stats-bar { max-width: 1120px; margin: -3.2rem auto 0; padding: 0 1.5rem; position: relative; z-index: 10; }
  .stats-card-white { background: #FFFFFF; border-radius: 14px; padding: 1.8rem 2rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; box-shadow: 0 18px 45px rgba(51,21,53,0.12); border: 1px solid rgba(175,132,172,0.22); text-align: center; }
  .sc-item { border-right: 1px solid rgba(175,132,172,0.2); }
  .sc-item:last-child { border-right: none; }
  .sc-num { font-family: 'Josefin Sans', sans-serif; font-size: 1.75rem; font-weight: 700; color: #BB2026; line-height: 1.1; margin-bottom: 0.3rem; }
  .sc-label { font-size: 0.78rem; color: #6B636B; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

  .srv-sec { padding: 5rem 2rem; }
  .srv-sec-white { background: #FFFFFF; }
  .srv-sec-cream { background: #F7F3F7; }
  .srv-container { max-width: 1200px; margin: 0 auto; }

  .sec-head-center { text-align: center; max-width: 780px; margin: 0 auto 3rem; }
  .section-eyebrow { display: inline-block; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #BB2026; font-weight: 700; margin-bottom: 0.65rem; }
  .section-title { font-family: 'Josefin Sans', sans-serif; font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 700; color: #2D2D2D; line-height: 1.2; margin-bottom: 0.9rem; }
  .sec-intro-p { font-size: 0.98rem; color: #555; line-height: 1.75; }

  .split-layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
  .split-layout.reversed .split-text { order: 2; }
  .split-layout.reversed .split-visual { order: 1; }
  .divider { width: 56px; height: 3px; background: #BB2026; margin: 1.1rem 0 1.5rem; }
  .split-p { font-size: 0.98rem; color: #4A4A4A; line-height: 1.85; margin-bottom: 1.5rem; }

  .hub-pills-wrap { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 2rem; }
  .hub-pill { background: rgba(175, 132, 172, 0.12); color: #331535; border: 1px solid rgba(175, 132, 172, 0.3); font-size: 0.82rem; font-weight: 600; padding: 0.42rem 0.95rem; border-radius: 25px; text-decoration: none; transition: all 0.2s ease; }
  .hub-pill:hover { background: #BB2026; color: #FFFFFF; border-color: #BB2026; transform: translateY(-2px); }

  .hub-actions { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .btn-hub-primary { background: #BB2026; color: #FFFFFF !important; padding: 0.88rem 1.85rem; border-radius: 30px; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; box-shadow: 0 8px 20px rgba(187,32,38,0.25); transition: all 0.25s; }
  .btn-hub-primary:hover { background: #8f1a1f; transform: translateY(-2px); }
  .btn-hub-link { font-size: 0.88rem; font-weight: 700; color: #4A284B; border-bottom: 1.5px solid #AF84AC; padding-bottom: 2px; text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .btn-hub-link:hover { color: #BB2026; border-color: #BB2026; }

  .split-visual { position: relative; height: 440px; }
  .sv-frame { width: 100%; height: 100%; border-radius: 16px; overflow: hidden; box-shadow: 0 22px 50px rgba(51,21,53,0.16); position: relative; }
  .sv-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .sv-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(51,21,53,0.45) 100%); pointer-events: none; }
  .hub-badge-top { position: absolute; top: 18px; left: 18px; background: rgba(255,255,255,0.94); color: #4A284B; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.35rem 0.9rem; border-radius: 4px; z-index: 4; }

  .srv-cta-band { background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%); color: #FFFFFF; padding: 5.5rem 2rem; }
  .cta-split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center; }
  .cta-title { font-family: 'Josefin Sans', sans-serif; font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 700; color: #FFFFFF; margin-bottom: 1rem; line-height: 1.18; }
  .cta-desc { font-size: 1rem; color: rgba(255,255,255,0.92); line-height: 1.75; margin-bottom: 1.5rem; }
  .cta-perks { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; font-size: 0.86rem; font-weight: 600; color: #FFFFFF; }
  .btn-wa-direct-lg { display: inline-block; background: #25D366; color: #FFFFFF !important; padding: 1rem 2.2rem; border-radius: 40px; font-size: 0.9rem; font-weight: 700; text-decoration: none; box-shadow: 0 10px 25px rgba(0,0,0,0.22); transition: all 0.25s; }
  .btn-wa-direct-lg:hover { background: #1eb954; transform: translateY(-2px); }

