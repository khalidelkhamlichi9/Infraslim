---
import Layout from '../layouts/Layout.astro';
import { getGlobalSettings } from '../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Contact & Rendez-vous | INFRASLIM — Centre Beauté Agdal Rabat" currentPath="/contact">

  <!-- ============================================================
       HERO CONTACT (STYLE CLAIR / MAUVE DÉGRADÉ)
  ============================================================ -->
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; Contact
      </div>
      <div class="hero-eyebrow">— LUN–SAM 08H–20H · AGDAL, RABAT</div>
      <h1 class="hero-title">Prendre <em>Rendez-vous</em></h1>
      <p class="hero-desc">Notre équipe est à votre écoute du lundi au samedi de 08h00 à 20h00, exclusivement sur rendez-vous. Contactez-nous par WhatsApp pour une prise en charge rapide.</p>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE STRIP
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Sur Rendez-vous</span><span class="sep"></span></div>
      <div class="marquee-item"><span>WhatsApp : 06 15 10 98 98</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Lun–Sam 08h–20h</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Réponse Rapide</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Sur Rendez-vous</span><span class="sep"></span></div>
      <div class="marquee-item"><span>WhatsApp : 06 15 10 98 98</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Lun–Sam 08h–20h</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Réponse Rapide</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       CARTES CONTACT (3 MODES)
  ============================================================ -->
  <section class="section">
    <div class="container">
      <div class="reveal" style="margin-bottom:2.5rem; text-align:center;">
        <span class="section-label">Prendre contact</span>
        <h2 class="section-title">Comment nous joindre</h2>
        <p class="section-text" style="margin:0 auto;">Choisissez le mode de contact qui vous convient le mieux. La prise de rendez-vous s'effectue simplement par WhatsApp ou téléphone.</p>
      </div>

      <div class="contact-cards reveal">
        <div class="cc">
          <div class="cc-icon">💬</div>
          <div class="cc-title">WhatsApp</div>
          <p class="cc-desc">La façon la plus rapide et privilégiée de nous joindre. Réponse garantie dans la journée.</p>
          <div class="cc-info">06 15 10 98 98</div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous.`} target="_blank" rel="noopener" class="cc-btn wa">Écrire sur WhatsApp</a>
        </div>
        <div class="cc">
          <div class="cc-icon">📞</div>
          <div class="cc-title">Téléphone</div>
          <p class="cc-desc">Appelez directement nos praticiennes pendant nos horaires d'ouverture.</p>
          <div class="cc-info">06 15 10 98 98</div>
          <a href="tel:+212615109898" class="cc-btn">Appeler maintenant</a>
        </div>
        <div class="cc">
          <div class="cc-icon">📍</div>
          <div class="cc-title">Adresse</div>
          <p class="cc-desc">Venez nous rendre visite dans notre écrin bienveillant à Agdal, Rabat.</p>
          <div class="cc-info">43 Rue Oum Rabiâ, Appt. N°2, Agdal</div>
          <a href="https://maps.google.com/?q=43+Rue+Oum+Rabia,+Agdal,+Rabat,+Maroc" target="_blank" rel="noopener" class="cc-btn">Voir sur la carte</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HORAIRES & INFOS PRATIQUES (2 COLONNES)
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="hours-section reveal">
        <!-- Horaires d'ouverture -->
        <div class="hours-visual">
          <div class="hv-title">Horaires d'ouverture</div>
          <div class="hour-row"><span class="hour-day">Lundi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Mardi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Mercredi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Jeudi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Vendredi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Samedi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row closed"><span class="hour-day">Dimanche</span><span class="hour-time">Fermé</span></div>
        </div>

        <!-- Informations pratiques -->
        <div class="hours-info">
          <div class="hi-title">Informations pratiques</div>
          <div class="hi-item">
            <div class="hi-icon">📅</div>
            <div>
              <div class="hi-label">Réservation</div>
              <div class="hi-value">Sur rendez-vous uniquement, par WhatsApp ou téléphone. Accueil personnalisé sans attente.</div>
            </div>
          </div>
          <div class="hi-item">
            <div class="hi-icon">🏠</div>
            <div>
              <div class="hi-label">Accès &amp; Parking</div>
              <div class="hi-value">43 Rue Oum Rabiâ, Appt. N°2, Agdal, Rabat. Parking public Kaïs accessible à 240m (2 min à pied).</div>
            </div>
          </div>
          <div class="hi-item">
            <div class="hi-icon">🔒</div>
            <div>
              <div class="hi-label">Confidentialité &amp; Pudeur</div>
              <div class="hi-value">Espace 100% féminin. Seul le personnel féminin qualifié est présent dans l'établissement.</div>
            </div>
          </div>
          <div class="info-box">
            <div class="ib-icon">ℹ️</div>
            <div class="ib-text"><strong>INFRASLIM est un centre exclusivement féminin.</strong> Votre intimité, votre confort et votre bien-être sont au cœur de nos engagements.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FORMULAIRE DE CONTACT AVEC REDIRECTION WHATSAPP
  ============================================================ -->
  <section class="section" style="background:#FFFFFF;">
    <div class="container" style="max-width:860px;">
      <div class="in-form-card reveal">
        <div class="find-us-eyebrow">— FORMULAIRE —</div>
        <h3>Écrivez-nous</h3>
        <p class="in-form-sub">Laissez-nous un message, notre équipe vous rappelle ou vous répond par WhatsApp.</p>
        
        <form id="pageContactForm">
          <div class="in-form-row">
            <div class="in-field">
              <label for="pc-name">Nom et prénom *</label>
              <input type="text" id="pc-name" name="name" placeholder="Votre nom et prénom" required />
            </div>
            <div class="in-field">
              <label for="pc-phone">Téléphone (WhatsApp) *</label>
              <input type="tel" id="pc-phone" name="phone" placeholder="06 00 00 00 00" required />
            </div>
          </div>
          <div class="in-field">
            <label for="pc-email">E-mail</label>
            <input type="email" id="pc-email" name="email" placeholder="exemple@email.com" />
          </div>
          <div class="in-form-row">
            <div class="in-field">
              <label for="pc-service">Votre demande *</label>
              <select id="pc-service" name="service" required>
                <option value="Diagnostic InBody offert">Diagnostic InBody offert (Gratuit)</option>
                <option value="Sport Nouvelle Génération">Sport Nouvelle Génération (InfraBike/Tapis)</option>
                <option value="Soins Amincissants">Soins Amincissants (VelaShape/Drainage)</option>
                <option value="Soins du Visage">Soins du Visage (Hydrafacial/Kobido)</option>
                <option value="Épilation & Laser">Épilation &amp; Laser Diode</option>
                <option value="Hammam Traditionnel">Hammam Traditionnel</option>
                <option value="Tarifs & Packs">Renseignements Tarifs &amp; Packs</option>
              </select>
            </div>
            <div class="in-field">
              <label for="pc-time">Moment préféré</label>
              <select id="pc-time" name="time">
                <option value="Peu importe">Peu importe</option>
                <option value="Matin (08h – 12h)">Matin (08h – 12h)</option>
                <option value="Après-midi (12h – 16h)">Après-midi (12h – 16h)</option>
                <option value="Fin de journée (16h – 20h)">Fin de journée (16h – 20h)</option>
              </select>
            </div>
          </div>
          <div class="in-field">
            <label for="pc-msg">Message ou précision</label>
            <textarea id="pc-msg" name="message" rows="3" placeholder="Précisez vos objectifs ou vos disponibilités..."></textarea>
          </div>
          <label class="in-checkbox">
            <input type="checkbox" id="pc-consent" required checked />
            <span>J'accepte d'être recontactée par l'équipe INFRASLIM au sujet de ma demande.</span>
          </label>
          <button type="submit" class="in-submit-btn">Envoyer ma demande</button>
          <div class="in-form-feedback" id="pageFormFeedback"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CARTE GOOGLE MAPS
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="find-us-eyebrow reveal" style="text-align:center;">— NOUS TROUVER —</div>
      <h2 class="section-title reveal" style="margin-bottom:2rem;text-align:center;">Centre INFRASLIM à Agdal, Rabat</h2>
      <div class="in-map-frame reveal" style="height:380px;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,0.06);">
        <iframe
          src="https://www.google.com/maps?q=43+Rue+Oum+Rabia,+Agdal,+Rabat,+Maroc&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte INFRASLIM Agdal Rabat">
        </iframe>
      </div>
    </div>
  </section>

  <!-- ============================================================
       BANDEAU WHATSAPP DIRECT
  ============================================================ -->
  <div class="wa-big">
    <div class="container" style="text-align:center;">
      <span class="section-label" style="color:rgba(255,255,255,0.85)">Le moyen le plus rapide</span>
      <h2 class="wa-title">Prenez rendez-vous sur WhatsApp</h2>
      <p class="wa-text">Envoyez-nous un message directement. Notre équipe vous confirme votre créneau dans les plus brefs délais, du lundi au samedi de 08h00 à 20h00.</p>
      <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous.%20Pourriez-vous%20m%27indiquer%20vos%20disponibilit%C3%A9s%20%3F`} target="_blank" rel="noopener" class="wa-btn-big">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        06 15 10 98 98 — Écrire sur WhatsApp
      </a>
      <div class="wa-note">Lun – Sam · 08h00 – 20h00 · Réponse rapide garantie</div>
    </div>
  </div>

</Layout>

<script>
  const pageForm = document.getElementById('pageContactForm');
  if (pageForm) {
    pageForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const name = (document.getElementById('pc-name') as HTMLInputElement)?.value.trim() || '';
      const phone = (document.getElementById('pc-phone') as HTMLInputElement)?.value.trim() || '';
      const service = (document.getElementById('pc-service') as HTMLSelectElement)?.value || '';
      const time = (document.getElementById('pc-time') as HTMLSelectElement)?.value || '';
      const msg = (document.getElementById('pc-msg') as HTMLTextAreaElement)?.value.trim() || '';
      const fb = document.getElementById('pageFormFeedback');
      
      if (fb) {
        fb.innerHTML = 'Merci <strong>' + name + '</strong> ! Votre demande (' + service + ') a bien été enregistrée. Notre équipe vous recontacte au <strong>' + phone + '</strong>.';
        fb.classList.add('show');
      }

      const waText = encodeURIComponent('Bonjour INFRASLIM, je suis ' + name + ' (' + phone + '). Demande : ' + service + ' | Créneau souhaité : ' + time + (msg ? ' | Précision : ' + msg : ''));
      window.open('https://wa.me/212615109898?text=' + waText, '_blank', 'noopener');
      (pageForm as HTMLFormElement).reset();
    });
  }
</script>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --mauve-light: #c4a1c2;
    --bg: #F7F3F7;
    --cream: #FAF7FA;
    --border: rgba(175, 132, 172, 0.25);
    --muted: #6B636B;
  }

  .contact-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #91648e 100%);
    color: #FFFFFF;
    padding: 4.5rem 2rem 5.5rem;
    text-align: center;
  }
  .contact-hero-inner { max-width: 820px; margin: 0 auto; }
  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #DEC9DD;
    margin-bottom: 1rem;
    display: block;
    font-weight: 600;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.02rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.75;
    max-width: 680px;
    margin: 0 auto;
  }

  .section { padding: 5rem 2rem; background: #FFFFFF; }
  .section-cream { background: #FAF7FA; }
  .container { max-width: 1100px; margin: 0 auto; }

  .section-label, .find-us-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.75rem;
    display: block;
    font-weight: 600;
  }
  .section-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: #2D2D2D;
  }
  .section-text {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #555555;
    max-width: 700px;
  }

  /* Contact Cards */
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
    margin-top: 2rem;
  }
  .cc {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }
  .cc:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 40px rgba(175, 132, 172, 0.15);
    border-color: var(--red);
  }
  .cc-icon { font-size: 2.5rem; margin-bottom: 1.25rem; }
  .cc-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    color: #2D2D2D;
  }
  .cc-desc {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .cc-info {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.75rem;
    color: var(--red);
  }
  .cc-btn {
    display: inline-block;
    padding: 0.8rem 1.8rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s;
    border: 1px solid var(--red);
    color: var(--red);
  }
  .cc-btn:hover { background: var(--red); color: #FFFFFF; }
  .cc-btn.wa {
    background: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }
  .cc-btn.wa:hover {
    background: #1db954;
    border-color: #1db954;
  }

  /* Hours Section */
  .hours-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }
  .hours-visual {
    background: #FFFFFF;
    padding: 3rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }
  .hv-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.8rem;
    color: #2D2D2D;
    margin-bottom: 2rem;
    border-left: 4px solid var(--red);
    padding-left: 1rem;
  }
  .hour-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid #F0E8F0;
  }
  .hour-row:last-child { border-bottom: none; }
  .hour-day { font-size: 0.92rem; color: #555; }
  .hour-time { font-size: 0.92rem; color: #2D2D2D; font-weight: 600; }
  .hour-row.closed .hour-time { color: var(--red); font-weight: 700; }

  .hours-info { padding: 0.5rem 0; }
  .hi-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.8rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    color: #2D2D2D;
  }
  .hi-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .hi-item:last-child { border-bottom: none; margin-bottom: 0; }
  .hi-icon { font-size: 1.5rem; flex-shrink: 0; }
  .hi-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .hi-value {
    font-size: 0.92rem;
    color: #444;
    line-height: 1.65;
  }

  .info-box {
    background: #F7F3F7;
    border-left: 4px solid var(--red);
    padding: 1.5rem;
    border-radius: 0 8px 8px 0;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-top: 1.5rem;
  }
  .ib-icon { font-size: 1.25rem; flex-shrink: 0; }
  .ib-text { font-size: 0.88rem; color: #555; line-height: 1.7; }
  .ib-text strong { color: #2D2D2D; }

  /* Form Card */
  .in-form-card {
    background: #F7F3F7;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.03);
  }
  .in-form-card h3 {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 2rem;
    color: #2D2D2D;
    margin-bottom: 0.4rem;
  }
  .in-form-sub {
    font-size: 0.92rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .in-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .in-field {
    margin-bottom: 1.25rem;
  }
  .in-field label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #444;
    margin-bottom: 0.4rem;
  }
  .in-field input, .in-field select, .in-field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 4px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.92rem;
    background: #FFFFFF;
    color: #2D2D2D;
    transition: border-color 0.2s, box-shadow 0.2s;
