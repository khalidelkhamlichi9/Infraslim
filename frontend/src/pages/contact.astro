---
import Layout from '../layouts/Layout.astro';
import { getGlobalSettings } from '../lib/strapi';

const settings = await getGlobalSettings();
const waBase = `https://wa.me/${(settings.whatsapp || '212615109898').replace(/\D/g, '')}`;
---

<Layout title="Contact et accès, Agdal Rabat | INFRASLIM" description="Contactez INFRASLIM à Agdal, Rabat. WhatsApp, téléphone, formulaire. Du lundi au samedi, 08h00 à 20h00, sur rendez-vous." currentPath="/contact">

  <!-- ============================================================
       HERO CONTACT (STYLE CLAIR / MAUVE DÉGRADÉ)
  ============================================================ -->
  <section class="contact-hero">
    <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1920&q=85" alt="Contact & Rendez-vous INFRASLIM Agdal" class="hero-bg-photo" />
    <div class="hero-photo-overlay"></div>
    <div class="hero-bg-overlay"></div>
    <div class="contact-hero-inner">
      <div class="breadcrumb">
        <a href="/">Accueil</a> &nbsp;/&nbsp; Contact
      </div>
      <div class="hero-eyebrow">— LUN–SAM 08H–20H · SUR RENDEZ-VOUS</div>
      <h1 class="hero-title">Centre INFRASLIM à <em>Agdal, Rabat</em></h1>
      <p class="hero-desc">Toutes nos prestations se font sur rendez-vous. Écrivez-nous sur WhatsApp au 06 15 10 98 98, nous vous proposons un créneau dans la journée.</p>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE STRIP
  ============================================================ -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <div class="marquee-item"><span>Sur Rendez-vous Uniquement</span><span class="sep"></span></div>
      <div class="marquee-item"><span>WhatsApp : 06 15 10 98 98</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Lun–Sam 08h–20h</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Réponse Rapide Garantie</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Sur Rendez-vous Uniquement</span><span class="sep"></span></div>
      <div class="marquee-item"><span>WhatsApp : 06 15 10 98 98</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Lun–Sam 08h–20h</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Agdal · Rabat</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Centre 100% Féminin</span><span class="sep"></span></div>
      <div class="marquee-item"><span>Réponse Rapide Garantie</span><span class="sep"></span></div>
    </div>
  </div>

  <!-- ============================================================
       BIENVENUE AU CENTRE AGDAL (VITRINE PHOTO)
  ============================================================ -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="welcome-lounge-card reveal">
        <div class="wlc-photo">
          <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=85" alt="Accueil & Lounge INFRASLIM Agdal" />
          <div class="wlc-overlay"></div>
          <div class="wlc-badge">
            Espace d'Accueil Privatisé · Agdal Rabat
          </div>
        </div>
        <div class="wlc-content">
          <span class="section-label">— UN ACCUEIL SUR-MESURE</span>
          <h2 class="wlc-title">Un havre de paix dédié aux femmes</h2>
          <p class="wlc-desc">Dès que vous franchissez nos portes au 43 Rue Oum Rabiâ, vous pénétrez dans un environnement calme, lumineux et bienveillant. Notre salon d'accueil a été pensé pour vous offrir confort, tisanes bienfaisantes et écoute attentive avant vos soins.</p>
          <div class="wlc-features">
            <div class="wf-item">✓ Accueil chaleureux sans attente</div>
            <div class="wf-item">✓ Parking public Kaïs à 2 min à pied</div>
            <div class="wf-item">✓ Équipe féminine dévouée</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CARTES CONTACT (3 MODES)
  ============================================================ -->
  <section class="section">
    <div class="container">
      <div class="reveal" style="margin-bottom:3rem; text-align:center;">
        <span class="section-label">— MODES DE PRISE DE CONTACT</span>
        <h2 class="section-title">Comment nous joindre</h2>
        <p class="section-text" style="margin:0 auto;">Choisissez le canal qui vous convient le mieux. La prise de rendez-vous s'effectue simplement et rapidement par WhatsApp ou téléphone.</p>
      </div>

      <div class="contact-cards reveal">
        <div class="cc">
          <div class="cc-icon">
            <svg class="h-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="cc-title">WhatsApp Direct</div>
          <p class="cc-desc">La façon la plus rapide et privilégiée de nous joindre. Réponse garantie et réservation immédiate.</p>
          <div class="cc-info">06 15 10 98 98</div>
          <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous.`} target="_blank" rel="noopener" class="cc-btn wa">Écrire sur WhatsApp</a>
        </div>
        <div class="cc">
          <div class="cc-icon">
            <svg class="h-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="cc-title">Téléphone Direct</div>
          <p class="cc-desc">Appelez directement nos praticiennes pour échanger de vive voix pendant nos horaires d'ouverture.</p>
          <div class="cc-info">06 15 10 98 98</div>
          <a href="tel:+212615109898" class="cc-btn">Appeler maintenant</a>
        </div>
        <div class="cc">
          <div class="cc-icon">
            <svg class="h-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="cc-title">Notre Adresse</div>
          <p class="cc-desc">Venez nous rendre visite dans notre écrin au cœur d'Agdal, à 240 m du parking Kaïs.</p>
          <div class="cc-info">43 Rue Oum Rabiâ, Appt. N°2, Agdal</div>
          <a href="https://maps.google.com/?q=43+Rue+Oum+Rabia,+Agdal,+Rabat,+Maroc" target="_blank" rel="noopener" class="cc-btn">Itinéraire Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HORAIRES & INFOS PRATIQUES (2 COLONNES)
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="hours-section reveal">
        <!-- Horaires d'ouverture -->
        <div class="hours-visual">
          <div class="hv-title">Horaires d'ouverture</div>
          <div class="hour-row"><span class="hour-day">Lundi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Mardi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Mercredi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Jeudi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Vendredi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row"><span class="hour-day">Samedi</span><span class="hour-time">08h00 – 20h00</span></div>
          <div class="hour-row closed"><span class="hour-day">Dimanche</span><span class="hour-time">Fermé (Repos)</span></div>
        </div>

        <!-- Informations pratiques -->
        <div class="hours-info">
          <div class="hi-title">Informations pratiques</div>
          <div class="hi-item">
            <div class="hi-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
            <div>
              <div class="hi-label">Réservation Obligatoire</div>
              <div class="hi-value">Sur rendez-vous uniquement, par WhatsApp ou appel direct. Accueil personnalisé sans salle d'attente encombrée.</div>
            </div>
          </div>
          <div class="hi-item">
            <div class="hi-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="7" rx="2"/><path d="M5 11l2-5h10l2 5"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg></div>
            <div>
              <div class="hi-label">Accès &amp; Stationnement</div>
              <div class="hi-value">43 Rue Oum Rabiâ, Appt. N°2, Agdal, Rabat. Parking public Kaïs accessible à 240 m (2 minutes à pied).</div>
            </div>
          </div>
          <div class="hi-item">
            <div class="hi-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
            <div>
              <div class="hi-label">Intimité &amp; Pudeur Garantie</div>
              <div class="hi-value">Espace 100% féminin. Seul le personnel féminin qualifié est présent dans l'établissement.</div>
            </div>
          </div>
          <div class="info-box">
            <div class="ib-icon"><svg class="h-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
            <div class="ib-text"><strong>INFRASLIM est un centre exclusivement féminin.</strong> Votre sérénité, votre confort et l'excellence de vos soins sont nos priorités absolues.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FORMULAIRE DE CONTACT AVEC REDIRECTION WHATSAPP
  ============================================================ -->
  <section class="section" style="background:#FFFFFF;">
    <div class="container" style="max-width:880px;">
      <div class="in-form-card reveal">
        <div class="find-us-eyebrow">— FORMULAIRE DE CONTACT PRIVILÉGIÉ —</div>
        <h3>Transmettez-nous votre demande</h3>
        <p class="in-form-sub">Laissez-nous vos coordonnées, notre équipe vous rappelle ou vous transmet toutes les informations nécessaires par WhatsApp.</p>
        
        <form id="pageContactForm">
          <div class="in-form-row">
            <div class="in-field">
              <label for="pc-name">Nom et prénom *</label>
              <input type="text" id="pc-name" name="name" placeholder="Votre nom et prénom" required />
            </div>
            <div class="in-field">
              <label for="pc-phone">Numéro WhatsApp *</label>
              <input type="tel" id="pc-phone" name="phone" placeholder="06 15 10 98 98" required />
            </div>
          </div>
          <div class="in-field">
            <label for="pc-email">Adresse e-mail (optionnelle)</label>
            <input type="email" id="pc-email" name="email" placeholder="votre.email@domaine.com" />
          </div>
          <div class="in-form-row">
            <div class="in-field">
              <label for="pc-service">Pôle ou soin souhaité *</label>
              <select id="pc-service" name="service" required>
                <option value="Diagnostic InBody offert">Diagnostic InBody offert (Gratuit)</option>
                <option value="Sport Nouvelle Génération">Sport Nouvelle Génération (InfraBike/Tapis)</option>
                <option value="Soins Amincissants">Soins Amincissants (VelaShape/Drainage)</option>
                <option value="Soins du Visage">Soins du Visage (Hydrafacial/Kobido)</option>
                <option value="Épilation & Laser">Épilation &amp; Laser Diode</option>
                <option value="Hammam Traditionnel">Hammam Traditionnel Marocain</option>
                <option value="Tarifs & Packs 10 séances">Renseignements Tarifs &amp; Packs 10 séances</option>
              </select>
            </div>
            <div class="in-field">
              <label for="pc-time">Créneau préféré</label>
              <select id="pc-time" name="time">
                <option value="Peu importe">Peu importe</option>
                <option value="Matin (08h – 12h)">Matin (08h – 12h)</option>
                <option value="Après-midi (12h – 16h)">Après-midi (12h – 16h)</option>
                <option value="Fin de journée (16h – 20h)">Fin de journée (16h – 20h)</option>
              </select>
            </div>
          </div>
          <div class="in-field">
            <label for="pc-msg">Message ou précision particulière</label>
            <textarea id="pc-msg" name="message" rows="3" placeholder="Indiquez vos objectifs ou questions particulières..."></textarea>
          </div>
          <label class="in-checkbox">
            <input type="checkbox" id="pc-consent" required checked />
            <span>J'accepte d'être recontactée par l'équipe INFRASLIM au sujet de ma demande.</span>
          </label>
          <button type="submit" class="in-submit-btn">Envoyer ma demande par WhatsApp →</button>
          <div class="in-form-feedback" id="pageFormFeedback"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CARTE GOOGLE MAPS
  ============================================================ -->
  <section class="section section-cream">
    <div class="container">
      <div class="find-us-eyebrow reveal" style="text-align:center;">— SITUATION GÉOGRAPHIQUE —</div>
      <h2 class="section-title reveal" style="margin-bottom:2.5rem;text-align:center;">Centre INFRASLIM à Agdal, Rabat</h2>
      <div class="in-map-frame reveal">
        <iframe
          src="https://www.google.com/maps?q=43+Rue+Oum+Rabia,+Agdal,+Rabat,+Maroc&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte INFRASLIM Agdal Rabat">
        </iframe>
      </div>
    </div>
  </section>

  <!-- ============================================================
       BANDEAU WHATSAPP DIRECT
  ============================================================ -->
  <div class="wa-big">
    <div class="container" style="text-align:center;">
      <span class="section-label" style="color:rgba(255,255,255,0.85)">Le moyen le plus rapide</span>
      <h2 class="wa-title">Prenez rendez-vous directement sur WhatsApp</h2>
      <p class="wa-text">Envoyez-nous un message. Notre équipe vous confirme votre rendez-vous dans les plus brefs délais, du lundi au samedi de 08h00 à 20h00.</p>
      <a href={`${waBase}?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous.%20Pourriez-vous%20m%27indiquer%20vos%20disponibilit%C3%A9s%20%3F`} target="_blank" rel="noopener" class="wa-btn-big">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        06 15 10 98 98 — Écrire sur WhatsApp
      </a>
      <div class="wa-note">Lun – Sam · 08h00 – 20h00 · Réponse rapide garantie</div>
    </div>
  </div>

</Layout>

<script>
  const pageForm = document.getElementById('pageContactForm');
  if (pageForm) {
    pageForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const name = (document.getElementById('pc-name') as HTMLInputElement)?.value.trim() || '';
      const phone = (document.getElementById('pc-phone') as HTMLInputElement)?.value.trim() || '';
      const service = (document.getElementById('pc-service') as HTMLSelectElement)?.value || '';
      const time = (document.getElementById('pc-time') as HTMLSelectElement)?.value || '';
      const msg = (document.getElementById('pc-msg') as HTMLTextAreaElement)?.value.trim() || '';
      const fb = document.getElementById('pageFormFeedback');
      
      if (fb) {
        fb.innerHTML = 'Merci <strong>' + name + '</strong> ! Votre demande (' + service + ') a bien été enregistrée. Redirection vers WhatsApp en cours...';
        fb.classList.add('show');
      }

      const waText = encodeURIComponent('Bonjour INFRASLIM, je suis ' + name + ' (' + phone + '). Demande : ' + service + ' | Créneau souhaité : ' + time + (msg ? ' | Précision : ' + msg : ''));
      setTimeout(() => {
        window.open('https://wa.me/212615109898?text=' + waText, '_blank', 'noopener');
      }, 700);
      (pageForm as HTMLFormElement).reset();
    });
  }
</script>

<style>
  :root {
    --red: #BB2026;
    --red-dark: #8f1a1f;
    --mauve: #AF84AC;
    --mauve-light: #c4a1c2;
    --bg: #F7F3F7;
    --cream: #FAF7FA;
    --border: rgba(175, 132, 172, 0.25);
    --muted: #6B636B;
  }

  .contact-hero {
    background: linear-gradient(135deg, #AF84AC 0%, #4A284B 100%);
    color: #FFFFFF;
    padding: 5rem 2rem 6.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .contact-hero-inner { max-width: 850px; margin: 0 auto; position: relative; z-index: 2; }
  .breadcrumb {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.75);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.85); text-decoration: underline; }
  .breadcrumb a:hover { color: #fff; }
  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mauve-light);
    margin-bottom: 1rem;
    display: block;
    font-weight: 700;
  }
  .hero-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }
  .hero-title em { font-style: italic; color: #FFFFFF; }
  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.92);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
    font-weight: 300;
  }

  .section { padding: 5rem 2rem; background: #FFFFFF; }
  .section-cream { background: #FAF7FA; }
  .container { max-width: 1100px; margin: 0 auto; }

  .section-label, .find-us-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.75rem;
    display: block;
    font-weight: 700;
  }
  .section-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: #2D2D2D;
  }
  .section-text {
    font-size: 0.96rem;
    line-height: 1.85;
    color: #555555;
    max-width: 700px;
  }

  /* WELCOME LOUNGE CARD */
  .welcome-lounge-card {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(175,132,172,0.22);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    box-shadow: 0 16px 45px rgba(51,21,53,0.08);
  }
  .wlc-photo {
    position: relative;
    min-height: 380px;
  }
  .wlc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wlc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(51,21,53,0.4) 100%);
  }
  .wlc-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    padding: 0.6rem 1.2rem;
    border-radius: 30px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #331535;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }
  .wlc-badge span { color: var(--red); margin-right: 0.4rem; }
  .wlc-content {
    padding: 3.5rem;
    display: flex;
