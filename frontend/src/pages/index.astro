  .ht-dot.active {
    background: #FFFFFF;
    border-color: #BB2026;
    transform: scale(1.25);
  }

  /* =====================================================
     ABOUT SECTION DU SITE HTML
  ===================================================== */
  .about { background: var(--bg); }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: center;
  }
  .about-visual {
    position: relative;
