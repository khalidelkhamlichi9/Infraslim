<script>
  // =====================================================
  // HERO TEXTE — 3 SLIDES AUTO-ROTATION DU SITE HTML
  // =====================================================
  (function() {
    const slides = document.querySelectorAll('.ht-slide');
    const dots = document.querySelectorAll('.ht-dot');
    if (!slides.length) return;
    let current = 0;
    let timer: any;

    const heroEl = document.getElementById('accueil');
    const heroBgs = [
      "linear-gradient(135deg, rgba(145, 100, 142, 0.78) 0%, rgba(74, 40, 75, 0.75) 100%), url('https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat",
      "linear-gradient(135deg, rgba(145, 100, 142, 0.76) 0%, rgba(74, 40, 75, 0.72) 100%), url('https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat",
      "linear-gradient(135deg, rgba(145, 100, 142, 0.78) 0%, rgba(74, 40, 75, 0.75) 100%), url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat"
    ];

    function goTo(idx: number) {
      slides[current]?.classList.remove('active');
      dots[current]?.classList.remove('active');
      current = (idx + slides.length) % slides.length;
      slides[current]?.classList.add('active');
      dots[current]?.classList.add('active');
      if (heroEl && heroBgs[current]) {
        heroEl.style.background = heroBgs[current];
      }
    }

    function next() { goTo(current + 1); }
    function startAuto() { clearInterval(timer); timer = setInterval(next, 5000); }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        goTo(parseInt(dot.getAttribute('data-idx') || '0', 10));
        startAuto();
      });
    });

    startAuto();
  })();

  // =====================================================
  // SERVICES CAROUSEL HORIZONTAL DU SITE HTML
  // =====================================================
  (function() {
    const carousel = document.getElementById('servicesCarousel');
    if (!carousel) return;
    const cards = carousel.querySelectorAll('.service-card') as NodeListOf<HTMLElement>;
    const prevBtn = document.getElementById('carouselPrev');
    const nextBtn = document.getElementById('carouselNext');
    const dots = document.querySelectorAll('.carousel-dot');

    let currentIndex = 0;

    function getVisibleCount() {
      if (window.innerWidth <= 640) return 1;
      if (window.innerWidth <= 1024) return 2;
      return 3;
    }

    function getMaxIndex() {
      return Math.max(0, cards.length - getVisibleCount());
    }

    function scrollTo(index: number) {
      currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
      const firstCard = cards[0];
      const cardWidth = firstCard ? firstCard.offsetWidth + 24 : 320;
      carousel?.scrollTo({ left: currentIndex * cardWidth, behavior: 'smooth' });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === currentIndex);
      });
    }

    prevBtn?.addEventListener('click', () => scrollTo(currentIndex - 1));
    nextBtn?.addEventListener('click', () => scrollTo(currentIndex + 1));
    dots.forEach(dot => {
      dot.addEventListener('click', () => scrollTo(parseInt(dot.getAttribute('data-index') || '0', 10)));
    });
  })();

  // =====================================================
  // TARIFS TABS DU SITE HTML
  // =====================================================
  (function() {
    const tabs = document.querySelectorAll('.tarif-tab');
    const panels = document.querySelectorAll('.tarif-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const panelId = target.getAttribute('data-panel');
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        target.classList.add('active');
        if (panelId) {
          document.getElementById('tarif-' + panelId)?.classList.add('active');
        }
      });
    });
  })();

  // =====================================================
  // FORMULAIRE DE CONTACT
  // =====================================================
  (function() {
    const form = document.getElementById('homeContactForm');
    const feedback = document.getElementById('homeFormFeedback');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('hc-name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('hc-phone') as HTMLInputElement)?.value;
      const service = (document.getElementById('hc-service') as HTMLSelectElement)?.value;
      const msg = (document.getElementById('hc-msg') as HTMLTextAreaElement)?.value;

      const waMsg = `Bonjour INFRASLIM,\nJe suis ${name} (${phone}).\nDemande : ${service}\nMessage : ${msg || 'Aucun message spécifique.'}`;
      window.open(`https://wa.me/212615109898?text=${encodeURIComponent(waMsg)}`, '_blank');

      if (feedback) {
        feedback.textContent = 'Votre demande a été préparée sur WhatsApp avec succès.';
        feedback.classList.add('show');
      }
    });
  })();
</script>
