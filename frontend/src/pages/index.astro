    .pc-form-side { position: static; top: auto; }
  }

  @media (max-width: 768px) {
    .reassurance-grid { grid-template-columns: 1fr; }
    .poles-tabs-bar { gap: 0.5rem; }
    .pole-tab { padding: 0.65rem 1.3rem; font-size: 0.82rem; }
    .section-calories-fullwidth { padding: 5rem 1.5rem; }
    .calories-comparison-bar { grid-template-columns: 1fr; }
    .comp-vs { display: none; }
    .ccb-pillars-grid { grid-template-columns: 1fr; }
    .ipc-steps-list { grid-template-columns: 1fr; }
    .form-grid-2 { grid-template-columns: 1fr; }
    .concierge-booking-card { padding: 2.2rem 1.5rem; }
    .h-slider-progress-group { display: none; }
    .h-title { font-size: 2.3rem; }
    .hero-floating-perks { display: none; }
    .obj-slide-card { flex: 0 0 280px; }
    .t-slide-card { flex: 0 0 280px; }
  }
</style>

<script>
  // 1. HERO SLIDER FLUIDE (AVEC PROGRESSION VISUELLE)
  (function() {
    const slides = document.querySelectorAll('.h-slide');
    const progItems = document.querySelectorAll('.h-prog-item');
    if (!slides.length) return;
    let current = 0;
    let timer: any;

    function goTo(idx: number) {
      slides[current]?.classList.remove('active');
      progItems[current]?.classList.remove('active');
      current = (idx + slides.length) % slides.length;
      slides[current]?.classList.add('active');
      progItems[current]?.classList.add('active');
    }

    function auto() {
      clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 6000);
    }

    progItems.forEach(item => {
      item.addEventListener('click', () => {
        goTo(parseInt(item.getAttribute('data-target') || '0', 10));
        auto();
      });
    });

    auto();
  })();

  // 2. SLIDER INTERACTIF DES OBJECTIFS (FLÈCHES + DOTS)
  (function() {
    const track = document.getElementById('objectivesTrack');
    const prev = document.getElementById('objPrev');
    const next = document.getElementById('objNext');
    const dots = document.querySelectorAll('.o-dot');
    if (!track) return;

    function getCardWidth() {
      const card = track?.querySelector('.obj-slide-card') as HTMLElement;
      return card ? card.offsetWidth + 32 : 360;
    }

    next?.addEventListener('click', () => {
      track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });

    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });

    dots.forEach(d => {
      d.addEventListener('click', () => {
        const idx = parseInt(d.getAttribute('data-index') || '0', 10);
        track.scrollTo({ left: idx * getCardWidth(), behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', () => {
      const idx = Math.round(track.scrollLeft / getCardWidth());
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    }, { passive: true });
  })();

  // 3. TABS INTERACTIVES DES PÔLES DE SERVICES
  (function() {
    const tabs = document.querySelectorAll('.pole-tab');
    const panels = document.querySelectorAll('.pole-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-pole');
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        if (target) {
          const panel = document.getElementById(target);
          panel?.classList.add('active');
          // Trigger reveal animations for newly visible cards inside this tab
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              panel?.querySelectorAll('.reveal-on-scroll, .card-fly-left, .card-fly-right, .card-fly-up').forEach(el => {
                el.classList.add('is-revealed');
              });
            });
          });
        }
      });
    });
  })();

  // 3b. SLIDERS INTERACTIFS DES FICHES DE PRESTATIONS PAR PÔLE
  (function() {
    document.querySelectorAll('.services-slider-container').forEach(container => {
      const slider = container.querySelector('.services-fiches-slider') as HTMLElement;
      const prevBtn = container.querySelector('.sf-nav-btn.prev');
      const nextBtn = container.querySelector('.sf-nav-btn.next');
      if (!slider) return;

      function getStep() {
        const card = slider.querySelector('.service-fiche') as HTMLElement;
        return card ? card.offsetWidth + 28 : 340;
      }

      nextBtn?.addEventListener('click', () => {
        slider.scrollBy({ left: getStep(), behavior: 'smooth' });
      });

      prevBtn?.addEventListener('click', () => {
        slider.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      slider.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });
      slider.addEventListener('mouseleave', () => { isDown = false; });
      slider.addEventListener('mouseup', () => { isDown = false; });
      slider.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - slider.offsetLeft;
        slider.scrollLeft = scrollLeft - (x - startX) * 1.4;
      });
    });
  })();

  // 4. SLIDER DES FORMULES TARIFS (SANS DÉCALAGES · AVEC SNAP)
  (function() {
    const slider = document.getElementById('packsSlider');
    const prev = document.getElementById('sliderPrev');
    const next = document.getElementById('sliderNext');
    const dots = document.querySelectorAll('.s-dot');
    if (!slider) return;

    function getCardWidth() {
      const card = slider?.querySelector('.t-slide-card') as HTMLElement;
      return card ? card.offsetWidth + 32 : 350;
    }

    next?.addEventListener('click', () => {
      slider.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });

    prev?.addEventListener('click', () => {
      slider.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });

    dots.forEach(d => {
      d.addEventListener('click', () => {
        const idx = parseInt(d.getAttribute('data-s') || '0', 10);
        slider.scrollTo({ left: idx * getCardWidth(), behavior: 'smooth' });
      });
    });

    slider.addEventListener('scroll', () => {
      const idx = Math.round(slider.scrollLeft / getCardWidth());
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    }, { passive: true });
  })();

  // 5. ACCORDÉON FAQ ANIMÉ FLUIDE (AVEC OUVERTURE ET FERMETURE DOUCE)
  (function() {
    const items = document.querySelectorAll('.fac-item');
    items.forEach(item => {
      const btn = item.querySelector('.fac-question');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        items.forEach(i => i.classList.remove('open'));
        if (!isOpen) {
          item.classList.add('open');
        }
      });
    });
  })();

  // 6. REDIRECTION FORMULAIRE WHATSAPP VIP
  (function() {
    const form = document.getElementById('homeContactForm');
    const feedback = document.getElementById('homeFormFeedback');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('hc-name') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('hc-phone') as HTMLInputElement)?.value.trim();
      const service = (document.getElementById('hc-service') as HTMLSelectElement)?.value;
      const msg = (document.getElementById('hc-msg') as HTMLTextAreaElement)?.value.trim();

      const text = encodeURIComponent(
        `Bonjour INFRASLIM,\nJe suis ${name} (${phone}).\nDemande : ${service}\nMessage : ${msg || 'Aucun'}\nJe souhaite prendre rendez-vous.`
      );

      if (feedback) {
        feedback.innerHTML = `Merci <strong>${name}</strong> ! Redirection vers WhatsApp en cours...`;
        feedback.classList.add('show');
      }

      setTimeout(() => {
        window.open(`https://wa.me/212615109898?text=${text}`, '_blank', 'noopener');
      }, 600);
    });
  })();

  // 7. ANIMATION FORMULAIRE STICKY LORS DU DÉFILEMENT
  (function() {
    const card = document.querySelector('.concierge-booking-card');
    const contactSec = document.getElementById('contact');
    if (!card || !contactSec) return;

    window.addEventListener('scroll', () => {
      const rect = contactSec.getBoundingClientRect();
      const isSticky = rect.top <= 110 && rect.bottom >= 450;
      card.classList.toggle('is-stuck', isSticky);
    }, { passive: true });
  })();

  // 8. INTERSECTION OBSERVER POUR ANIMATIONS SCROLL PAR SECTION
  (function() {
    function initReveal() {
      // 1. Textes cinématiques (mot par mot / split)
      document.querySelectorAll('.split-text-reveal').forEach(title => {
        const el = title as HTMLElement;
        if (el.dataset.splitDone === '1') return;
        el.dataset.splitDone = '1';
        const text = el.innerHTML;
        // Découpe par mots tout en préservant les balises HTML comme <br> ou <em>
        const parts = text.split(/(<[^>]+>|\s+)/);
        el.innerHTML = parts.map((part) => {
          if (part.startsWith('<') || part.trim() === '') return part;
          return `<span class="split-char-anim"><span class="char">${part}</span></span>`;
        }).join('');
      });

      const revealElements = document.querySelectorAll(
        '.reveal-on-scroll, .card-fly-left, .card-fly-right, .card-fly-up, .split-text-reveal'
      );
      if (!revealElements.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target;
            target.classList.add('is-revealed');
            
            // Si c'est un titre split-text, animer ses mots séquentiellement
            if (target.classList.contains('split-text-reveal')) {
              const chars = target.querySelectorAll('.char');
              chars.forEach((c, i) => {
                setTimeout(() => {
                  (c.parentElement as HTMLElement)?.classList.add('is-revealed');
                }, i * 65);
              });
            }

            observer.unobserve(target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -40px 0px'
      });

      revealElements.forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) {
          el.classList.add('is-revealed');
          if (el.classList.contains('split-text-reveal')) {
            el.querySelectorAll('.char').forEach((c, i) => {
              setTimeout(() => {
                (c.parentElement as HTMLElement)?.classList.add('is-revealed');
              }, i * 65);
            });
          }
        } else {
          observer.observe(el);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReveal);
    } else {
      initReveal();
    }
  })();
</script>
