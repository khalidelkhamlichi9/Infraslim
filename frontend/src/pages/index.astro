---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getServices, getFaqs, getGlobalSettings } from '../lib/strapi';

const services = await getServices();
const faqs = await getFaqs();
const settings = await getGlobalSettings();
---

<Layout title="Centre d'amincissement à Rabat, 100 % femmes | INFRASLIM" description="Amincissement, remise en forme, soins du visage et hammam à Agdal, dans un centre réservé aux femmes. Diagnostic InBody offert." currentPath="/">

  <!-- ===================================================
       HERO — 3 MESSAGES TEXTE (FOND MAUVE & PHOTO NATURELLE)
  =================================================== -->
  <section id="accueil" class="hero-text">
    <div class="ht-slides">
      <!-- Slide 1 -->
      <div class="ht-slide active" id="slide-0">
        <div class="ht-tag">Sport Infrarouge</div>
        <h1 class="ht-title">
          Brûlez jusqu'à<br />
          <em>1300 Calories</em><br />
          en 30 minutes
        </h1>
        <p class="ht-sub">La technologie infrarouge qui multiplie vos résultats dès la première séance.</p>
        <div class="ht-btns">
          <a href="/services/sport-nouvelle-generation" class="ht-btn-red">Découvrir le Sport &gt;</a>
          <a href={settings.whatsapp} target="_blank" rel="noopener" class="ht-btn-white">Prendre RDV</a>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="ht-slide" id="slide-1">
        <div class="ht-tag">Soins &amp; Beauté</div>
        <h1 class="ht-title">
          Sculptez votre<br />
          <em>Silhouette</em><br />
          avec nos experts
        </h1>
        <p class="ht-sub">VelaShape, Hydrafacial, soins amincissants… des technologies de pointe pour vous.</p>
        <div class="ht-btns">
          <a href="/services/soins-amincissants" class="ht-btn-red">Nos Soins &gt;</a>
          <a href="/tarifs" class="ht-btn-white">Voir les tarifs</a>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="ht-slide" id="slide-2">
        <div class="ht-tag">Hammam &amp; Rituels</div>
        <h1 class="ht-title">
          Hammam Traditionnel<br />
          <em>100% Féminin</em><br />
          à Agdal, Rabat
        </h1>
        <p class="ht-sub">Gommage Kessa, Ghassoul, rituels beldi… un moment de pur bien-être pour vous.</p>
        <div class="ht-btns">
          <a href="/hammam" class="ht-btn-red">Le Hammam &gt;</a>
          <a href={settings.whatsapp} target="_blank" rel="noopener" class="ht-btn-white">Réserver</a>
        </div>
      </div>
    </div>

    <!-- Dots -->
    <div class="ht-dots">
      <button class="ht-dot active" data-idx="0" aria-label="Slide 1"></button>
      <button class="ht-dot" data-idx="1" aria-label="Slide 2"></button>
      <button class="ht-dot" data-idx="2" aria-label="Slide 3"></button>
    </div>
  </section>

  <!-- ===================================================
       ABOUT
  =================================================== -->
  <section id="centre" class="about">
    <div class="section-inner">
      <div class="about-grid">
        <div class="about-visual reveal">
          <div class="about-visual-main">
            <div class="visual-text">
              <div class="vt-title">INFRASLIM</div>
              <div class="vt-sub">Agdal · Rabat · Maroc</div>
            </div>
          </div>
          <div class="about-inset-photo">
            <img src="https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg" alt="Entraînement InfraBike 100% Féminin chez INFRASLIM" />
          </div>
          <div class="about-badge luxury-float">
            100%<br />Féminin
          </div>
        </div>

        <div class="about-content reveal">
          <span class="section-tag">Le Centre</span>
          <h2 class="section-title">Un espace pensé<br /><em>pour vous</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            INFRASLIM est un institut de beauté et de bien-être haut de gamme, 100% féminin, situé au cœur d'Agdal, à Rabat. Notre équipe de professionnelles vous accompagne avec bienveillance et expertise dans votre parcours de bien-être, d'amincissement et de beauté. Nous proposons une sélection rigoureuse des technologies les plus efficaces, des soins personnalisés et un suivi adapté à chaque cliente.
          </p>

          <div class="about-stats">
            <div class="stat-box">
              <div class="stat-num" data-count="5">0</div>
              <div class="stat-label">Univers de soins</div>
            </div>
            <div class="stat-box">
              <div class="stat-num">★★★★★</div>
              <div class="stat-label">Technologies de pointe</div>
            </div>
            <div class="stat-box">
              <div class="stat-num">100%</div>
              <div class="stat-label">Féminin</div>
            </div>
            <div class="stat-box">
              <div class="stat-num">Agdal</div>
              <div class="stat-label">Rabat, Maroc</div>
            </div>
          </div>

          <div class="hours-box">
            <div class="hours-icon">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="hours-text">
              <strong>Horaires d'ouverture</strong>
              <span>Lundi au Samedi · 08h00 – 20h00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       SERVICES OVERVIEW — CAROUSEL HORIZONTAL EXACT DU HTML
  =================================================== -->
  <section id="services-overview" class="services-overview">
    <div class="section-inner">
      <div class="reveal" style="text-align:center; max-width:600px; margin: 0 auto 1rem;">
        <span class="section-tag">Nos Univers de Soins</span>
        <h2 class="section-title">Tout ce dont vous avez<br /><em>besoin, en un lieu</em></h2>
        <div class="divider" style="margin: 1.5rem auto;"></div>
        <p class="section-desc" style="margin: 0 auto;">Cinq univers de soins soigneusement sélectionnés pour vous accompagner vers une silhouette, une peau et un bien-être sublimés.</p>
      </div>

      <div class="services-carousel-wrap reveal">
        <div class="services-carousel" id="servicesCarousel">
          <!-- Sport -->
          <a href="/services/sport-nouvelle-generation" class="service-card" style="text-decoration:none;color:inherit;">
            <div class="service-card-bg sport">
              <div class="service-card-icon">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
              </div>
            </div>
            <div class="service-card-content">
              <span class="service-card-num">01 —</span>
              <h3 class="service-card-title">Sport Nouvelle Génération</h3>
              <div class="service-card-tags">
                <span class="service-tag">InfraBike</span>
                <span class="service-tag">Tapis infrarouge</span>
                <span class="service-tag">Infra Roller</span>
                <span class="service-tag">Musculation</span>
              </div>
            </div>
          </a>

          <!-- Amincissants -->
          <a href="/services/soins-amincissants" class="service-card" style="text-decoration:none;color:inherit;">
            <div class="service-card-bg slim">
              <div class="service-card-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
              </div>
            </div>
            <div class="service-card-content">
              <span class="service-card-num">02 —</span>
              <h3 class="service-card-title">Soins Amincissants</h3>
              <div class="service-card-tags">
                <span class="service-tag">VelaShape</span>
                <span class="service-tag">Madérothérapie</span>
                <span class="service-tag">Pressothérapie</span>
                <span class="service-tag">Massages</span>
              </div>
            </div>
          </a>

          <!-- Visage -->
          <a href="/services/soins-visage" class="service-card" style="text-decoration:none;color:inherit;">
            <div class="service-card-bg visage">
              <div class="service-card-icon">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              </div>
            </div>
            <div class="service-card-content">
              <span class="service-card-num">03 —</span>
              <h3 class="service-card-title">Soins du Visage</h3>
              <div class="service-card-tags">
                <span class="service-tag">Hydrafacial</span>
                <span class="service-tag">Carbon Peel</span>
                <span class="service-tag">Kobido</span>
                <span class="service-tag">Microneedling</span>
              </div>
            </div>
          </a>

          <!-- Laser -->
          <a href="/services/epilation-laser" class="service-card" style="text-decoration:none;color:inherit;">
            <div class="service-card-bg laser">
              <div class="service-card-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"/></svg>
              </div>
            </div>
            <div class="service-card-content">
              <span class="service-card-num">04 —</span>
              <h3 class="service-card-title">Épilation &amp; Laser</h3>
              <div class="service-card-tags">
                <span class="service-tag">Laser diode</span>
                <span class="service-tag">Détatouage</span>
                <span class="service-tag">Épilation cire</span>
              </div>
            </div>
          </a>

          <!-- Hammam -->
          <a href="/hammam" class="service-card" style="text-decoration:none;color:inherit;">
            <div class="service-card-bg hammam">
              <div class="service-card-icon">
                <svg viewBox="0 0 24 24"><path d="M12 3c0 0-4 4-4 8s4 8 4 8 4-4 4-8-4-8-4-8z"/></svg>
              </div>
            </div>
            <div class="service-card-content">
              <span class="service-card-num">05 —</span>
              <h3 class="service-card-title">Hammam</h3>
              <div class="service-card-tags">
                <span class="service-tag">Vapeur</span>
                <span class="service-tag">Gommage kessa</span>
                <span class="service-tag">Ghassoul</span>
                <span class="service-tag">Beldi</span>
              </div>
            </div>
          </a>
        </div>

        <!-- Carousel controls -->
        <div class="carousel-controls">
          <button class="carousel-btn" id="carouselPrev" aria-label="Précédent">&#8592;</button>
          <div class="carousel-dots" id="carouselDots">
            <button class="carousel-dot active" data-index="0"></button>
            <button class="carousel-dot" data-index="1"></button>
            <button class="carousel-dot" data-index="2"></button>
          </div>
          <button class="carousel-btn" id="carouselNext" aria-label="Suivant">&#8594;</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       SPORT NOUVELLE GÉNÉRATION
  =================================================== -->
  <section id="sport" class="featured-service">
    <div class="section-inner">
      <div class="featured-grid">
        <div class="featured-visual sport reveal">
          <div class="featured-visual-label">Sport</div>
        </div>
        <div class="reveal">
          <span class="section-tag">01 — Sport Nouvelle Génération</span>
          <h2 class="section-title">Brûlez plus,<br /><em>tonifiez mieux</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            Nos équipements de sport infrarouge combinent l'effort physique et les bienfaits de la chaleur infrarouge pour multiplier les résultats. Brûlez plus de calories, tonifiez votre corps et ressentez les bénéfices dès la première séance.
          </p>
          <div class="featured-services-list">
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">InfraBike</div>
              <p class="fs-item-desc">Vélo elliptique infrarouge. Cardio + Chaleur infrarouge = résultats optimisés.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Tapis roulant infrarouge</div>
              <p class="fs-item-desc">Marche ou course sous chaleur infrarouge douce pour amplifier la combustion des graisses.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Infra Roller</div>
              <p class="fs-item-desc">Massage motorisé associé à l'infrarouge pour affiner et drainer les zones ciblées.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Renforcement musculaire</div>
              <p class="fs-item-desc">Équipements de musculation adaptés pour tonifier et sculpter votre silhouette.</p>
            </div>
          </div>
          <div class="featured-cta-row">
            <a href={settings.whatsapp} target="_blank" rel="noopener" class="btn-primary">
              Prendre RDV
            </a>
            <a href="/services/sport-nouvelle-generation" class="btn-secondary-link">Voir tous les détails →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       SOINS AMINCISSANTS
  =================================================== -->
  <section id="amincissants" class="featured-service" style="background: var(--cream);">
    <div class="section-inner">
      <div class="featured-grid reverse">
        <div class="featured-visual slim reveal">
          <div class="featured-visual-label">Minceur</div>
        </div>
        <div class="reveal">
          <span class="section-tag">02 — Soins Amincissants</span>
          <h2 class="section-title">Sculptez votre<br /><em>silhouette</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            Nos protocoles amincissants associent technologies de pointe et soins manuels experts pour cibler les zones rebelles, drainer, raffermir et sublimer votre silhouette.
          </p>
          <div class="featured-services-list">
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">VelaShape</div>
              <p class="fs-item-desc">Technologie radiofréquence + infrarouge + massage motorisé pour un remodelage corporel avancé.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Madérothérapie</div>
              <p class="fs-item-desc">Massage sculptant aux rouleaux de bois pour réduire la cellulite et tonifier la peau.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Drainage lymphatique</div>
              <p class="fs-item-desc">Technique manuelle douce favorisant l'élimination des toxines et la réduction des œdèmes.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Pressothérapie</div>
              <p class="fs-item-desc">Bottes de compression pneumatique pour activer la circulation et drainer les membres.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Sauna dôme &amp; Couverture chauffante</div>
              <p class="fs-item-desc">Sudation intense sous dôme chauffant ou enveloppement minceur chauffant pour accélérer l'élimination.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Massages</div>
              <p class="fs-item-desc">Massages bien-être et relaxants pour détendre le corps et activer la circulation.</p>
            </div>
          </div>
          <div class="featured-cta-row">
            <a href={settings.whatsapp} target="_blank" rel="noopener" class="btn-primary">
              Prendre RDV
            </a>
            <a href="/services/soins-amincissants" class="btn-secondary-link">Voir tous les détails →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       SOINS DU VISAGE
  =================================================== -->
  <section id="visage" class="featured-service">
    <div class="section-inner">
      <div class="featured-grid">
        <div class="featured-visual visage reveal">
          <div class="featured-visual-label">Visage</div>
        </div>
        <div class="reveal">
          <span class="section-tag">03 — Soins du Visage</span>
          <h2 class="section-title">L'éclat naturel<br /><em>de votre peau</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            Nos soins visage s'appuient sur des technologies médicales et des protocoles éprouvés pour révéler l'éclat naturel de votre peau.
          </p>
          <div class="featured-services-list">
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Hydrafacial</div>
              <p class="fs-item-desc">Nettoyage en profondeur + hydratation intense pour une peau rayonnante immédiatement.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Carbon Peel</div>
              <p class="fs-item-desc">Peeling au carbone activé par laser pour unifier le teint et affiner le grain de peau.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Kobido</div>
              <p class="fs-item-desc">Massage japonais lifting du visage pour redessiner l'ovale et raviver l'éclat naturel.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Microneedling</div>
              <p class="fs-item-desc">Stimulation naturelle du collagène pour estomper les ridules et texturer la peau.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Soins spécifiques</div>
              <p class="fs-item-desc">Protocole anti-âge, anti-taches et anti-acné — chaque soin ciblé pour vos besoins précis.</p>
            </div>
          </div>
          <div class="featured-cta-row">
            <a href={settings.whatsapp} target="_blank" rel="noopener" class="btn-primary">
              Prendre RDV
            </a>
            <a href="/services/soins-visage" class="btn-secondary-link">Voir tous les détails →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       ÉPILATION & LASER
  =================================================== -->
  <section id="laser" class="featured-service" style="background: var(--cream);">
    <div class="section-inner">
      <div class="featured-grid reverse">
        <div class="featured-visual laser reveal">
          <div class="featured-visual-label">Laser</div>
        </div>
        <div class="reveal">
          <span class="section-tag">04 — Épilation &amp; Laser</span>
          <h2 class="section-title">Peau lisse,<br /><em>durablement</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            Des solutions durables pour une peau lisse et lumineuse, avec des technologies adaptées à tous les types de peau.
          </p>
          <div class="featured-services-list">
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Épilation laser diode</div>
              <p class="fs-item-desc">La référence en épilation permanente — efficace sur tous les phototypes, résultats durables.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Détatouage laser</div>
              <p class="fs-item-desc">Effacement progressif et efficace — sur devis, selon la taille et les couleurs du tatouage.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Épilation à la cire</div>
              <p class="fs-item-desc">Méthode traditionnelle experte, pratiquée avec soin et hygiène pour un résultat impeccable.</p>
            </div>
          </div>
          <div class="featured-cta-row">
            <a href={settings.whatsapp} target="_blank" rel="noopener" class="btn-primary">
              Prendre RDV
            </a>
            <a href="/services/epilation-laser" class="btn-secondary-link">Voir tous les détails →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       HAMMAM
  =================================================== -->
  <section id="hammam" class="featured-service">
    <div class="section-inner">
      <div class="featured-grid">
        <div class="featured-visual hammam reveal">
          <div class="featured-visual-label">Hammam</div>
        </div>
        <div class="reveal">
          <span class="section-tag">05 — Hammam Traditionnel</span>
          <h2 class="section-title">Un rituel ancestral<br /><em>de purification</em></h2>
          <div class="divider"></div>
          <p class="section-desc">
            Notre Hammam traditionnel marocain offre une expérience de détente absolue. Vapeur bienfaisante, gommage au savon beldi, enveloppement au ghassoul... Un rituel de purification ancestral pour le corps et l'esprit.
          </p>
          <div class="featured-services-list">
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Accès Hammam</div>
              <p class="fs-item-desc">Baignez-vous dans une vapeur bienfaisante pour ouvrir les pores et préparer votre peau.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Gommage Kessa</div>
              <p class="fs-item-desc">Exfoliation traditionnelle au gant kessa pour éliminer les cellules mortes et révéler une peau neuve.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Savon Beldi &amp; Ghassoul</div>
              <p class="fs-item-desc">Nettoyage en profondeur avec le savon beldi traditionnel et l'argile purifiante ghassoul.</p>
            </div>
            <div class="fs-item">
              <div class="fs-item-gold"></div>
              <div class="fs-item-title">Enveloppement argile</div>
              <p class="fs-item-desc">Enveloppement minéralisant et purifiant pour une peau douce et lumineuse.</p>
            </div>
          </div>
          <div class="featured-cta-row">
            <a href={settings.whatsapp} target="_blank" rel="noopener" class="btn-primary">
              Réserver le Hammam
            </a>
            <a href="/hammam" class="btn-secondary-link">Voir tous les détails →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       TECHNOLOGIES
  =================================================== -->
  <section class="tech-section">
    <div class="section-inner">
      <div class="reveal" style="text-align:center; max-width:600px; margin: 0 auto 1rem;">
        <span class="section-tag">Nos Standards</span>
        <h2 class="section-title" style="color:#2D2D2D;">Équipements &amp;<br /><em>Technologies</em></h2>
        <div class="divider" style="margin: 1.5rem auto;"></div>
        <p class="section-desc" style="color:#6B636B; margin: 0 auto;">Nous sélectionnons avec rigueur les meilleures technologies certifiées pour vous garantir des résultats visibles et durables.</p>
      </div>

      <div class="tech-pillars">
        <div class="tech-pillar reveal">
