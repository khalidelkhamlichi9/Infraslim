  /* ===================================================
     ANIMATIONS AVANCÉES ULTRA-LUXURY (TEXT REVEAL, CARDS FROM SIDE, 3D TILT)
  =================================================== */
  :global(.split-char-anim) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }
  :global(.split-char-anim .char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(115%) rotate(4deg);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s ease;
    will-change: transform, opacity;
  }
  :global(.split-char-anim.is-revealed .char) {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }

  /* Entrée des cartes depuis le côté avec rotation et flou cinétique */
  :global(.card-fly-left) {
    opacity: 0 !important;
    transform: translateX(-120px) rotate(-3deg) !important;
    filter: blur(8px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s ease !important;
  }
  :global(.card-fly-right) {
    opacity: 0 !important;
    transform: translateX(120px) rotate(3deg) !important;
    filter: blur(8px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s ease !important;
  }
  :global(.card-fly-up) {
    opacity: 0 !important;
    transform: translateY(90px) scale(0.92) !important;
    filter: blur(6px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s ease !important;
  }
  :global(.card-fly-left.is-revealed),
  :global(.card-fly-right.is-revealed),
  :global(.card-fly-up.is-revealed) {
    opacity: 1 !important;
    transform: translate(0, 0) rotate(0deg) scale(1) !important;
    filter: blur(0px) !important;
  }

  /* Section Calories Dial Glowing Rotation & Pulse */
  @keyframes dialCounterSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  :global(.glow-dial-advanced) {
    animation: dialPulse 3s infinite alternate, dialCounterSpin 35s linear infinite;
  }

  /* Delays dégressifs puissants pour effet cascade spectaculaire */
  :global(.delay-s1) { transition-delay: 0.1s !important; }
  :global(.delay-s2) { transition-delay: 0.25s !important; }
  :global(.delay-s3) { transition-delay: 0.4s !important; }
  :global(.delay-s4) { transition-delay: 0.55s !important; }
  :global(.delay-s5) { transition-delay: 0.7s !important; }
  :global(.delay-s6) { transition-delay: 0.85s !important; }

