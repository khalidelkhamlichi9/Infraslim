---
import Layout from '../layouts/Layout.astro';
import { getServices, getGlobalSettings, getArticles } from '../lib/strapi';

const services = await getServices();
const settings = await getGlobalSettings();
const articles = await getArticles();
const recentArticles = articles.slice(0, 3);
const waBase = settings.whatsapp || 'https://wa.me/212615109898';
---

<Layout title="Centre d'amincissement à Rabat, 100 % femmes | INFRASLIM" description="Amincissement, remise en forme, soins du visage et hammam à Agdal, dans un centre réservé aux femmes. Diagnostic InBody offert." currentPath="/">

  <!-- ===================================================
       1. HERO ULTRA-LUXURY SLIDER (3 SLIDES ÉDITORIALES)
  =================================================== -->
  <section id="accueil" class="hero-hrbana">
    <div class="hero-slider-track">
      <!-- Slide 1 : Sport Nouvelle Génération -->
      <div class="h-slide active" data-index="0">
        <div class="h-slide-img" style="background-image: url('https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg');"></div>
        <div class="h-slide-overlay"></div>
        <div class="h-slide-container">
          <div class="h-slide-inner">
            <div class="h-eyebrow-pill">
              <span class="pulsing-core"></span>
              <span>HAUTE TECHNOLOGIE MINCEUR · 100% FEMMES</span>
            </div>
            <h1 class="h-title">
              Centre d'amincissement et de<br />
              <em>remise en forme</em> à Rabat
            </h1>
            <p class="h-description">
              Sport nouvelle génération et soins amincissants, dans un centre 100 % féminin à Agdal.
            </p>
            <div class="h-cta-group">
              <a href={`${waBase}?text=${encodeURIComponent('Bonjour INFRASLIM, je souhaite réserver mon diagnostic InBody offert.')}`} target="_blank" rel="noopener" class="btn-hrbana-primary">
                <span>Diagnostic InBody offert</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#nos-services" class="btn-hrbana-glass">
                <span>Voir nos services</span>
              </a>
            </div>

            <div class="hero-floating-perks">
              <div class="hfp-item">
                <span class="hfp-num">1 300 kcal</span>
                <span class="hfp-lbl">Brûlées en 30 min</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">100 %</span>
                <span class="hfp-lbl">Réservé aux femmes</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">Agdal</span>
                <span class="hfp-lbl">Parking à 3 min</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2 : Soins du Visage -->
      <div class="h-slide" data-index="1">
        <div class="h-slide-img" style="background-image: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1920&q=85');"></div>
        <div class="h-slide-overlay"></div>
        <div class="h-slide-container">
          <div class="h-slide-inner">
            <div class="h-eyebrow-pill">
              <span class="pulsing-core"></span>
              <span>MÉDICO-ESTHÉTIQUE & RITUELS ANCESTRAUX</span>
            </div>
            <h2 class="h-title">
              Institut de soins du visage<br />
              à <em>Rabat, Agdal</em>
            </h2>
            <p class="h-description">
              Hydrafacial, microneedling, Carbon Peel et soins ciblés anti-âge, anti-taches et anti-acné.
            </p>
            <div class="h-cta-group">
              <a href={`${waBase}?text=${encodeURIComponent('Bonjour INFRASLIM, je souhaite des renseignements sur vos soins du visage.')}`} target="_blank" rel="noopener" class="btn-hrbana-primary">
                <span>Diagnostic InBody offert</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#nos-services" class="btn-hrbana-glass">
                <span>Voir nos services</span>
              </a>
            </div>

            <div class="hero-floating-perks">
              <div class="hfp-item">
                <span class="hfp-num">Hydrafacial</span>
                <span class="hfp-lbl">Éclat & Pureté</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">Kobido</span>
                <span class="hfp-lbl">Lifting Japonais</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">Carbon Peel</span>
                <span class="hfp-lbl">Pores resserrés</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 3 : Hammam Traditionnel -->
      <div class="h-slide" data-index="2">
        <div class="h-slide-img" style="background-image: url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1920&q=85');"></div>
        <div class="h-slide-overlay"></div>
        <div class="h-slide-container">
          <div class="h-slide-inner">
            <div class="h-eyebrow-pill">
              <span class="pulsing-core"></span>
              <span>SANCTUAIRE DE BIEN-ÊTRE MAROCAIN · 100% FEMMES</span>
            </div>
            <h2 class="h-title">
              Hammam traditionnel à Rabat,<br />
              <em>100 % femmes</em>
            </h2>
            <p class="h-description">
              Savon noir, gommage au kessa et rinçage, à partir de 150 DH.
            </p>
            <div class="h-cta-group">
              <a href={`${waBase}?text=${encodeURIComponent('Bonjour INFRASLIM, je souhaite réserver une séance de hammam.')}`} target="_blank" rel="noopener" class="btn-hrbana-primary">
                <span>Diagnostic InBody offert</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#nos-services" class="btn-hrbana-glass">
                <span>Voir nos services</span>
              </a>
            </div>

            <div class="hero-floating-perks">
              <div class="hfp-item">
                <span class="hfp-num">150 DH</span>
                <span class="hfp-lbl">Hammam Infraslim</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">250 DH</span>
                <span class="hfp-lbl">Hammam Royal</span>
              </div>
              <div class="hfp-sep"></div>
              <div class="hfp-item">
                <span class="hfp-num">Beldi</span>
                <span class="hfp-lbl">Intimité & Pureté</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation du slider avec barres de progression temporelles -->
    <div class="hero-bottom-bar">
      <div class="h-slider-progress-group">
        <div class="h-prog-item active" data-target="0">
          <span class="h-prog-num">01</span>
          <div class="h-prog-bar"><div class="h-prog-fill"></div></div>
          <span class="h-prog-label">Sport Infrarouge</span>
        </div>
        <div class="h-prog-item" data-target="1">
          <span class="h-prog-num">02</span>
          <div class="h-prog-bar"><div class="h-prog-fill"></div></div>
          <span class="h-prog-label">Soins Visage</span>
        </div>
        <div class="h-prog-item" data-target="2">
          <span class="h-prog-num">03</span>
          <div class="h-prog-bar"><div class="h-prog-fill"></div></div>
          <span class="h-prog-label">Hammam Beldi</span>
        </div>
      </div>

      <div class="h-floating-badge-glass">
        <span class="h-fb-dot"></span>
        <span>100% Femmes · Agdal Rabat</span>
      </div>
    </div>
  </section>

  <!-- ===================================================
       INFINITE LUXURY MARQUEE (COULEUR CLAIRE HARMONISÉE - PAS NOIRE)
  =================================================== -->
  <div class="marquee-luxury">
    <div class="marquee-luxury-track">
      <div class="mlt-item"><span>SPORT INFRAROUGE 1 300 KCAL</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>AMINCISSEMENT HAUTE PRÉCISION</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>SOINS DU VISAGE MÉDICO-ESTHÉTIQUES</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>HAMMAM TRADITIONNEL 100% FEMMES</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>BILAN INBODY OFFERT</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>ÉPILATION LASER DIODE</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>AGDAL RABAT · PARKING KAÏS</span><span class="mlt-star">✦</span></div>
      <!-- Duplicate for seamless infinite loop -->
      <div class="mlt-item"><span>SPORT INFRAROUGE 1 300 KCAL</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>AMINCISSEMENT HAUTE PRÉCISION</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>SOINS DU VISAGE MÉDICO-ESTHÉTIQUES</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>HAMMAM TRADITIONNEL 100% FEMMES</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>BILAN INBODY OFFERT</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>ÉPILATION LASER DIODE</span><span class="mlt-star">✦</span></div>
      <div class="mlt-item"><span>AGDAL RABAT · PARKING KAÏS</span><span class="mlt-star">✦</span></div>
    </div>
  </div>

  <!-- ===================================================
       2. BANDEAU DE RÉASSURANCE
  =================================================== -->
  <section class="strip-reassurance">
    <div class="container-hrbana">
      <div class="reassurance-grid">
        <div class="r-pill-card reveal-on-scroll reveal-fade-up stagger-delay-1">
          <div class="r-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="r-txt">
            <strong>100 % Femmes</strong>
            <span>Espace intime & réservé</span>
          </div>
        </div>

        <div class="r-pill-card reveal-on-scroll reveal-fade-up stagger-delay-2">
          <div class="r-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="r-txt">
            <strong>Du lundi au samedi</strong>
            <span>08h00 à 20h00</span>
          </div>
        </div>

        <div class="r-pill-card reveal-on-scroll reveal-fade-up stagger-delay-3">
          <div class="r-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="r-txt">
            <strong>Agdal, Rabat</strong>
            <span>Parking Kaïs à 3 minutes</span>
          </div>
        </div>

        <div class="r-pill-card highlight-gold reveal-on-scroll reveal-fade-up stagger-delay-4">
          <div class="r-icon gold">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="r-txt">
            <strong>Sur rendez-vous</strong>
            <span>Accueil personnalisé sans attente</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================
       3. INFRASLIM : CENTRE SANTÉ ET BEAUTÉ 100% FEMMES
       (CONFORME EXACTEMENT AU MODÈLE DU CLIENT - WIREFRAME REÇU)
  =================================================== -->
  <section class="section-centre-model" id="le-centre">
    <div class="container-hrbana">
      <div class="centre-model-grid">
        
        <!-- Colonne Gauche : Composition Photos selon la maquette modèle -->
        <div class="cm-visual-col reveal-on-scroll reveal-fade-left">
          <div class="cm-photo-stack">
            <!-- Badge 100% FEMMES Rectangulaire Rouge en haut à gauche -->
            <div class="cm-badge-red glow-pulse-luxury">
              <span class="cm-b-num">100 %</span>
              <span class="cm-b-txt">FEMMES</span>
            </div>

            <!-- Grande photo principale : La salle de sport INFRASLIM -->
            <div class="cm-main-img-box">
              <img src="https://infraslim.ma/wp-content/uploads/2023/12/5-e1703586237165.jpg" alt="Salle de sport INFRASLIM 100% Femmes Rabat Agdal" class="cm-main-img" />
            </div>

            <!-- Petite photo superposée en bas à droite -->
            <div class="cm-inset-img-box">
              <img src="https://infraslim.ma/wp-content/uploads/2024/10/WhatsApp-Image-2024-09-12-at-12.02.48-1.jpeg" alt="Vélo InfraBike INFRASLIM Agdal" class="cm-inset-img" />
            </div>
          </div>
        </div>

        <!-- Colonne Droite : Typographie et texte exactement conformes au modèle -->
        <div class="cm-content-col reveal-on-scroll reveal-fade-right">
          <div class="cm-eyebrow">
            <span class="cm-dash">—</span> LE CENTRE
          </div>
          
          <h2 class="cm-title split-text-reveal">
            INFRASLIM, centre santé et beauté<br />
            100 % femmes à Agdal, Rabat
          </h2>

          <p class="cm-p-lead">
            Un espace entièrement féminin, du vestiaire à la salle de sport. Vous venez pour vous, pas pour être regardée.
          </p>

          <p class="cm-p-sub">
            Amincissement, remise en forme, soins du visage, épilation et hammam, réunis dans un même lieu à deux pas du parking Kaïs.
          </p>

          <div class="cm-action">
            <a href="/le-centre" class="btn-model-outline">
              DÉCOUVRIR LE CENTRE
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================
       4. QUEL EST VOTRE OBJECTIF ? (SLIDER INTERACTIF FLUIDE)
  =================================================== -->
  <section class="section-objectives-slider">
    <div class="container-hrbana">
      <div class="section-header-centered reveal-on-scroll reveal-fade-up">
        <span class="section-badge-gold">— PROTOCOLES SUR-MESURE —</span>
        <h2 class="section-h2-title split-text-reveal">Quel est <em>votre objectif ?</em></h2>
        <div class="h-divider-line center"></div>
        <p class="section-sub-desc">
          Dites-nous ce que vous souhaitez travailler. Nous construisons le programme autour de ça.
        </p>
      </div>

      <!-- Navigation Arrows du Slider Objectifs -->
      <div class="obj-slider-nav-wrap">
        <button class="obj-nav-btn prev" id="objPrev" aria-label="Objectif précédent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button class="obj-nav-btn next" id="objNext" aria-label="Objectif suivant">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <!-- Carousel Track -->
      <div class="objectives-track-slider" id="objectivesTrack">
        <!-- 1. Perdre du poids -->
        <div class="obj-slide-card card-fly-left delay-s1">
          <div class="ofc-top">
            <span class="ofc-index">01</span>
            <span class="ofc-tag">Cardio Infrarouge</span>
          </div>
          <h3 class="ofc-name">Perdre du poids</h3>
          <p class="ofc-desc">
            Un programme bâti sur votre diagnostic InBody, qui associe cardio infrarouge et suivi régulier.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/sport-nouvelle-generation/infrabike" class="sol-link">→ InfraBike</a>
              <a href="/services/sport-nouvelle-generation/tapis-roulant-infrarouge" class="sol-link">→ Tapis infrarouge</a>
            </div>
          </div>
          <a href="/services/sport-nouvelle-generation" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 2. Affiner ma silhouette -->
        <div class="obj-slide-card card-fly-left delay-s2">
          <div class="ofc-top">
            <span class="ofc-index">02</span>
            <span class="ofc-tag">Remodelage Ciblé</span>
          </div>
          <h3 class="ofc-name">Affiner ma silhouette</h3>
          <p class="ofc-desc">
            Ventre, hanches, cuisses. Cibler la graisse localisée et remodeler zone par zone.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/soins-amincissants/velashape" class="sol-link">→ VelaShape</a>
              <a href="/services/soins-amincissants/maderotherapie" class="sol-link">→ Madérothérapie</a>
            </div>
          </div>
          <a href="/services/soins-amincissants" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 3. Atténuer la cellulite -->
        <div class="obj-slide-card card-fly-up delay-s3">
          <div class="ofc-top">
            <span class="ofc-index">03</span>
            <span class="ofc-tag">Anti-Capitons</span>
          </div>
          <h3 class="ofc-name">Atténuer la cellulite</h3>
          <p class="ofc-desc">
            Peau d'orange et aspect capitonné. Massage mécanique et chaleur pour relancer les tissus.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/sport-nouvelle-generation/infra-roller" class="sol-link">→ Infra Roller</a>
              <a href="/services/soins-amincissants/velashape" class="sol-link">→ VelaShape</a>
            </div>
          </div>
          <a href="/services/soins-amincissants" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 4. Soulager mes jambes -->
        <div class="obj-slide-card card-fly-right delay-s4">
          <div class="ofc-top">
            <span class="ofc-index">04</span>
            <span class="ofc-tag">Circulation & Détox</span>
          </div>
          <h3 class="ofc-name">Soulager mes jambes</h3>
          <p class="ofc-desc">
            Jambes lourdes, rétention d'eau, mauvaise circulation, surtout en fin de journée.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/soins-amincissants/pressotherapie" class="sol-link">→ Pressothérapie</a>
              <a href="/services/soins-amincissants/drainage-lymphatique" class="sol-link">→ Drainage lymphatique</a>
            </div>
          </div>
          <a href="/services/soins-amincissants" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 5. Raffermir ma peau -->
        <div class="obj-slide-card card-fly-right delay-s5">
          <div class="ofc-top">
            <span class="ofc-index">05</span>
            <span class="ofc-tag">Tonus & Galbe</span>
          </div>
          <h3 class="ofc-name">Raffermir ma peau</h3>
          <p class="ofc-desc">
            Après une perte de poids ou une grossesse, redonner de la tenue et du tonus aux tissus.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/soins-amincissants/maderotherapie" class="sol-link">→ Madérothérapie</a>
              <a href="/services/sport-nouvelle-generation" class="sol-link">→ Renforcement</a>
            </div>
          </div>
          <a href="/services/soins-amincissants" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 6. Prendre soin de mon visage -->
        <div class="obj-slide-card card-fly-right delay-s6">
          <div class="ofc-top">
            <span class="ofc-index">06</span>
            <span class="ofc-tag">Éclat & Pureté</span>
          </div>
          <h3 class="ofc-name">Prendre soin de mon visage</h3>
          <p class="ofc-desc">
            Éclat, taches, acné, premiers signes de l'âge. Des soins adaptés à votre type de peau.
          </p>
          <div class="ofc-solution-box">
            <span class="ofc-sol-label">Solution proposée :</span>
            <div class="ofc-pills">
              <a href="/services/soins-visage/hydrafacial" class="sol-link">→ Hydrafacial</a>
              <a href="/services/soins-visage/microneedling" class="sol-link">→ Microneedling</a>
            </div>
          </div>
          <a href="/services/soins-visage" class="ofc-action-btn">
            <span>Découvrir le programme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Dots indicateurs -->
      <div class="obj-dots-container" id="objDots">
