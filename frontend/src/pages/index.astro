<style>
  /* =====================================================
     HERO TEXTE — 3 SLIDES AUTO-ROTATION (DU SITE HTML)
  ===================================================== */
  .hero-text {
    position: relative;
    background:
      linear-gradient(135deg, rgba(145, 100, 142, 0.76) 0%, rgba(74, 40, 75, 0.72) 100%),
      url('https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat;
    min-height: 600px;
    height: 82vh;
    max-height: 780px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0 2rem;
  }
  .hero-text::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(51, 21, 53, 0.25) 0%, rgba(51, 21, 53, 0.55) 100%);
    pointer-events: none;
  }
  .ht-slides {
    position: relative;
    max-width: 820px;
    width: 100%;
    text-align: center;
    z-index: 2;
  }
  .ht-slide {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    animation: htFadeIn 0.7s ease both;
  }
  .ht-slide.active { display: flex; }

  @keyframes htFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ht-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .ht-title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
    letter-spacing: 0.01em;
  }
  .ht-title em {
    font-style: italic;
    font-weight: 700;
    color: #FFFFFF;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
  }
  .ht-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 520px;
    line-height: 1.75;
    font-weight: 300;
  }
  .ht-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .ht-btn-red {
    display: inline-flex;
    align-items: center;
    background: #BB2026;
    color: #FFFFFF;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.25s, transform 0.2s;
    box-shadow: 0 6px 20px rgba(187, 32, 38, 0.35);
  }
  .ht-btn-red:hover { background: #8f1a1f; transform: translateY(-2px); }
  .ht-btn-white {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
