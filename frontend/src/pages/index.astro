  }
  .service-card-bg.visage {
    background-image:
      linear-gradient(180deg, rgba(187, 32, 38, 0.3) 0%, rgba(145, 100, 142, 0.7) 100%),
      url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80');
  }
  .service-card-bg.laser {
    background-image:
      linear-gradient(180deg, rgba(0, 113, 188, 0.35) 0%, rgba(51, 21, 53, 0.7) 100%),
      url('https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=600&q=80');
  }
  .service-card-bg.hammam {
    background-image:
      linear-gradient(180deg, rgba(175, 132, 172, 0.4) 0%, rgba(51, 21, 53, 0.75) 100%),
      url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80');
  }
  .service-card-icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .service-card-icon svg {
    width: 20px;
    height: 20px;
    stroke: var(--red);
    fill: none;
    stroke-width: 1.8;
  }
  .service-card-content {
    padding: 2rem;
  }
  .service-card-num {
    font-size: 0.75rem;
    color: var(--mauve);
    font-weight: 600;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .service-card-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: #2D2D2D;
  }
  .service-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .service-tag {
    font-size: 0.75rem;
    background: var(--white);
    color: #4A354C;
    padding: 0.3rem 0.75rem;
    border-radius: 50px;
    border: 1px solid var(--border);
  }
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .carousel-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--red);
    font-size: 1.2rem;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .carousel-btn:hover {
    background: var(--red);
    color: white;
    border-color: var(--red);
  }
  .carousel-dots {
    display: flex;
    gap: 0.5rem;
  }
  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(187, 32, 38, 0.2);
    border: none;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }
  .carousel-dot.active {
    background: var(--red);
    transform: scale(1.3);
  }

  /* =====================================================
     FEATURED SERVICE SECTIONS (DU SITE HTML)
  ===================================================== */
  .featured-service {
    background: var(--white);
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .featured-grid.reverse {
    direction: rtl;
  }
  .featured-grid.reverse > * {
    direction: ltr;
  }
  .featured-visual {
