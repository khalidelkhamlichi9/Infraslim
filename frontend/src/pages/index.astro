  /* Dial thermographique */
  .dial-container {
    position: relative;
    width: 320px; height: 320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dial-glow-halo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 174, 201, 0.45) 0%, transparent 70%);
    animation: dialPulse 3s infinite;
  }
  .dial-ring-pulse {
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    border: 2px dashed rgba(255, 174, 201, 0.3);
    animation: dialSpin 25s linear infinite;
  }
  @keyframes dialSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes dialPulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    50% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.6; }
  }
  .dial-inner-circle {
    position: relative;
    z-index: 2;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    border: 3px solid rgba(255, 255, 255, 0.35);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .dial-sub { font-size: 0.72rem; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.85); }
  .dial-number { font-family: 'Josefin Sans', sans-serif; font-size: 3.8rem; font-weight: 700; color: #FFFFFF; line-height: 1; margin: 0.2rem 0; }
  .dial-unit { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; color: #FFAEC9; }
  .dial-time { font-size: 0.72rem; color: rgba(255, 255, 255, 0.85); margin-top: 0.4rem; letter-spacing: 0.08em; }

