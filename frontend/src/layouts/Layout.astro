---
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
}

const {
  title = "INFRASLIM – Centre Féminin Beauté & Bien-être | Agdal, Rabat",
  description = "Centre féminin haut de gamme à Agdal, Rabat. Sport infrarouge, soins amincissants, soins du visage, épilation laser, hammam. Technologies de pointe. Résultats visibles.",
  currentPath = "",
  noindex = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#BB2026" />
  <link rel="canonical" href={`https://infraslim.ma${currentPath}`} />

  <!-- Fonts — Poppins + Josefin Sans via Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Josefin+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />

  <!-- GSAP & ScrollTrigger officiels du site HTML -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Feuilles de style Premium officielles -->
  <link rel="stylesheet" href="/premium.css" />
  <link rel="stylesheet" href="/premium-extra.css" />
</head>
<body>
  <!-- Scroll Progress Bar -->
  <div id="progress-bar"></div>

  <!-- Top Bar Rouge -->
  <TopBar />

  <!-- Header & Navigation -->
  <Header currentPath={currentPath} />

  <!-- Contenu Principal -->
  <main>
    <slot />
  </main>

  <!-- Footer officiel -->
  <Footer />

  <!-- Floating WhatsApp officiel -->
  <div class="float-wa">
    <div class="float-wa-bubble">Prendre RDV par WhatsApp</div>
    <a href="https://wa.me/212615109898?text=Bonjour%20INFRASLIM%2C%20je%20souhaite%20prendre%20rendez-vous." target="_blank" rel="noopener" class="float-wa-btn" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>

  <!-- Scripts d'animation GSAP & Moteur Premium -->
  <script is:inline src="/premium.js"></script>

  <!-- Moteur Global d'Animations Avancées (Toutes les pages) -->
  <script>
    (function() {
      function setupGlobalAnimations() {
        const isHome = window.location.pathname === '/' || window.location.pathname === '/index.html';

        if (!isHome) {
          // 1. Titres cinématiques mot par mot sur toutes les pages internes
          const titleSelectors = [
            'h1.hero-title', '.service-detail-hero h1', 'main section h1',
            '.section-title', '.ps-title', '.wlc-title', '.cta-title',
            '.wa-title', '.inbody-title', '.ht-title', 'main section h2'
          ].join(', ');

          document.querySelectorAll(titleSelectors).forEach(el => {
            if (!el.classList.contains('split-text-reveal') && !el.closest('.hero-hrbana')) {
              el.classList.add('split-text-reveal');
            }
          });

          // 2. Hero meta & descriptions
          document.querySelectorAll('.breadcrumb, .hero-eyebrow, .hero-desc, .hero-subtitle, .hero-actions').forEach((el, idx) => {
            if (!el.classList.contains('reveal-on-scroll')) {
              el.classList.add('reveal-on-scroll', 'reveal-fade-up', `stagger-delay-${Math.min((idx % 4) + 1, 4)}`);
            }
          });

          // 3. Blocs 2 colonnes (image + texte qui arrivent des deux côtés)
          document.querySelectorAll('.split-layout, .two-col-why, .welcome-lounge-card, .inbody-callout-card').forEach(wrap => {
            const kids = Array.from(wrap.children);
            if (kids.length >= 2) {
              if (!kids[0].classList.contains('card-fly-left') && !kids[0].classList.contains('card-fly-right')) {
                kids[0].classList.add('card-fly-left', 'delay-s1');
              }
              if (!kids[1].classList.contains('card-fly-left') && !kids[1].classList.contains('card-fly-right')) {
                kids[1].classList.add('card-fly-right', 'delay-s2');
              }
            }
          });

          // 4. Grilles de cartes (alternance gauche / haut / droite avec cascade)
          const gridSelectors = [
            '.univers-grid', '.blog-grid', '.pricing-plans', '.ritual-grid',
            '.contact-cards', '.trust-grid', '.practical-grid', '.hammam-gallery-mosaic',
            '.tech-pillars', '.stats-card-white', '.about-stats', '.benefits-grid',
            '.services-grid', '.why-highlights', '.faq-list'
          ].join(', ');

          document.querySelectorAll(gridSelectors).forEach(grid => {
            Array.from(grid.children).forEach((child, i) => {
              if (
                child.classList.contains('card-fly-left') ||
                child.classList.contains('card-fly-right') ||
                child.classList.contains('card-fly-up')
              ) return;
              const mod = i % 3;
              const flyClass = mod === 0 ? 'card-fly-left' : mod === 1 ? 'card-fly-up' : 'card-fly-right';
              const delayClass = `delay-s${(i % 6) + 1}`;
              child.classList.add(flyClass, delayClass);
            });
          });

          // 5. Blocs individuels (tarifs, FAQ, callouts, formulaires)
          document.querySelectorAll('.pricing-section-block, .faq-group, .service-universe-card, .pack-callout, .in-form-card, .disclaimer, .sec-head-center').forEach((el, i) => {
            if (
              !el.classList.contains('card-fly-left') &&
              !el.classList.contains('card-fly-right') &&
              !el.classList.contains('card-fly-up') &&
              !el.classList.contains('reveal-on-scroll')
            ) {
              const flyClass = i % 2 === 0 ? 'card-fly-up' : 'card-fly-left';
              el.classList.add(flyClass, 'delay-s1');
            }
          });

          // 6. Sidebar détail service
          const sidebar = document.querySelector('.detail-sidebar');
          if (sidebar && !sidebar.classList.contains('card-fly-right')) {
            sidebar.classList.add('card-fly-right', 'delay-s2');
          }
        }

        // 7. Découpage mot-à-mot des titres (.split-text-reveal) avec protection anti-doublon
        document.querySelectorAll('.split-text-reveal').forEach(title => {
          const el = title as HTMLElement;
          if (el.dataset.splitDone === '1') return;
          el.dataset.splitDone = '1';
          const text = el.innerHTML;
          const parts = text.split(/(<[^>]+>|\s+)/);
          el.innerHTML = parts.map((part) => {
            if (part.startsWith('<') || part.trim() === '') return part;
            return `<span class="split-char-anim"><span class="char">${part}</span></span>`;
          }).join('');
        });

        // 8. IntersectionObserver global pour révéler les éléments au scroll
        const revealElements = document.querySelectorAll(
          '.reveal-on-scroll, .card-fly-left, .card-fly-right, .card-fly-up, .split-text-reveal'
        );
        if (!revealElements.length) return;

        function revealItem(target: Element) {
          target.classList.add('is-revealed');
          if (target.classList.contains('split-text-reveal')) {
            target.querySelectorAll('.char').forEach((c, i) => {
              setTimeout(() => {
                c.parentElement?.classList.add('is-revealed');
              }, i * 65);
            });
          }
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              revealItem(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -30px 0px'
        });

        revealElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.94 && rect.bottom > 0) {
            revealItem(el);
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupGlobalAnimations);
      } else {
        setupGlobalAnimations();
      }
    })();
  </script>

  <style is:global>
    /* ===================================================
       SYSTÈME GLOBAL D'ANIMATIONS AVANCÉES (TOUTES PAGES)
    =================================================== */
    .split-char-anim {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
    }
    .split-char-anim .char {
      display: inline-block;
      opacity: 0;
      transform: translateY(115%) rotate(4deg);
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s ease;
      will-change: transform, opacity;
    }
    .split-char-anim.is-revealed .char {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }

    .card-fly-left {
      opacity: 0 !important;
      transform: translateX(-110px) rotate(-2.5deg) !important;
      filter: blur(7px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), filter 0.85s ease !important;
    }
    .card-fly-right {
      opacity: 0 !important;
      transform: translateX(110px) rotate(2.5deg) !important;
      filter: blur(7px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), filter 0.85s ease !important;
    }
    .card-fly-up {
      opacity: 0 !important;
      transform: translateY(80px) scale(0.93) !important;
      filter: blur(5px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), filter 0.85s ease !important;
    }
    .card-fly-left.is-revealed,
    .card-fly-right.is-revealed,
    .card-fly-up.is-revealed {
      opacity: 1 !important;
      transform: translate(0, 0) rotate(0deg) scale(1) !important;
      filter: blur(0px) !important;
    }

    .reveal-on-scroll {
      opacity: 0;
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-fade-up { transform: translateY(40px); }
    .reveal-fade-left { transform: translateX(-60px); }
    .reveal-fade-right { transform: translateX(60px); }
    .reveal-scale-up { transform: scale(0.92); }
    .reveal-on-scroll.is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    .delay-s1 { transition-delay: 0.1s !important; }
    .delay-s2 { transition-delay: 0.22s !important; }
    .delay-s3 { transition-delay: 0.34s !important; }
    .delay-s4 { transition-delay: 0.46s !important; }
    .delay-s5 { transition-delay: 0.58s !important; }
    .delay-s6 { transition-delay: 0.7s !important; }
    .stagger-delay-1 { transition-delay: 0.08s !important; }
    .stagger-delay-2 { transition-delay: 0.18s !important; }
    .stagger-delay-3 { transition-delay: 0.28s !important; }
    .stagger-delay-4 { transition-delay: 0.38s !important; }

    #progress-bar {
      position: fixed;
      top: 0; left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #BB2026, #AF84AC, #0071BC);
      z-index: 9999;
      transition: width 0.1s linear;
    }
    .float-wa {
      position: fixed;
      bottom: 2rem; right: 2rem;
      z-index: 999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
    }
    .float-wa-bubble {
      background: white;
      color: #1A1A1A;
      font-size: 0.8rem;
      padding: 0.5rem 1rem;
      border-radius: 12px 12px 0 12px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.12);
      white-space: nowrap;
    }
    .float-wa-btn {
      width: 56px; height: 56px;
      border-radius: 50%;
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(37,211,102,0.4);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .float-wa-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 28px rgba(37,211,102,0.5);
    }
    .float-wa-btn svg { width: 28px; height: 28px; fill: white; }
    @media (max-width: 600px) {
      .float-wa { bottom: 1.1rem; right: 1.1rem; }
      .float-wa-bubble { display: none; }
      .float-wa-btn { width: 48px; height: 48px; }
      .float-wa-btn svg { width: 24px; height: 24px; }
    }
  </style>
</body>
</html>
