    },
    "subtitle": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "badge": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "subservices": {
      "type": "json"
    },
    "benefits": {
      "type": "json"
    },
    "pricingOverview": {
      "type": "json"
    }
  }
}
